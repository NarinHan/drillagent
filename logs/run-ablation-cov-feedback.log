#!/bin/bash -e
# Coverage instrumentation flags
COV_CFLAGS="-g -O0 -fprofile-instr-generate -fcoverage-mapping"
COV_LDFLAGS="-fprofile-instr-generate -fcoverage-mapping"
CFLAGS="${CFLAGS:-}"
CXXFLAGS="${CXXFLAGS:-}"
LDFLAGS="${LDFLAGS:-}"

#!/bin/bash

# Build script for openjpeg

# Create build directory if it doesn't exist
mkdir -p build
cd build

# Run CMake to configure the project
CC=clang CXX=clang++ cmake -DCMAKE_C_FLAGS="$COV_CFLAGS $CFLAGS" -DCMAKE_CXX_FLAGS="$COV_CFLAGS $CXXFLAGS" -DCMAKE_EXE_LINKER_FLAGS="$COV_LDFLAGS $LDFLAGS" ..

# Clean previous builds
make clean -s -j$(nproc)

# Build the project using all available processors
make -j$(nproc) -s

