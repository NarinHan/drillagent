#!/bin/bash -e
# Coverage instrumentation flags
COV_CFLAGS="-g -O0 -fprofile-instr-generate -fcoverage-mapping"
COV_LDFLAGS="-fprofile-instr-generate -fcoverage-mapping"
CFLAGS="${CFLAGS:-}"
CXXFLAGS="${CXXFLAGS:-}"
LDFLAGS="${LDFLAGS:-}"

#!/bin/bash -eu
# Minimized build script with only core build commands
set -e
# Check if autogen.sh exists and is executable
if [ -f ./autogen.sh ]; then
 chmod +x ./autogen.sh
 ./autogen.sh
fi

# Set compiler flags
export CFLAGS="$COV_CFLAGS $CFLAGS -fno-use-cxa-atexit"
export CXXFLAGS="$COV_CFLAGS $CXXFLAGS -fno-use-cxa-atexit"

# Clean and build
# Ensure Makefile is generated
export CFLAGS="${CFLAGS//-fno-use-cxa-atexit/}"

CC=clang CXX=clang++ CFLAGS="$COV_CFLAGS $CFLAGS" CXXFLAGS="$COV_CFLAGS $CXXFLAGS" LDFLAGS="$COV_LDFLAGS $LDFLAGS" ./configure

# Clean and build
make clean -j$(nproc)
export CFLAGS="${CFLAGS//-fno-use-cxa-atexit/}"

CC=clang CXX=clang++ CFLAGS="$COV_CFLAGS $CFLAGS" CXXFLAGS="$COV_CFLAGS $CXXFLAGS" LDFLAGS="$COV_LDFLAGS $LDFLAGS" ./configure
make -j$(nproc)

# Remove fuzzer-related and unnecessary commands
# mkdir -p $SEED_CORPUS_PATH

