(1) + nal_unit_type(6) + nuh_layer_id(6) + nuh_temporal_id_plus1(3)\n    # nal_unit_type = 32 (VPS = GF_HEVC_NALU_VID_PARAM)\n    bs.write_u(0, 1)      # forbidden_zero_bit\n    bs.write_u(32, 6)     # nal_unit_type = VPS (32)\n    bs.write_u(0, 6)      # nuh_layer_id\n    bs.write_u(1, 3)      # nuh_temporal_id_plus1\n    \n    # VPS RBSP\n    bs.write_u(0, 4)      # vps_video_parameter_set_id\n    bs.write_u(1, 1)      # vps_base_layer_internal_flag = 1 (CRITICAL for extension parsing)\n    bs.write_u(1, 1)      # vps_base_layer_available_flag = 1\n    bs.write_u(1, 6)      # vps_max_layers_minus1 = 1 (2 layers, CRITICAL: max_layers > 1)\n    bs.write_u(0, 3)      # vps_max_sub_layers_minus1 = 0 (1 sub-layer)\n    bs.write_u(1, 1)      # vps_temporal_id_nesting_flag = 1\n    bs.write_u(0xffff, 16) # vps_reserved_0xffff_16bits\n    \n    # profile_tier_level (for max_sub_layers=1)\n    bs.write_u(0, 2)      # general_profile_space\n    bs.write_u(0, 1)      # general_tier_flag\n    bs.write_u(1, 5)      # general_profile_idc = 1 (Main)\n    bs.write_u(0, 32)     # general_profile_compatibility_flag[32]\n    bs.write_u(1, 1)      # general_progressive_source_flag\n    bs.write_u(0, 1)      # general_interlaced_source_flag\n    bs.write_u(0, 1)      # general_non_packed_constraint_flag\n    bs.write_u(0, 1)      # general_frame_only_constraint_flag\n    bs.write_u(0, 44)     # general_reserved_zero_44bits\n    bs.write_u(0, 8)      # general_level_idc\n    \n    # vps_sub_layer_ordering_info_present_flag = 0\n    bs.write_u(0, 1)\n    # For i=0 (since vps_max_sub_layers_minus1=0)\n    bs.write_ue(0)        # vps_max_dec_pic_buffering_minus1[0]\n    bs.write_ue(0)        # vps_max_num_reorder_pics[0]\n    bs.write_ue(0)        # vps_max_latency_increase_plus1[0]\n    \n    bs.write_u(0, 6)      # vps_max_layer_id = 0\n    bs.write_ue(0)        # vps_num_layer_sets_minus1 = 0\n    \n    bs.write_u(0, 1)      # vps_timing_info_present_flag = 0\n    bs.write_u(1, 1)     