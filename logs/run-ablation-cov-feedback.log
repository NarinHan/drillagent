com_tag(f, 0x0002, 0x0012, \'UI\', impl_class)\n    \n    # Rows (0028,0010)\n    write_dicom_tag(f, 0x0028, 0x0010, \'US\', struct.pack(\'<H\', 64))\n    \n    # Columns (0028,0011)\n    write_dicom_tag(f, 0x0028, 0x0011, \'US\', struct.pack(\'<H\', 64))\n    \n    # Bits Allocated (0028,0100)\n    write_dicom_tag(f, 0x0028, 0x0100, \'US\', struct.pack(\'<H\', 8))\n    \n    # Bits Stored (0028,0101)\n    write_dicom_tag(f, 0x0028, 0x0101, \'US\', struct.pack(\'<H\', 8))\n    \n    # Samples per Pixel (0028,0002)\n    write_dicom_tag(f, 0x0028, 0x0002, \'US\', struct.pack(\'<H\', 3))\n    \n    # Photometric Interpretation (0028,0004)\n    write_dicom_tag(f, 0x0028, 0x0004, \'CS\', b\'RGB\\x00\')\n    \n    # Number of Frames (0028,0008)\n    write_dicom_tag(f, 0x0028, 0x0008, \'IS\', b\'2\\x00\')\n    \n    # Pixel Data (7FE0,0010) with encapsulated JPEG\n    f.write(struct.pack(\'<HH\', 0x7FE0, 0x0010))\n    f.write(b\'OB\')\n    f.write(struct.pack(\'<H\', 0))  # Reserved\n    f.write(struct.pack(\'<I\', 0xFFFFFFFF))  # Undefined length\n    \n    # Item with offset table (FFFE,E000) - CRITICAL: non-zero to allocate stream_info->offsets\n    f.write(struct.pack(\'<HH\', 0xFFFE, 0xE000))\n    offset_table_length = 8  # 2 frames * 4 bytes\n    f.write(struct.pack(\'<I\', offset_table_length))\n    \n    # Offset table entries\n    f.write(struct.pack(\'<I\', 0))      # First frame at offset 0\n    f.write(struct.pack(\'<I\', 200))    # Second frame at offset 200\n    \n    # First JPEG fragment (FFFE,E000)\n    f.write(struct.pack(\'<HH\', 0xFFFE, 0xE000))\n    \n    # Create a minimal but more complete JPEG\n    jpeg_data = b\'\'\n    jpeg_data += b\'\\xFF\\xD8\'  # SOI\n    jpeg_data += b\'\\xFF\\xE0\' + struct.pack(\'>H\', 16) + b\'JFIF\\x00\\x01\\x01\\x00\\x00\\x01\\x00\\x01\\x00\\x00\'  # APP0\n    jpeg_data += b\'\\xFF\\xC0\' + struct.pack(\'>H\', 17) + b\'\\x08\' + struct.pack(\'>HH\', 64, 64) + b\'\\x03\\x01\\x22\\x00\\x02\\x11\\x01\\x03\\x11\\x01\'  # SOF