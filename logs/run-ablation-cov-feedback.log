#!/bin/bash -eu
# Improved build script

# Navigate to the source directory


# Set linker and flags
export LD=${CC:-gcc}
export LDFLAGS="${CFLAGS:-}"

# Run rake with multiple processors
export CC=clang

export CXX=clang++

export CFLAGS="$COV_CFLAGS $CFLAGS"

export CXXFLAGS="$COV_CFLAGS $CXXFLAGS"

export LDFLAGS="$COV_LDFLAGS $LDFLAGS"

rake -m -j$(nproc)

