#!/bin/bash

# Ensure the script is executed from its directory


# Set default CFLAGS if not set
CFLAGS="${CFLAGS:--w -Wno-yacc -Wno-incompatible-pointer-types -fsanitize-address-use-after-scope}"

# Check if configure script exists
if [ -f ./configure ]; then
 chmod +x ./configure
 CC=clang CXX=clang++ ./configure --static-build --extra-cflags="$COV_CFLAGS $CFLAGS" --extra-ldflags="$COV_LDFLAGS $CFLAGS"
else
 echo "Error: configure script not found."
 exit 1
fi

# Build the project
make -j$(nproc)

