  #3: PackLinuxElf64::elf_find_ptype(unsigned int, N_Elf64::Phdr<N_Elf::ElfITypes<LE16, LE32, LE64, LE64, LE64> > const*, unsigned int) @ src/p_lx_elf.cpp:1410
  #4: PackLinuxElf64::unpack(OutputFile*) @ src/p_lx_elf.cpp:3834
  #5: Packer::doUnpack(OutputFile*) @ src/packer.cpp:107
