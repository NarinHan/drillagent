_data += b\'\\x00\' * 24  # pre_defined\n    mvhd_data += struct.pack(\'>I\', 2)  # next_track_ID\n    \n    moov_content += write_fullbox(\'mvhd\', 0, 0, mvhd_data)\n    \n    # Build trak box\n    trak_content = b\'\'\n    \n    # tkhd - track header\n    tkhd_flags = 0x7  # track_enabled | track_in_movie | track_in_preview\n    tkhd_data = struct.pack(\'>IIIIIQHH\',\n        0,          # creation_time\n        0,          # modification_time\n        1,          # track_ID\n        0,          # reserved\n        1000,       # duration\n        0,          # reserved\n        0           # layer, alternate_group\n    )\n    tkhd_data += struct.pack(\'>HH\', 0, 0)  # volume, reserved\n    # matrix (identity)\n    tkhd_data += struct.pack(\'>9I\',\n        0x00010000, 0, 0,\n        0, 0x00010000, 0,\n        0, 0, 0x40000000\n    )\n    tkhd_data += struct.pack(\'>II\', 320 << 16, 240 << 16)  # width, height\n    \n    trak_content += write_fullbox(\'tkhd\', 0, tkhd_flags, tkhd_data)\n    \n    # Build mdia box\n    mdia_content = b\'\'\n    \n    # mdhd - media header\n    mdhd_data = struct.pack(\'>IIIIHH\',\n        0,          # creation_time\n        0,          # modification_time\n        1000,       # timescale\n        1000,       # duration\n        0x55c4,     # language (und)\n        0           # pre_defined\n    )\n    mdia_content += write_fullbox(\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr - handler\n    hdlr_data = struct.pack(\'>I4sIII\',\n        0,          # pre_defined\n        b\'vide\',    # handler_type (video)\n        0, 0, 0     # reserved\n    )\n    hdlr_data += b\'VideoHandler\\x00\'\n    mdia_content += write_fullbox(\'hdlr\', 0, 0, hdlr_data)\n    \n    # Build minf box\n    minf_content = b\'\'\n    \n    # vmhd - video media header\n    vmhd_data = struct.pack(\'>HHH\', 0, 0, 0)  # graphicsmode, opcolor\n    minf_content += write_fullbox(\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf box\n    dinf_content = b\'\'\n    dref_data 