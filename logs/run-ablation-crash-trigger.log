data += struct.pack(\'>hh\', 0, 0)  # layer, alternate_group\ntkhd_data += struct.pack(\'>hh\', 0, 0)  # volume, reserved\ntkhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)  # matrix\ntkhd_data += struct.pack(\'>II\', 320 << 16, 240 << 16)  # width, height\ntkhd = write_fullbox(b\'tkhd\', 0, 3, tkhd_data)  # flags=3 (enabled+in_movie)\n\n# Media header\nmdhd_data = struct.pack(\'>I\', 0)  # creation_time\nmdhd_data += struct.pack(\'>I\', 0)  # modification_time\nmdhd_data += struct.pack(\'>I\', 1000)  # timescale\nmdhd_data += struct.pack(\'>I\', 1000)  # duration\nmdhd_data += struct.pack(\'>H\', 0x55c4)  # language (und)\nmdhd_data += struct.pack(\'>H\', 0)  # pre_defined\nmdhd = write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n\n# Handler reference\nhdlr_data = struct.pack(\'>I\', 0)  # pre_defined\nhdlr_data += b\'vide\'  # handler_type\nhdlr_data += struct.pack(\'>III\', 0, 0, 0)  # reserved\nhdlr_data += b\'VideoHandler\\x00\'  # name\nhdlr = write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n\n# Video media header\nvmhd_data = struct.pack(\'>H\', 0)  # graphicsmode\nvmhd_data += struct.pack(\'>HHH\', 0, 0, 0)  # opcolor\nvmhd = write_fullbox(b\'vmhd\', 0, 1, vmhd_data)\n\n# Data reference\ndref_data = struct.pack(\'>I\', 1)  # entry_count\nurl_box = write_fullbox(b\'url \', 0, 1, b\'\')  # self-reference\ndref = write_fullbox(b\'dref\', 0, 0, dref_data + url_box)\ndinf = write_box(b\'dinf\', dref)\n\n# Sample description\navc1_data = struct.pack(\'>6B\', 0, 0, 0, 0, 0, 0)  # reserved\navc1_data += struct.pack(\'>H\', 1)  # data_reference_index\navc1_data += struct.pack(\'>HH\', 0, 0)  # pre_defined, reserved\navc1_data += struct.pack(\'>III\', 0, 0, 0)  # pre_defined\navc1_data += struct.pack(\'>HH\', 320, 240)  # width, height\navc1_data += struct.pack(\'>I\', 0x00480000)  # horizresolution\navc1_data += struct.pack(\'>I\', 0x00480000)  # vertresolution\navc1_data += struct.pack(\'>I\', 0)  # reserved\navc1_data += struct.pack(\'>H\',