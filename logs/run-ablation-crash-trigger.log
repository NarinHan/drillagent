ed\n        0,  # layer\n        0,  # alternate_group\n        0,  # volume (0 for non-audio)\n        0  # reserved\n    )\n    tkhd_data += struct.pack(\'>IIIIIIIII\',\n        0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000  # matrix\n    )\n    tkhd_data += struct.pack(\'>II\', 0, 0)  # width, height\n    trak_data += write_fullbox(b\'tkhd\', 0, 0x000007, tkhd_data)  # flags: track_enabled | track_in_movie | track_in_preview\n    \n    # mdia box - media\n    mdia_data = b\'\'\n    \n    # mdhd box - media header\n    mdhd_data = struct.pack(\'>IIIIHH\',\n        0,  # creation_time\n        0,  # modification_time\n        1000,  # timescale\n        3000,  # duration\n        0x55c4,  # language (und)\n        0  # pre_defined\n    )\n    mdia_data += write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr box - handler (OD stream handler type \'odsm\')\n    hdlr_data = struct.pack(\'>I4sIII\',\n        0,  # pre_defined\n        b\'odsm\',  # handler_type - THIS IS KEY: Object Descriptor stream\n        0, 0, 0  # reserved\n    )\n    hdlr_data += b\'GPAC ISO OD Handler\\x00\'\n    mdia_data += write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box - media information\n    minf_data = b\'\'\n    \n    # nmhd box - null media header (for OD streams)\n    nmhd_data = b\'\'\n    minf_data += write_fullbox(b\'nmhd\', 0, 0, nmhd_data)\n    \n    # dinf box - data information\n    dinf_data = b\'\'\n    \n    # dref box - data reference\n    dref_data = struct.pack(\'>I\', 1)  # entry_count\n    # url box\n    url_data = b\'\'\n    dref_data += write_fullbox(b\'url \', 0, 0x000001, url_data)  # flag 0x000001: self-contained\n    dinf_data += write_fullbox(b\'dref\', 0, 0, dref_data)\n    \n    minf_data += write_box(b\'dinf\', dinf_data)\n    \n    # stbl box - sample table\n    stbl_data = b\'\'\n    \n    # stsd box - sample description\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count\n    \n    # mp4s sample entry for OD stream\n    mp4s