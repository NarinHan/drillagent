ata += struct.pack(\'>I\', 1)  # default_sample_description_index\ntrex_data += struct.pack(\'>I\', 0)  # default_sample_duration\ntrex_data += struct.pack(\'>I\', 0)  # default_sample_size\ntrex_data += struct.pack(\'>I\', 0)  # default_sample_flags\ntrex = write_fullbox(b\'trex\', 0, 0, trex_data)\n\nmvex = write_box(b\'mvex\', trex)\n\ntrak = write_box(b\'trak\', tkhd + mdia)\nmoov = write_box(b\'moov\', mvhd + trak + mvex)\n\n# Movie fragment (moof)\nmfhd_data = struct.pack(\'>I\', 1)  # sequence_number\nmfhd = write_fullbox(b\'mfhd\', 0, 0, mfhd_data)\n\n# Track fragment header\ntfhd_data = struct.pack(\'>I\', 1)  # track_ID\ntfhd = write_fullbox(b\'tfhd\', 0, 0x020000, tfhd_data)  # flags: default-base-is-moof\n\n# Track fragment decode time\ntfdt_data = struct.pack(\'>Q\', 0)  # baseMediaDecodeTime\ntfdt = write_fullbox(b\'tfdt\', 1, 0, tfdt_data)\n\n# Track run\ntrun_data = struct.pack(\'>I\', 1)  # sample_count\ntrun_data += struct.pack(\'>i\', 100)  # data_offset\ntrun_data += struct.pack(\'>I\', 100)  # sample_duration\ntrun_data += struct.pack(\'>I\', 100)  # sample_size\ntrun = write_fullbox(b\'trun\', 0, 0x000301, trun_data)  # flags: sample_duration + sample_size + data_offset\n\n# Critical: sgpd in fragment with same grouping_type to trigger merge\nsgpd_frag_data = struct.pack(\'>I\', 0x726F6C6C)  # grouping_type = \'roll\'\nsgpd_frag_data += struct.pack(\'>I\', 0)  # default_length (v1)\nsgpd_frag_data += struct.pack(\'>I\', 1)  # entry_count\nsgpd_frag_data += struct.pack(\'>I\', 2)  # entry size\nsgpd_frag_data += struct.pack(\'>h\', -2)  # different roll_distance to trigger comparison\nsgpd_frag = write_fullbox(b\'sgpd\', 1, 0, sgpd_frag_data)\n\n# Sample group in fragment\nsbgp_frag_data = struct.pack(\'>I\', 0x726F6C6C)  # grouping_type = \'roll\'\nsbgp_frag_data += struct.pack(\'>I\', 1)  # entry_count\nsbgp_frag_data += struct.pack(\'>II\', 1, 1)  # sample_count, group_description_index\nsbgp_frag = write_fullbox(b\'sbgp\', 0, 0, sbgp_frag_da