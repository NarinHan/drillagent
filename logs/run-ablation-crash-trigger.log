served\n        3000,           # duration\n        0, 0            # reserved\n    )\n    tkhd_data += struct.pack(\'>HHH\', 0, 0, 0)  # layer, alternate_group, volume\n    tkhd_data += struct.pack(\'>H\', 0)  # reserved\n    # matrix (identity)\n    tkhd_data += struct.pack(\'>IIIIIIIII\',\n        0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000\n    )\n    tkhd_data += struct.pack(\'>II\', 0, 0)  # width, height\n    trak_data += write_fullbox(b\'tkhd\', 0, 0x000007, tkhd_data)\n    \n    # mdia box\n    mdia_data = b\'\'\n    \n    # mdhd box\n    mdhd_data = struct.pack(\'>IIIIHH\',\n        0, 0,           # creation_time, modification_time\n        1000,           # timescale\n        3000,           # duration\n        0x55c4,         # language (und)\n        0               # pre_defined\n    )\n    mdia_data += write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr box - CRITICAL: handler type \'odsm\' for Object Descriptor stream\n    hdlr_data = struct.pack(\'>I4sIII\',\n        0,              # pre_defined\n        b\'odsm\',        # handler_type - Object Descriptor stream\n        0, 0, 0         # reserved\n    )\n    hdlr_data += b\'GPAC ISO OD Handler\\x00\'\n    mdia_data += write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box\n    minf_data = b\'\'\n    \n    # nmhd box (null media header for OD streams)\n    nmhd_data = b\'\'\n    minf_data += write_fullbox(b\'nmhd\', 0, 0, nmhd_data)\n    \n    # dinf box\n    dinf_data = b\'\'\n    dref_data = struct.pack(\'>I\', 1)  # entry_count\n    url_data = b\'\'\n    dref_data += write_fullbox(b\'url \', 0, 0x000001, url_data)\n    dinf_data += write_fullbox(b\'dref\', 0, 0, dref_data)\n    minf_data += write_box(b\'dinf\', dinf_data)\n    \n    # stbl box\n    stbl_data = b\'\'\n    \n    # stsd box - sample description\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count\n    \n    # mp4s sample entry for OD stream\n    mp4s_data = struct.pack(\'>6sH\', b\'\\x00\' * 6, 1)  # reserved, data_reference_index\n    \n    # esds box - ES descriptor with malformed content\n    # ES_Descriptor tag (0x03)\n    es_desc = b\'\\x03\'\n    es_desc_content = struct.pack(\'>HB\', 1, 0)  # ES_ID=1, streamPriority=0\n    \n    # DecoderConfigDescriptor tag (0x04)\n    dec_config = b\'\\x04\'\n    dec_config_content = struct.pack(\'>BBIIH\',\n        0x01,           # objectTypeIndication (Systems ISO/IEC 14496-1 - OD)\n        0x05,           # streamType (ObjectDescriptorStream)\n        0,              # bufferSizeDB (24 bits)\n        0,              # maxBitrate\n        0               # avgBitrate\n    )\n    \n    # SLConfigDescriptor tag (0x06)\n    sl_config = b\'\\x06\\x01\\x02\'  # tag, length=1, predefined=2\n    dec_config_content += sl_config\n    \n    dec_config_len = len(dec_config_content)\n    dec_config += bytes([dec_config_len]) + dec_config_content\n    \n    es_desc_content += dec_config\n    es_desc_len = len(es_desc_content)\n    es_desc += bytes([es_desc_len]) + es_desc_content\n    \n    mp4s_data += write_fullbox(b\'esds\', 0, 0, es_desc)\n    stsd_data += write_box(b\'mp4s\', mp4s_data)\n    stbl_data += write_fullbox(b\'stsd\', 0, 0, stsd_data)\n    \n    # stts box - time to sample\n    stts_data = struct.pack(\'>I\', 1)  # entry_count\n    stts_data += struct.pack(\'>II\', 1, 1000)  # sample_count=1, sample_delta=1000\n    stbl_data += write_fullbox(b\'stts\', 0, 0, stts_data)\n    \n    # stsc box - sample to chunk\n    stsc_data = struct.pack(\'>I\', 1)  # entry_count\n    stsc_data += struct.pack(\'>III\', 1, 1, 1)  # first_chunk, samples_per_chunk, sample_description_index\n    stbl_data += write_fullbox(b\'stsc\', 0, 0, stsc_data)\n    \n    # Malformed OD sample that will cause Media_ParseODFrame to fail\n    # Using invalid OD command structure to trigger decode failure\n    malformed_od_sample = b\'\\x01\\x80\\x80\\x80\\xFF\'  # Invalid OD command with bad length encoding\n    \n    # stsz box - sample size\n    stsz_data = struct.pack(\'>II\', 0, 1)  # sample_size=0 (variable), sample_count=1\n    stsz_data += struct.pack(\'>I\', len(malformed_od_sample))\n    stbl_data += write_fullbox(b\'stsz\', 0, 0, stsz_data)\n    \n    # stco box - chunk offset (will be updated)\n    stco_data = struct.pack(\'>I\', 1)  # entry_count\n    stco_data += struct.pack(\'>I\', 0)  # chunk_offset (placeholder)\n    stbl_data += write_fullbox(b\'stco\', 0, 0, stco_data)\n    \n    minf_data += write_box(b\'stbl\', stbl_data)\n    mdia_data += write_box(b\'minf\', minf_data)\n    trak_data += write_box(b\'mdia\', mdia_data)\n    moov_data += write_box(b\'trak\', trak_data)\n    \n    # mvex box - movie extends (required for fragmentation)\n    mvex_data = b\'\'\n    \n    # trex box - track extends\n    trex_data = struct.pack(\'>IIIII\',\n        1,              # track_ID\n        1,              # default_sample_description_index\n        1000,           # default_sample_duration\n        0,              # default_sample_size\n        0               # default_sample_flags\n    )\n    mvex_data += write_fullbox(b\'trex\', 0, 0, trex_data)\n    moov_data += write_box(b\'mvex\', mvex_data)\n    \n    moov_box = write_box(b\'moov\', moov_data)\n    f.write(moov_box)\n    \n    # mdat box - media data\n    mdat_offset = f.tell() + 8  # +8 for mdat header\n    mdat_data = malformed_od_sample\n    f.write(write_box(b\'mdat\', mdat_data))\n    \n    # Update stco with correct offset\n    f.seek(0)\n    content = bytearray(f.read())\n    \n    # Find and update stco offset\n    stco_pos = content.find(b\'stco\')\n    if stco_pos != -1:\n        offset_pos = stco_pos + 12  # After version/flags and entry_count\n        struct.pack_into(\'>I\', content, offset_pos, mdat_offset)\n    \n    f.seek(0)\n    f.write(content)\n\nprint(f"Generated test case at: {output_path}")\nprint("MP4 with OD track and mvex box for fragmentation support")\n'}
