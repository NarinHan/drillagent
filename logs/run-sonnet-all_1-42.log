lternate_group\n        0,          # volume\n        0,          # reserved\n        0x00010000, 0, 0, 0,           # matrix\n        0x00010000, 0, 0, 0,\n        0x40000000,                     # matrix\n        0, 0)       # width, height\n    return write_full_box(b\'tkhd\', 0, 3, data)\n\ndef create_mdhd():\n    """Create media header box"""\n    data = struct.pack(\'>IIIIH\',\n        0,          # creation_time\n        0,          # modification_time\n        1000,       # timescale\n        1000,       # duration\n        0x55c4)     # language (und) + pre_defined\n    return write_full_box(b\'mdhd\', 0, 0, data)\n\ndef create_hdlr():\n    """Create handler reference box for OD track"""\n    data = struct.pack(\'>I4sIII\', 0, b\'odsm\', 0, 0, 0)\n    data += b\'ObjectDescriptorHandler\\x00\'\n    return write_full_box(b\'hdlr\', 0, 0, data)\n\ndef create_nmhd():\n    """Create null media header box"""\n    return write_full_box(b\'nmhd\', 0, 0, b\'\')\n\ndef create_dref():\n    """Create data reference box"""\n    url_entry = write_full_box(b\'url \', 0, 1, b\'\')\n    data = struct.pack(\'>I\', 1) + url_entry\n    return write_full_box(b\'dref\', 0, 0, data)\n\ndef create_esds():\n    """Create ESD box with minimal ES descriptor"""\n    # ES_Descriptor with streamType = 0x01 (ObjectDescriptorStream)\n    esd_data = b\'\\x03\\x14\\x00\\x01\\x00\'  # ES_DescrTag, size, ES_ID\n    esd_data += b\'\\x04\\x0c\'              # DecoderConfigDescrTag, size\n    esd_data += b\'\\x01\'                  # objectTypeIndication (Systems ISO/IEC 14496-1)\n    esd_data += b\'\\x04\'                  # streamType (4 = VisualStream, but we use OD)\n    esd_data += b\'\\x00\\x00\\x00\'          # bufferSizeDB\n    esd_data += b\'\\x00\\x00\\x00\\x00\'      # maxBitrate\n    esd_data += b\'\\x00\\x00\\x00\\x00\'      # avgBitrate\n    esd_data += b\'\\x06\\x01\\x02\'          # SLConfigDescrTag, size, predefined=2\n    return write_full_box(b\'esds\', 0, 0, esd_data)\n\ndef 