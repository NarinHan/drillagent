0,\n        struct.pack(\'>I\', 0) +  # sample_size (0 = variable)\n        struct.pack(\'>I\', 1) +  # sample_count\n        struct.pack(\'>I\', len(bifs_data))  # size of sample 1\n    )\n    stbl_data.write(stsz)\n    \n    # stco box - chunk offsets (will calculate later)\n    mdat_offset_pos = stbl_data.tell() + 16  # Position where offset is written\n    stco = write_full_box(b\'stco\', 0, 0,\n        struct.pack(\'>I\', 1) +  # entry_count\n        struct.pack(\'>I\', 0)  # chunk_offset (placeholder)\n    )\n    stbl_data.write(stco)\n    \n    # Finalize stbl\n    stbl = write_box(b\'stbl\', stbl_data.getvalue())\n    minf_data.write(stbl)\n    \n    # Finalize minf\n    minf = write_box(b\'minf\', minf_data.getvalue())\n    mdia_data.write(minf)\n    \n    # Finalize mdia\n    mdia = write_box(b\'mdia\', mdia_data.getvalue())\n    trak_data.write(mdia)\n    \n    # Finalize trak\n    trak = write_box(b\'trak\', trak_data.getvalue())\n    moov_data.write(trak)\n    \n    # Finalize moov\n    moov = write_box(b\'moov\', moov_data.getvalue())\n    \n    # Calculate mdat offset (after ftyp + moov)\n    mdat_offset = len(ftyp) + len(moov) + 8  # +8 for mdat header\n    \n    # Update stco with correct offset\n    moov_bytes = bytearray(moov)\n    # Find stco box and update offset\n    stco_pos = moov_bytes.find(b\'stco\')\n    if stco_pos > 0:\n        offset_pos = stco_pos + 12  # stco + version/flags + entry_count\n        struct.pack_into(\'>I\', moov_bytes, offset_pos, mdat_offset)\n    \n    f.write(bytes(moov_bytes))\n    \n    # mdat box with BIFS sample\n    mdat = write_box(b\'mdat\', bifs_data)\n    f.write(mdat)\n\nprint(f"Generated testcase at {output_path}")\n'}
