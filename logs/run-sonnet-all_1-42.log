    chmod +x ./configure
    ./configure --static-build --extra-cflags="$SAN_CFLAGS ${CFLAGS}" --extra-ldflags="$SAN_LDFLAGS ${CFLAGS}"
else
    echo "Error: configure script not found."
    exit 1
fi

# Compile the project using all available processors
make -j$(nproc)

