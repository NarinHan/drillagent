data += struct.pack(\'>H\', 0)  # pre_defined\nmdia_buffer.write(write_fullbox(b\'mdhd\', 0, 0, mdhd_data))\n\n# hdlr box (handler) - scene description handler\nhdlr_data = struct.pack(\'>I\', 0)  # pre_defined\nhdlr_data += b\'sdsm\'  # handler_type (scene description stream)\nhdlr_data += b\'\\x00\' * 12  # reserved\nhdlr_data += b\'BIFS\\x00\'  # name\nmdia_buffer.write(write_fullbox(b\'hdlr\', 0, 0, hdlr_data))\n\n# minf box\nminf_buffer = io.BytesIO()\n\n# nmhd box (null media header)\nnmhd_data = b\'\'\nminf_buffer.write(write_fullbox(b\'nmhd\', 0, 0, nmhd_data))\n\n# dinf box (data information)\ndref_data = struct.pack(\'>I\', 1)  # entry_count\ndref_data += write_fullbox(b\'url \', 0, 1, b\'\')  # self-contained\ndinf_data = write_fullbox(b\'dref\', 0, 0, dref_data)\nminf_buffer.write(write_box(b\'dinf\', dinf_data))\n\n# stbl box (sample table)\nstbl_buffer = io.BytesIO()\n\n# stsd box (sample description) - BIFS config\nstsd_data = struct.pack(\'>I\', 1)  # entry_count\n\n# mp4s (MPEG-4 Systems sample entry for BIFS)\nmp4s_data = b\'\\x00\' * 6  # reserved\nmp4s_data += struct.pack(\'>H\', 1)  # data_reference_index\n\n# esds box (ES Descriptor) - critical for BIFS identification\nes_desc = b\'\\x03\'  # ES_Descriptor tag\nes_desc_content = struct.pack(\'>H\', 1)  # ES_ID = 1\nes_desc_content += b\'\\x00\'  # flags\n\n# DecoderConfigDescriptor tag (0x04)\ndec_config = b\'\\x04\'\ndec_config_content = b\'\\x01\'  # objectTypeIndication = 0x01 (BIFS v1) - CRITICAL!\ndec_config_content += b\'\\x11\'  # streamType = 0x03 << 2 | 0x01 (scene description)\ndec_config_content += b\'\\x00\\x00\\x10\'  # bufferSizeDB (24 bits)\ndec_config_content += struct.pack(\'>I\', 100000)  # maxBitrate\ndec_config_content += struct.pack(\'>I\', 0)  # avgBitrate\n\n# DecoderSpecificInfo tag (0x05) - BIFS config (minimal but valid)\ndec_specific = b\'\\x05\'\n# Minimal BIFS config: NodeIDBits=1, RouteIDBits=0, ProtoIDBits=0\nbifs_config = b\'\\x00\'  # All fields = 0 (minimal config)\ndec_specific += bytes([len(bifs_config)])\ndec_specific += bifs_config\n\ndec_config_content += dec_specific\ndec_config += bytes([len(dec_config_content)])\ndec_config += dec_config_content\n\n# SLConfigDescriptor tag (0x06)\nsl_config = b\'\\x06\'\nsl_config += b\'\\x01\'  # length\nsl_config += b\'\\x02\'  # predefined = 2\n\nes_desc_content += dec_config + sl_config\nes_desc += bytes([len(es_desc_content)])\nes_desc += es_desc_content\n\nesds_data = es_desc\nmp4s_data += write_fullbox(b\'esds\', 0, 0, esds_data)\n\nstsd_entry = struct.pack(\'>I\', len(mp4s_data) + 8) + b\'mp4s\' + mp4s_data\nstsd_data += stsd_entry\nstbl_buffer.write(write_fullbox(b\'stsd\', 0, 0, stsd_data))\n\n# stts box (time-to-sample)\nstts_data = struct.pack(\'>I\', 1)  # entry_count\nstts_data += struct.pack(\'>I\', 1)  # sample_count\nstts_data += struct.pack(\'>I\', 1000)  # sample_delta\nstbl_buffer.write(write_fullbox(b\'stts\', 0, 0, stts_data))\n\n# stsc box (sample-to-chunk)\nstsc_data = struct.pack(\'>I\', 1)  # entry_count\nstsc_data += struct.pack(\'>I\', 1)  # first_chunk\nstsc_data += struct.pack(\'>I\', 1)  # samples_per_chunk\nstsc_data += struct.pack(\'>I\', 1)  # sample_description_index\nstbl_buffer.write(write_fullbox(b\'stsc\', 0, 0, stsc_data))\n\n# stsz box (sample size)\nstsz_data = struct.pack(\'>I\', 0)  # sample_size (0 = variable)\nstsz_data += struct.pack(\'>I\', 1)  # sample_count\nstsz_data += struct.pack(\'>I\', len(bifs_sample))  # entry_size[0]\nstbl_buffer.write(write_fullbox(b\'stsz\', 0, 0, stsz_data))\n\n# stco box (chunk offset)\nstco_data = struct.pack(\'>I\', 1)  # entry_count\n# Calculate mdat data offset (ftyp + mdat header)\nmdat_offset = 20 + 8  # ftyp size + mdat header\nstco_data += struct.pack(\'>I\', mdat_offset)  # chunk_offset[0]\nstbl_buffer.write(write_fullbox(b\'stco\', 0, 0, stco_data))\n\n# Close stbl\nminf_buffer.write(write_box(b\'stbl\', stbl_buffer.getvalue()))\n\n# Close minf\nmdia_buffer.write(write_box(b\'minf\', minf_buffer.getvalue()))\n\n# Close mdia\ntrak_buffer.write(write_box(b\'mdia\', mdia_buffer.getvalue()))\n\n# Close trak\nmoov_buffer.write(write_box(b\'trak\', trak_buffer.getvalue()))\n\n# Close moov\nmp4_data.write(write_box(b\'moov\', moov_buffer.getvalue()))\n\n# Write to file\nwith open(output_path, \'wb\') as f:\n    f.write(mp4_data.getvalue())\n\nprint(f"Generated PoV at {output_path}")\nprint(f"File size: {len(mp4_data.getvalue())} bytes")\n'}
