[CRASH TRACE]
  (Refined CRASH Trace):
  #0: gf_media_export_filters @ src/media_tools/media_export.c:1112
  #1: gf_media_export @ src/media_tools/media_export.c:1474
  #2: do_export_tracks @ applications/mp4box/main.c:4644
