ruct.pack(\'>I\', 0x00010000) + \\\n                struct.pack(\'>H\', 0x0100) + \\\n                struct.pack(\'>H\', 0) + \\\n                struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 0) + \\\n                (b\'\\x00\\x01\\x00\\x00\' + b\'\\x00\' * 12) * 3 + \\\n                b\'\\x40\\x00\\x00\\x00\' + \\\n                b\'\\x00\' * 24 + \\\n                struct.pack(\'>I\', 2)\n    mvhd = write_fullbox(b\'mvhd\', 0, 0, mvhd_data)\n    \n    # trak box\n    # tkhd\n    tkhd_data = struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 1) + \\\n                struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 0) + \\\n                b\'\\x00\' * 8 + \\\n                struct.pack(\'>H\', 0) + \\\n                struct.pack(\'>H\', 0) + \\\n                struct.pack(\'>H\', 0) + \\\n                struct.pack(\'>H\', 0) + \\\n                (b\'\\x00\\x01\\x00\\x00\' + b\'\\x00\' * 12) * 3 + \\\n                struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 0)\n    tkhd = write_fullbox(b\'tkhd\', 0, 7, tkhd_data)\n    \n    # mdia box\n    # mdhd\n    mdhd_data = struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 1000) + \\\n                struct.pack(\'>I\', 0) + \\\n                struct.pack(\'>I\', 0) + \\\n                b\'\\x00\' * 4\n    mdhd = write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr\n    hdlr_data = b\'\\x00\' * 8 + b\'vide\' + b\'\\x00\' * 12 + b\'VideoHandler\\x00\'\n    hdlr = write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box\n    # vmhd\n    vmhd_data = struct.pack(\'>H\', 0) + struct.pack(\'>H\', 0) + \\\n                struct.pack(\'>H\', 0) + struct.pack(\'>H\', 0)\n    vmhd = write_fullbox(b\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf box\n    dref_entry = write_fullbox(b\'url \', 0, 1, b\'\')\n    dref = write_fullbox(b\'dref