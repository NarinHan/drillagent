    # Build mdia box\n    mdia_data = b\'\'\n    \n    # mdhd box\n    mdhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x55c4, 0)\n    mdia_data += write_full_box(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr box\n    hdlr_data = struct.pack(\'>I\', 0) + b\'vide\' + struct.pack(\'>III\', 0, 0, 0) + b\'VideoHandler\\x00\'\n    mdia_data += write_full_box(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # Build minf box\n    minf_data = b\'\'\n    \n    # vmhd box\n    vmhd_data = struct.pack(\'>HHHH\', 0, 0, 0, 0)\n    minf_data += write_full_box(b\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf box\n    dinf_data = b\'\'\n    dref_data = struct.pack(\'>I\', 1)\n    dref_data += write_full_box(b\'url \', 0, 1, b\'\')\n    dinf_data += write_full_box(b\'dref\', 0, 0, dref_data)\n    minf_data += write_box(b\'dinf\', dinf_data)\n    \n    # Build stbl box with sample group description in the track\n    stbl_data = b\'\'\n    \n    # stsd box\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count\n    avc1_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)  # reserved, data_reference_index\n    avc1_data += b\'\\x00\' * 16  # pre_defined\n    avc1_data += struct.pack(\'>HH\', 320, 240)  # width, height\n    avc1_data += struct.pack(\'>I\', 0x00480000)  # horizresolution\n    avc1_data += struct.pack(\'>IH\', 0x00480000, 1)  # vertresolution, frame_count\n    avc1_data += b\'\\x00\' * 32  # compressorname\n    avc1_data += struct.pack(\'>HH\', 0x0018, 0xffff)  # depth, pre_defined\n    stsd_data += write_box(b\'avc1\', avc1_data)\n    stbl_data += write_full_box(b\'stsd\', 0, 0, stsd_data)\n    \n    # stts, stsc, stsz, stco boxes\n    stbl_data += write_full_box(b\'stts\', 0, 0, struct.pack(\'>I\', 0))\n    stbl_data += write_full_box(b\'stsc\', 0, 0, struct.pack(\'>I\', 0))\n    stbl_data += write_full_box(b\'stsz\', 0, 0, struct.pack(\'>II\', 0, 0))\n    stbl_data += write_full_box(b\'stco\', 0, 0, struct.pack(\'>I\', 0))\n    \n    # Add sgpd box in the track\'s sample table (this will be compared with fragment\'s sgpd)\n    sgpd_data = struct.pack(\'>I\', 0x726F6C6C)  # grouping_type = \'roll\'\n    sgpd_data += struct.pack(\'>I\', 0)  # default_length = 0 (v1)\n    sgpd_data += struct.pack(\'>I\', 1)  # entry_count = 1\n    sgpd_data += struct.pack(\'>I\', 2)  # entry size\n    sgpd_data += struct.pack(\'>h\', -1)  # roll_distance\n    stbl_data += write_full_box(b\'sgpd\', 1, 0, sgpd_data)\n    \n    # Add sbgp box\n    sbgp_data = struct.pack(\'>I\', 0x726F6C6C)  # grouping_type = \'roll\'\n    sbgp_data += struct.pack(\'>I\', 0)  # entry_count\n    stbl_data += write_full_box(b\'sbgp\', 0, 0, sbgp_data)\n    \n    minf_data += write_box(b\'stbl\', stbl_data)\n    mdia_data += write_box(b\'minf\', minf_data)\n    trak_data += write_box(b\'mdia\', mdia_data)\n    moov_data += write_box(b\'trak\', trak_data)\n    \n    # mvex box (Movie Extends) - REQUIRED for fragments\n    mvex_data = b\'\'\n    trex_data = struct.pack(\'>IIIII\', 1, 1, 0, 0, 0)  # track_ID, default_sample_description_index, duration, size, flags\n    mvex_data += write_full_box(b\'trex\', 0, 0, trex_data)\n    moov_data += write_box(b\'mvex\', mvex_data)\n    \n    f.write(write_box(b\'moov\', moov_data))\n    \n    # Write moof box (Movie Fragment) with sgpd that will trigger comparison\n    moof_data = b\'\'\n    \n    # mfhd box\n    mfhd_data = struct.pack(\'>I\', 1)  # sequence_number\n    moof_data += write_full_box(b\'mfhd\', 0, 0, mfhd_data)\n    \n    # Build traf box\n    traf_data = b\'\'\n    \n    # tfhd box\n    tfhd_data = struct.pack(\'>I\', 1)  # track_ID\n    traf_data += write_full_box(b\'tfhd\', 0, 0, tfhd_data)\n    \n    # tfdt box (Track Fragment Decode Time)\n    tfdt_data = struct.pack(\'>Q\', 0)  # baseMediaDecodeTime\n    traf_data += write_full_box(b\'tfdt\', 1, 0, tfdt_data)\n    \n    # sgpd box - Sample Group Description with similar but slightly different entry\n    # This will trigger the comparison in MergeTrack\n    sgpd_data = struct.pack(\'>I\', 0x726F6C6C)  # grouping_type = \'roll\'\n    sgpd_data += struct.pack(\'>I\', 0)  # default_length = 0 (v1)\n    sgpd_data += struct.pack(\'>I\', 2)  # entry_count = 2\n    # Entry 1 - matches track\'s entry\n    sgpd_data += struct.pack(\'>I\', 2)  # entry size\n    sgpd_data += struct.pack(\'>h\', -1)  # roll_distance\n    # Entry 2 - different entry that will trigger comparison\n    sgpd_data += struct.pack(\'>I\', 2)  # entry size\n    sgpd_data += struct.pack(\'>h\', 1)  # roll_distance (different)\n    traf_data += write_full_box(b\'sgpd\', 1, 0, sgpd_data)\n    \n    # Add sbgp box to reference the sgpd entries\n    sbgp_data = struct.pack(\'>I\', 0x726F6C6C)  # grouping_type = \'roll\'\n    sbgp_data += struct.pack(\'>I\', 2)  # entry_count\n    sbgp_data += struct.pack(\'>II\', 1, 1)  # sample_count, group_description_index\n    sbgp_data += struct.pack(\'>II\', 1, 2)  # sample_count, group_description_index\n    traf_data += write_full_box(b\'sbgp\', 0, 0, sbgp_data)\n    \n    # Add trun box with sample data\n    trun_data = struct.pack(\'>I\', 2)  # sample_count\n    trun_data += struct.pack(\'>I\', 100)  # data_offset\n    traf_data += write_full_box(b\'trun\', 0, 1, trun_data)  # flags=1 for data_offset_present\n    \n    moof_data += write_box(b\'traf\', traf_data)\n    f.write(write_box(b\'moof\', moof_data))\n    \n    # Write mdat box with actual data\n    mdat_data = b\'\\x00\' * 100  # dummy media data\n    f.write(write_box(b\'mdat\', mdat_data))\n\nprint(f"Generated testcase at {output_path}")\n'}
