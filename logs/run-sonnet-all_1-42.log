struct.pack(\'>I\', 1000)  # duration\n    mdhd_data += struct.pack(\'>H\', 0x55c4)  # language (und)\n    mdhd_data += struct.pack(\'>H\', 0)  # pre_defined\n    mdia_data += write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr box (handler) - scene description handler\n    hdlr_data = struct.pack(\'>I\', 0)  # pre_defined\n    hdlr_data += b\'sdsm\'  # handler_type (scene description stream)\n    hdlr_data += b\'\\x00\' * 12  # reserved\n    hdlr_data += b\'BIFS Scene Handler\\x00\'  # name\n    mdia_data += write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box\n    minf_data = b\'\'\n    \n    # nmhd box (null media header - for non-visual/non-audio streams)\n    nmhd_data = b\'\'\n    minf_data += write_fullbox(b\'nmhd\', 0, 0, nmhd_data)\n    \n    # dinf box (data information)\n    dinf_data = b\'\'\n    dref_data = struct.pack(\'>I\', 1)  # entry_count\n    url_data = b\'\'\n    dref_data += write_fullbox(b\'url \', 0, 1, url_data)  # self-contained\n    dinf_data += write_fullbox(b\'dref\', 0, 0, dref_data)\n    minf_data += write_box(b\'dinf\', dinf_data)\n    \n    # stbl box (sample table)\n    stbl_data = b\'\'\n    \n    # stsd box (sample description) - BIFS config\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count\n    \n    # mp4s (MPEG-4 Systems sample entry for BIFS)\n    mp4s_data = b\'\\x00\' * 6  # reserved\n    mp4s_data += struct.pack(\'>H\', 1)  # data_reference_index\n    \n    # esds box (ES Descriptor)\n    esds_data = b\'\'\n    # ES_Descriptor tag (0x03)\n    es_desc = b\'\\x03\'\n    es_desc_content = struct.pack(\'>H\', 1)  # ES_ID = 1\n    es_desc_content += b\'\\x00\'  # flags\n    \n    # DecoderConfigDescriptor tag (0x04)\n    dec_config = b\'\\x04\'\n    dec_config_content = b\'\\x01\'  # objectTypeIndication = 0x01 (BIFS v1)\n    dec_config_content += b\'\\x11\'  # streamType = 0x03 (scene description), upstream=0\n    dec_config_content += b\'\\x00\\x00\\x10\'  # bufferSizeDB (24 bits) = 4096\n    dec_config_content += struct.pack(\'>I\', 100000)  # maxBitrate\n    dec_config_content += struct.pack(\'>I\', 0)  # avgBitrate\n    \n    # DecoderSpecificInfo tag (0x05) - BIFS config\n    dec_specific = b\'\\x05\'\n    # Create a minimal but valid BIFS config\n    bifs_config = b\'\\x00\'  # Simple config byte\n    dec_specific += bytes([len(bifs_config)])\n    dec_specific += bifs_config\n    \n    dec_config_content += dec_specific\n    \n    # Encode length for DecoderConfigDescriptor\n    dec_config += bytes([len(dec_config_content)])\n    dec_config += dec_config_content\n    \n    # SLConfigDescriptor tag (0x06)\n    sl_config = b\'\\x06\'\n    sl_config += b\'\\x01\'  # length = 1\n    sl_config += b\'\\x02\'  # predefined = 2 (reserved for use in MP4 files)\n    \n    es_desc_content += dec_config + sl_config\n    \n    # Encode length for ES_Descriptor\n    es_desc += bytes([len(es_desc_content)])\n    es_desc += es_desc_content\n    \n    esds_data = es_desc\n    mp4s_data += write_fullbox(b\'esds\', 0, 0, esds_data)\n    \n    stsd_entry = struct.pack(\'>I\', len(mp4s_data) + 8) + b\'mp4s\' + mp4s_data\n    stsd_data += stsd_entry\n    stbl_data += write_fullbox(b\'stsd\', 0, 0, stsd_data)\n    \n    # stts box (time-to-sample)\n    stts_data = struct.pack(\'>I\', 1)  # entry_count\n    stts_data += struct.pack(\'>I\', 1)  # sample_count\n    stts_data += struct.pack(\'>I\', 1000)  # sample_delta\n    stbl_data += write_fullbox(b\'stts\', 0, 0, stts_data)\n    \n    # stsc box (sample-to-chunk)\n    stsc_data = struct.pack(\'>I\', 1)  # entry_count\n    stsc_data += struct.pack(\'>I\', 1)  # first_chunk\n    stsc_data += struct.pack(\'>I\', 1)  # samples_per_chunk\n    stsc_data += struct.pack(\'>I\', 1)  # sample_description_index\n    stbl_data += write_fullbox(b\'stsc\', 0, 0, stsc_data)\n    \n    # stsz box (sample size)\n    stsz_data = struct.pack(\'>I\', 0)  # sample_size (0 = variable)\n    stsz_data += struct.pack(\'>I\', 1)  # sample_count\n    stsz_data += struct.pack(\'>I\', 8)  # size of sample 1\n    stbl_data += write_fullbox(b\'stsz\', 0, 0, stsz_data)\n    \n    # stco box (chunk offset) - placeholder\n    stco_data = struct.pack(\'>I\', 1)  # entry_count\n    stco_data += struct.pack(\'>I\', 0)  # chunk_offset (placeholder)\n    stbl_data += write_fullbox(b\'stco\', 0, 0, stco_data)\n    \n    minf_data += write_box(b\'stbl\', stbl_data)\n    mdia_data += write_box(b\'minf\', minf_data)\n    trak_data += write_box(b\'mdia\', mdia_data)\n    moov_data += write_box(b\'trak\', trak_data)\n    \n    moov_box = write_box(b\'moov\', moov_data)\n    f.write(moov_box)\n    \n    # Calculate mdat offset\n    mdat_offset = f.tell() + 8  # +8 for mdat header\n    \n    # Write mdat box with BIFS sample data\n    # Create a BIFS command that will be parsed\n    # BIFS command format: 2 bits type, then data\n    # Type 0 = Scene Replace, Type 1 = Insert, Type 2 = Delete, Type 3 = Replace\n    bifs_sample = b\'\\x40\'  # Type 1 (Insert), then 0 bit for "not last"\n    bifs_sample += b\'\\x00\' * 7  # Padding to make 8 bytes\n    \n    mdat_box = write_box(b\'mdat\', bifs_sample)\n    f.write(mdat_box)\n    \n    # Go back and fix the stco offset\n    f.seek(0)\n    content = bytearray(f.read())\n    \n    # Find stco box and update offset\n    stco_pos = content.find(b\'stco\')\n    if stco_pos != -1:\n        offset_pos = stco_pos + 12  # 4 (type) + 4 (version/flags) + 4 (entry_count)\n        struct.pack_into(\'>I\', content, offset_pos, mdat_offset)\n    \n    f.seek(0)\n    f.write(content)\n    f.truncate()\n\nprint(f"Generated PoV at {output_path}")\nprint("This MP4 contains a properly configured BIFS scene track")\n'}
