#!/bin/bash -e
# Coverage instrumentation flags
COV_CFLAGS="-g -O0 -fprofile-instr-generate -fcoverage-mapping"
COV_LDFLAGS="-fprofile-instr-generate -fcoverage-mapping"
CFLAGS="${CFLAGS:-}"
CXXFLAGS="${CXXFLAGS:-}"
LDFLAGS="${LDFLAGS:-}"

#!/bin/bash

# Standalone build script for GPAC

# Ensure script is executed from the correct directory
if [ "$(basename $PWD)" != "gpac" ]; then
 echo "Please run this script from the gpac directory."
 exit 1
fi

# Set default compiler flags if not already set
CFLAGS="${CFLAGS:--w -Wno-yacc -Wno-incompatible-pointer-types -fsanitize-address-use-after-scope}"

# Configure the project
if [ -f ./configure ]; then
 chmod +x ./configure
 CC=clang CXX=clang++ ./configure --static-build --extra-cflags="$COV_CFLAGS $CFLAGS" --extra-ldflags="$COV_LDFLAGS $CFLAGS"
else
 echo "Configure script not found. Skipping configuration."
fi

# Build the project
make -j$(nproc)

