[CRASH TRACE]
  (Refined CRASH Trace):
  #0: Media_RewriteODFrame @ src/isomedia/media_odf.c:135
  #1: Media_GetSample @ src/isomedia/media.c:646
  #2: gf_isom_get_sample_ex @ src/isomedia/isom_read.c:1862
  #3: gf_isom_get_sample @ src/isomedia/isom_read.c:1882
  #4: HintFile @ applications/mp4box/main.c:3410
  #5: mp4boxMain @ applications/mp4box/main.c:6207
