header.append((frame_length >> 3) & 0xFF)\n    \n    # Byte 5: frame_length_low(3) + buffer_fullness_high(5)\n    # frame_length_low(3) + 0x1F (buffer_fullness_high = 0x7FF >> 6)\n    header.append(((frame_length & 0x7) << 5) | 0x1F)\n    \n    # Byte 6: buffer_fullness_low(6) + num_blocks(2)\n    # 0xFC (buffer_fullness_low = 0x7FF & 0x3F << 2) + 0 (num_blocks)\n    header.append(0xFC)\n    \n    return bytes(header)\n\ndef create_aac_frame_with_sbr():\n    """Create AAC raw data block with SCE and fill element containing SBR data"""\n    raw_data = bytearray()\n    \n    # ID_SCE (3 bits) = 0x0\n    # element_instance_tag (4 bits) = 0x0\n    # Total: 7 bits, need to pack carefully\n    \n    # Start with ID_SCE (0x0, 3 bits)\n    bit_buffer = 0\n    bit_count = 0\n    \n    def write_bits(value, num_bits):\n        nonlocal bit_buffer, bit_count\n        bit_buffer = (bit_buffer << num_bits) | (value & ((1 << num_bits) - 1))\n        bit_count += num_bits\n        while bit_count >= 8:\n            bit_count -= 8\n            raw_data.append((bit_buffer >> bit_count) & 0xFF)\n    \n    # ID_SCE (3 bits)\n    write_bits(0x0, 3)\n    \n    # element_instance_tag (4 bits)\n    write_bits(0x0, 4)\n    \n    # individual_channel_stream starts here\n    # global_gain (8 bits)\n    write_bits(0x80, 8)\n    \n    # ics_info:\n    # ics_reserved_bit (1 bit) = 0\n    write_bits(0, 1)\n    \n    # window_sequence (2 bits) = ONLY_LONG_SEQUENCE (0)\n    write_bits(0, 2)\n    \n    # window_shape (1 bit) = 0\n    write_bits(0, 1)\n    \n    # max_sfb (6 bits) = 1 (minimal)\n    write_bits(1, 6)\n    \n    # scale_factor_grouping (7 bits) = 0\n    write_bits(0, 7)\n    \n    # section_data: minimal valid section\n    # sect_cb[g][i] (4 bits) - use ZERO_HCB (0)\n    write_bits(0, 4)\n    # sect_len[g][i] (5 bits for LONG) = 1\n    write_bits(1, 5)\n    # sect_esc_val (5 bits) - end section = all 1s\n    write_bits(0x1F, 5)\n    \n    # scale_factor_data: one scale factor (assumin