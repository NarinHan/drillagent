', 0, 0, 0, 0, 0, 0)  # reserved\n    data += struct.pack(\'>H\', 1)  # data_reference_index\n    \n    # ESD box - contains object type, stream type, etc.\n    esd_data = struct.pack(\'>I\', 0)  # version=0, flags=0\n    \n    # ES_Descriptor tag=0x03\n    es_desc = b\'\'\n    es_desc += struct.pack(\'>H\', 1)  # ES_ID\n    es_desc += struct.pack(\'>B\', 0)  # flags\n    \n    # DecoderConfigDescriptor tag=0x04\n    dec_config = b\'\'\n    dec_config += struct.pack(\'>B\', 0x01)  # objectTypeIndication = Systems ISO/IEC 14496-1 (OD)\n    dec_config += struct.pack(\'>B\', 0x01 << 2)  # streamType = ObjectDescriptorStream\n    dec_config += struct.pack(\'>I\', 0) # bufferSizeDB (24 bits) + first byte of maxBitrate\n    dec_config += struct.pack(\'>H\', 0)  # rest of maxBitrate\n    dec_config += struct.pack(\'>I\', 0)  # avgBitrate\n    \n    # Encode descriptor with tag and size\n    dec_config_full = struct.pack(\'>B\', 0x04) + encode_desc_size(len(dec_config)) + dec_config\n    \n    # SLConfigDescriptor tag=0x06\n    sl_config = struct.pack(\'>B\', 0x02)  # predefined=2\n    sl_config_full = struct.pack(\'>B\', 0x06) + encode_desc_size(len(sl_config)) + sl_config\n    \n    es_desc += dec_config_full + sl_config_full\n    es_desc_full = struct.pack(\'>B\', 0x03) + encode_desc_size(len(es_desc)) + es_desc\n    \n    esd_data += es_desc_full\n    esd_box = write_box(b\'esds\', esd_data)\n    \n    data += esd_box\n    return write_box(b\'mp4s\', data)\n\ndef encode_desc_size(size):\n    """Encode descriptor size in MPEG-4 style (variable length)"""\n    if size < 0x80:\n        return struct.pack(\'>B\', size)\n    elif size < 0x4000:\n        return struct.pack(\'>BB\', 0x80 | (size >> 7), size & 0x7f)\n    elif size < 0x200000:\n        return struct.pack(\'>BBB\', 0x80 | (size >> 14), 0x80 | ((size >> 7) & 0x7f), size & 0x7f)\n    else:\n        return struct.pack(\'>BBBB\', 0x80 | (size >> 21), 0x80 | ((size >> 14) & 0x7f), \n                          0x80 | ((