D=1\n    tkhd_data += struct.pack(\'>hHHII\', 0, 0, 0, 0, 0)\n    tkhd_data += struct.pack(\'>IIIIIIIII\', 0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000)\n    tkhd_data += struct.pack(\'>II\', 0, 0)\n    tkhd = write_fullbox(b\'tkhd\', 0, 0x7, tkhd_data)\n    \n    # mdia - media\n    # mdhd - media header\n    mdhd_data = struct.pack(\'>IIIIQQI\', 0, 0, 1000, 0, 0, 0, 0)  # timescale=1000\n    mdhd = write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr - handler\n    hdlr_data = struct.pack(\'>III\', 0, 0, 0) + b\'vide\' + struct.pack(\'>III\', 0, 0, 0) + b\'VideoHandler\\x00\'\n    hdlr = write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf - media information\n    # vmhd - video media header\n    vmhd_data = struct.pack(\'>Q\', 0)\n    vmhd = write_fullbox(b\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf - data information\n    # dref - data reference\n    dref_entry = write_fullbox(b\'url \', 0, 1, b\'\')\n    dref_data = struct.pack(\'>I\', 1) + dref_entry\n    dref = write_fullbox(b\'dref\', 0, 0, dref_data)\n    dinf = write_box(b\'dinf\', dref)\n    \n    # stbl - sample table\n    # stsd - sample description\n    stsd_entry = b\'\\x00\' * 6  # reserved[6]\n    stsd_entry += struct.pack(\'>H\', 1)  # data_reference_index\n    stsd_entry += struct.pack(\'>HH\', 0, 0)\n    stsd_entry += struct.pack(\'>III\', 0, 0, 0)\n    stsd_entry += struct.pack(\'>HH\', 320, 240)  # width, height\n    stsd_entry += struct.pack(\'>II\', 0x00480000, 0x00480000)\n    stsd_entry += struct.pack(\'>I\', 0)\n    stsd_entry += struct.pack(\'>H\', 1)  # frame_count\n    stsd_entry += b\'\\x00\' * 32  # compressorname\n    stsd_entry += struct.pack(\'>HH\', 0x0018, 0xFFFF)\n    stsd_visual = write_box(b\'avc1\', stsd_entry)\n    stsd_data = struct.pack(\'>I\', 1) + stsd_visual\n    stsd = write_fullbox(b\'stsd\', 0, 0, stsd_data)\n    \n    # stts - time to sample\n    stts_data = struct.pack(\'>I\', 0)\n    stts = write_fullbox(b\'stts\', 0, 0, stts_data)\n    \n  