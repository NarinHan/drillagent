eight (240)\n    )\n    trak_data += write_fullbox(b\'tkhd\', 0, 7, tkhd_data)  # flags=7 (enabled, in_movie, in_preview)\n    \n    # mdia box\n    mdia_data = b\'\'\n    \n    # mdhd (Media Header)\n    mdhd_data = struct.pack(\'>IIIIHH\',\n        0,  # creation_time\n        0,  # modification_time\n        1000,  # timescale\n        1000,  # duration\n        0x55C4,  # language (und)\n        0  # pre_defined\n    )\n    mdia_data += write_fullbox(b\'mdhd\', 0, 0, mdhd_data)\n    \n    # hdlr (Handler)\n    hdlr_data = struct.pack(\'>I4sIII\', 0, b\'vide\', 0, 0, 0) + b\'VideoHandler\\x00\'\n    mdia_data += write_fullbox(b\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box\n    minf_data = b\'\'\n    \n    # vmhd (Video Media Header)\n    vmhd_data = struct.pack(\'>HHHH\', 0, 0, 0, 0)\n    minf_data += write_fullbox(b\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf box with dref\n    dref_data = struct.pack(\'>I\', 1)  # entry_count\n    url_data = struct.pack(\'>I\', 1)  # flags=1 (self-contained)\n    dref_data += write_fullbox(b\'url \', 0, 1, b\'\')\n    dinf_data = write_fullbox(b\'dref\', 0, 0, dref_data)\n    minf_data += write_box(b\'dinf\', dinf_data)\n    \n    # stbl (Sample Table)\n    stbl_data = b\'\'\n    \n    # stsd (Sample Description)\n    stsd_data = struct.pack(\'>I\', 1)  # entry_count\n    # avc1 sample entry\n    avc1_data = struct.pack(\'>IHHIHHHHHIHH\',\n        0, 0, 0,  # reserved[6] (first 3 shorts)\n        1,  # data_reference_index\n        0, 0,  # pre_defined, reserved\n        0, 0, 0,  # pre_defined[3]\n        320,  # width\n        240,  # height\n        0x00480000,  # horizresolution\n        0x00480000   # vertresolution\n    ) + struct.pack(\'>IH\', 0, 1) + b\'\\x00\' * 32 + struct.pack(\'>HH\', 24, 0xFFFF)\n    # avcC box (minimal)\n    avcc_data = struct.pack(\'>BBBBBBHBHB\', 1, 0x42, 0, 0x1E, 0xFF, 0xE1, 0, 0xE0, 0, 0)\n    avc1_data += write_box(b\'avcC\', avcc_data)\n    stsd_data += write_box(b\'avc1\', avc1_data)\n  