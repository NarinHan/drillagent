\', make_ftyp())\n    \n    # Start building moov\n    moov_data = b\'\'\n    \n    # mvhd\n    mvhd_data = make_mvhd()\n    moov_data += struct.pack(\'>I\', len(mvhd_data) + 8)\n    moov_data += b\'mvhd\'\n    moov_data += mvhd_data\n    \n    # Track with OD handler\n    trak_data = b\'\'\n    \n    # tkhd\n    tkhd_data = make_tkhd(1)\n    trak_data += struct.pack(\'>I\', len(tkhd_data) + 8)\n    trak_data += b\'tkhd\'\n    trak_data += tkhd_data\n    \n    # mdia\n    mdia_data = b\'\'\n    \n    # mdhd\n    mdhd_data = make_mdhd()\n    mdia_data += struct.pack(\'>I\', len(mdhd_data) + 8)\n    mdia_data += b\'mdhd\'\n    mdia_data += mdhd_data\n    \n    # hdlr with \'odsm\' handler type for OD\n    hdlr_data = make_hdlr(b\'odsm\')\n    mdia_data += struct.pack(\'>I\', len(hdlr_data) + 8)\n    mdia_data += b\'hdlr\'\n    mdia_data += hdlr_data\n    \n    # minf\n    minf_data = b\'\'\n    \n    # vmhd\n    vmhd_data = make_vmhd()\n    minf_data += struct.pack(\'>I\', len(vmhd_data) + 8)\n    minf_data += b\'vmhd\'\n    minf_data += vmhd_data\n    \n    # dinf\n    dinf_data = b\'\'\n    dref_data = make_dref()\n    dinf_data += struct.pack(\'>I\', len(dref_data) + 8)\n    dinf_data += b\'dref\'\n    dinf_data += dref_data\n    minf_data += struct.pack(\'>I\', len(dinf_data) + 8)\n    minf_data += b\'dinf\'\n    minf_data += dinf_data\n    \n    # stbl\n    stbl_data = b\'\'\n    \n    # stsd with OD sample entry\n    stsd_data = make_stsd_od()\n    stbl_data += struct.pack(\'>I\', len(stsd_data) + 8)\n    stbl_data += b\'stsd\'\n    stbl_data += stsd_data\n    \n    # stts\n    stts_data = make_stts()\n    stbl_data += struct.pack(\'>I\', len(stts_data) + 8)\n    stbl_data += b\'stts\'\n    stbl_data += stts_data\n    \n    # stsc\n    stsc_data = make_stsc()\n    stbl_data += struct.pack(\'>I\', len(stsc_data) + 8)\n    stbl_data += b\'stsc\'\n    stbl_data += stsc_data\n    \n    # stsz\n    stsz_data = make_stsz()\n    stbl_data += struct.pack(\'>I\', len(stsz_data) + 8)\n    stbl_data += b\'stsz\'\n    stbl_data += stsz_data\n    \n    # stco\n    stco_data = make_stco()\n    stbl_data += struct.pack(\'>I\', len(stco_data) + 8)\n    stbl_data += b\'stco\'\n    stbl_data += stco_data\n    \n    minf_data += struct.pack(\'>I\', len(stbl_data) + 8)\n    minf_data += b\'stbl\'\n    minf_data += stbl_data\n    \n    mdia_data += struct.pack(\'>I\', len(minf_data) + 8)\n    mdia_data += b\'minf\'\n    mdia_data += minf_data\n    \n    trak_data += struct.pack(\'>I\', len(mdia_data) + 8)\n    trak_data += b\'mdia\'\n    trak_data += mdia_data\n    \n    moov_data += struct.pack(\'>I\', len(trak_data) + 8)\n    moov_data += b\'trak\'\n    moov_data += trak_data\n    \n    # mvex for fragmentation support\n    mvex_data = b\'\'\n    \n    # trex\n    trex_data = struct.pack(\'>B\', 0)  # version\n    trex_data += struct.pack(\'>3B\', 0, 0, 0)  # flags\n    trex_data += struct.pack(\'>I\', 1)  # track_ID\n    trex_data += struct.pack(\'>I\', 1)  # default_sample_description_index\n    trex_data += struct.pack(\'>I\', 0)  # default_sample_duration\n    trex_data += struct.pack(\'>I\', 0)  # default_sample_size\n    trex_data += struct.pack(\'>I\', 0)  # default_sample_flags\n    \n    mvex_data += struct.pack(\'>I\', len(trex_data) + 8)\n    mvex_data += b\'trex\'\n    mvex_data += trex_data\n    \n    moov_data += struct.pack(\'>I\', len(mvex_data) + 8)\n    moov_data += b\'mvex\'\n    moov_data += mvex_data\n    \n    # Write moov\n    write_box(f, b\'moov\', moov_data)\n    \n    # Write mdat with malformed OD data\n    # The OD data is intentionally malformed to cause Media_ParseODFrame to fail\n    mdat_data = b\'\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\'  # Invalid OD data\n    write_box(f, b\'mdat\', mdat_data)\n\nprint(f"Generated test case at {output_path}")\n'}
