aw_data, 9)\n    png_data += create_png_chunk(b"IDAT", compressed_data)\n    \n    # IEND chunk\n    png_data += create_png_chunk(b"IEND", b"")\n    \n    return png_data\n\n# Generate the PNG\npng_content = generate_png_with_alpha()\n\n# Write to file\nwith open(output_path, "wb") as f:\n    f.write(png_content)\n\nprint(f"Generated PNG with alpha channel at: {output_path}")\nprint(f"Image size: 10x10 pixels with RGBA format")\nprint(f"File size: {len(png_content)} bytes")\n'}
