 CC=clang CXX=clang++ CFLAGS="$COV_CFLAGS $CFLAGS" CXXFLAGS="$COV_CFLAGS $CXXFLAGS" LDFLAGS="$COV_LDFLAGS $LDFLAGS" ./configure $CONFIG_OPTS

