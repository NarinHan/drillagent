#!/bin/bash -e
# Coverage instrumentation flags
COV_CFLAGS="-g -O0 -fprofile-instr-generate -fcoverage-mapping"
COV_LDFLAGS="-fprofile-instr-generate -fcoverage-mapping"
CFLAGS="${CFLAGS:-}"
CXXFLAGS="${CXXFLAGS:-}"
LDFLAGS="${LDFLAGS:-}"

#!/bin/bash

# Check if bootstrap.sh exists and is executable
if [ -f ./bootstrap.sh ]; then
 chmod +x ./bootstrap.sh
 ./bootstrap.sh
fi

# Set compiler flags
export CFLAGS="$COV_CFLAGS $CFLAGS 
export CXXFLAGS="$CXXFLAGS 

# Run configure script
if [ -f ./configure ]; then
export CFLAGS="${CFLAGS//-fno-use-cxa-atexit/}"

 CC=clang CXX=clang++ CFLAGS="$COV_CFLAGS $CFLAGS" CXXFLAGS="$COV_CFLAGS $CXXFLAGS" LDFLAGS="$COV_LDFLAGS $LDFLAGS" ./configure --enable-macho --enable-debug --enable-dex --enable-dotnet --without-crypto
fi

# Clean and build the project
make clean -j$(nproc)
make -j$(nproc)

