meterSets\navcc_data.write(struct.pack(">H", len(pps_data)))\navcc_data.write(pps_data)\n\n# Build avc1 sample entry\navc1_data = io.BytesIO()\navc1_data.write(bytes([0] * 6))  # reserved\navc1_data.write(struct.pack(">H", 1))  # data_reference_index\navc1_data.write(bytes([0] * 16))  # pre_defined + reserved\navc1_data.write(struct.pack(">HH", 320, 240))  # width, height\navc1_data.write(struct.pack(">I", 0x00480000))  # horizresolution\navc1_data.write(struct.pack(">I", 0x00480000))  # vertresolution\navc1_data.write(struct.pack(">I", 0))  # reserved\navc1_data.write(struct.pack(">H", 1))  # frame_count\navc1_data.write(bytes([0] * 32))  # compressorname\navc1_data.write(struct.pack(">H", 0x0018))  # depth\navc1_data.write(struct.pack(">h", -1))  # pre_defined\n# Add avcC box\navc1_data.write(write_box("avcC", avcc_data.getvalue()))\n\n# Build stsd (Sample Description Box)\nstsd_data = io.BytesIO()\nstsd_data.write(struct.pack(">I", 1))  # entry_count\nstsd_data.write(write_box("avc1", avc1_data.getvalue()))\n\n# Build stts (Time to Sample Box) - 1 sample, duration 1\nstts_data = struct.pack(">II", 1, 1)  # entry_count, sample_count, sample_delta\n\n# Build stsc (Sample to Chunk Box) - 1 chunk, 1 sample\nstsc_data = struct.pack(">IIII", 1, 1, 1, 1)  # entry_count, first_chunk, samples_per_chunk, sample_description_index\n\n# Build stsz (Sample Size Box) - 1 sample of size 100\nstsz_data = struct.pack(">III", 0, 1, 100)  # sample_size, sample_count, entry_size\n\n# Build stco (Chunk Offset Box) - 1 chunk at offset 1000\nstco_data = struct.pack(">II", 1, 1000)  # entry_count, chunk_offset\n\n# Build stbl (Sample Table Box)\nstbl_boxes = (\n    write_full_box("stsd", 0, 0, stsd_data.getvalue()) +\n    write_full_box("stts", 0, 0, stts_data) +\n    write_full_box("stsc", 0, 0, stsc_data) +\n    write_full_box("stsz", 0, 0, stsz_data) +\n    write_full_box("stco", 0, 0, stco_data)\n)\n\n# Build minf (Media Information Box)\nvmhd_data = struct.pack(">HH", 0, 0)  # graphicsmode, opcolor\ndinf_dref_data = struct.pack(">I", 1) + write_full_box("url ", 0, 1, b"")  # self-reference\nminf_boxes = (\n    write_full_box("vmhd", 0, 1, vmhd_data) +\n    write_box("dinf", write_full_box("dref", 0, 0, dinf_dref_data)) +\n    write_box("stbl", stbl_boxes)\n)\n\n# Build mdhd (Media Header Box)\nmdhd_data = struct.pack(">IIIIHH",\n    0, 0,  # creation_time, modification_time\n    1000,  # timescale\n    1000,  # duration\n    0x55C4,  # language (und)\n    0  # pre_defined\n)\n\n# Build hdlr (Handler Reference Box)\nhdlr_data = struct.pack(">I4s4sIII",\n    0,  # pre_defined\n    b"\\x00\\x00\\x00\\x00",  # reserved\n    b"vide",  # handler_type\n    0, 0, 0  # reserved\n) + b"VideoHandler\\x00"\n\n# Build mdia (Media Box)\nmdia_boxes = (\n    write_full_box("mdhd", 0, 0, mdhd_data) +\n    write_full_box("hdlr", 0, 0, hdlr_data) +\n    write_box("minf", minf_boxes)\n)\n\n# Build tkhd (Track Header Box)\ntkhd_data = struct.pack(">IIIIIIHHHHHHHIIIIII",\n    0, 0,  # creation_time, modification_time\n    1,  # track_ID\n    0,  # reserved\n    1000,  # duration\n    0, 0,  # reserved\n    0, 0,  # layer, alternate_group\n    0, 0,  # volume, reserved\n    0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000,  # matrix\n    320 << 16, 240 << 16  # width, height\n)\n\n# Build trak (Track Box)\ntrak_boxes = (\n    write_full_box("tkhd", 0, 3, tkhd_data) +  # flags=3: track enabled\n    write_box("mdia", mdia_boxes)\n)\n\n# Build mvhd (Movie Header Box)\nmvhd_data = struct.pack(">IIIIIHHIIIIIIIIIIII",\n    0, 0,  # creation_time, modification_time\n    1000,  # timescale\n    1000,  # duration\n    0x00010000,  # rate\n    0x0100,  # volume\n    0, 0, 0,  # reserved\n    0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000,  # matrix\n    0, 0, 0, 0, 0, 0,  # pre_defined\n    2  # next_track_ID\n)\n\n# Build moov (Movie Box)\nmoov_boxes = (\n    write_full_box("mvhd", 0, 0, mvhd_data) +\n    write_box("trak", trak_boxes)\n)\n\n# Build ftyp (File Type Box)\nftyp_data = b"isom" + struct.pack(">I", 1) + b"isom"\n\n# Write the complete MP4 file\nwith open(output_path, "wb") as f:\n    f.write(write_box("ftyp", ftyp_data))\n    f.write(write_box("moov", moov_boxes))\n    # Add minimal mdat with dummy data\n    mdat_data = b"\\x00" * 100  # Dummy frame data\n    f.write(write_box("mdat", mdat_data))\n\nprint(f"Generated MP4 with H.264 track at {output_path}")\n'}
